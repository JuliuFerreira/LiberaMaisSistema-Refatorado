@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Painel de Controle";

    // Identifica se deve marcar o ID atual ou 0 (representando "Todos os Usuários")
    var usuarioLogado = ViewBag.UsuarioAtual ?? 0;

    string[] nomesMeses = { "Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
    int mesAtual = ViewBag.Mes ?? DateTime.Today.Month;
    int anoAtual = ViewBag.Ano ?? DateTime.Today.Year;
    string nomeMesCompetencia = nomesMeses[mesAtual - 1];


}

<div class="container-fluid py-4 inner-system-page">

    @* Topo da Página com Título e Filtro de Usuário *@
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 tracking-tight" style="font-size: 1.5rem;">Painel de Controle</h2>
            <small class="text-muted">Acompanhe o desempenho das operações e vendas deste mês</small>
        </div>

        @* NOVO: Menu Dropdown para Selecionar o Usuário *@
        @if (ViewBag.IsAdmin == true)
        {
            <div class="col-12 col-md-4 col-lg-3">
                <form id="formFiltroDashboard" method="get" asp-action="Index">
                    <div class="d-flex flex-wrap align-items-center gap-2">

                        <select name="mes" class="form-select form-select-sm shadow-sm border" style="width: auto;" onchange="this.form.submit()">
                            <option value="1" selected="@(ViewBag.Mes == 1)">Janeiro</option>
                            <option value="2" selected="@(ViewBag.Mes == 2)">Fevereiro</option>
                            <option value="3" selected="@(ViewBag.Mes == 3)">Março</option>
                            <option value="4" selected="@(ViewBag.Mes == 4)">Abril</option>
                            <option value="5" selected="@(ViewBag.Mes == 5)">Maio</option>
                            <option value="6" selected="@(ViewBag.Mes == 6)">Junho</option>
                            <option value="7" selected="@(ViewBag.Mes == 7)">Julho</option>
                            <option value="8" selected="@(ViewBag.Mes == 8)">Agosto</option>
                            <option value="9" selected="@(ViewBag.Mes == 9)">Setembro</option>
                            <option value="10" selected="@(ViewBag.Mes == 10)">Outubro</option>
                            <option value="11" selected="@(ViewBag.Mes == 11)">Novembro</option>
                            <option value="12" selected="@(ViewBag.Mes == 12)">Dezembro</option>
                        </select>

                        <select name="ano" class="form-select form-select-sm shadow-sm border" style="width: auto;" onchange="this.form.submit()">
                            @for (int a = DateTime.Now.Year - 2; a <= DateTime.Now.Year + 1; a++)
                            {
                                <option value="@a" selected="@(ViewBag.Ano == a)">@a</option>
                            }
                        </select>

                        @if (ViewBag.IsAdmin == true)
                        {
                            <select name="usuarioId" class="form-select form-select-sm shadow-sm border" style="width: auto;" onchange="this.form.submit()">
                                <option value="0" selected="@(ViewBag.UsuarioAtual == 0)">Todos os Usuários</option>
                                @if (ViewBag.UsuariosList != null)
                                {
                                    foreach (var usu in ViewBag.UsuariosList)
                                    {
                                        <option value="@usu.Id" selected="@(ViewBag.UsuarioAtual == usu.Id)">@usu.Nome</option>
                                    }
                                }
                            </select>
                        }
                    </div>
                </form>
            </div>
        }

    </div>

    @* Atalhos Rápidos de Cadastro/Venda *@
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-controller="Clientes" asp-action="Criar" class="btn btn-dark btn-sm px-3 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold">
            <i class="bi bi-person-plus-fill fs-6"></i> Cadastrar um Cliente
        </a>
        <a asp-controller="Venda" asp-action="Criar" class="btn btn-outline-dark btn-sm px-3 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold bg-white">
            <i class="bi bi-cart-plus-fill fs-6 text-success"></i> Iniciar uma Venda
        </a>

    </div>

    @* LINHA 1 DE CARDs: Indicadores Operacionais *@
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-primary border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium d-block mb-1">Digitados (Este Mês)</span>
                        <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalDigitados</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-3">
                        <i class="bi bi-file-earmark-text fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-info border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium d-block mb-1">Em Andamento (Este Mês)</span>
                        <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalAndamento</h3>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-3">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-success border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium d-block mb-1">Concluídos (Este Mês)</span>
                        <h3 class="fw-bold text-dark mb-0">@ViewBag.TotalConcluidos</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-3">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* LINHA 2 DE CARDs: Indicadores Financeiros *@
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-warning border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium d-block mb-1">Valor de Contratos Pagos (Este Mês)</span>
                        <h3 class="fw-bold text-dark mb-0">R$ @ViewBag.ValorVendido.ToString("N2")</h3>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-3">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-success border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium d-block mb-1">Comissões Recebidas (Este Mês)</span>
                        <h3 class="fw-bold text-success mb-0">R$ @ViewBag.ComissaoRecebida.ToString("N2")</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-3">
                        <i class="bi bi-cash-coin fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 @(Model.PossuiComissaoAtrasada ? "border-danger" : "border-secondary")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-medium d-block mb-1">Aviso de Comissões</span>

                        @if (Model.PossuiComissaoAtrasada)
                        {
                            <a asp-controller="Venda" asp-action="PorStatus" asp-route-status="Pago" class="text-decoration-none">
                                <h3 class="fw-bold text-danger mb-0" style="font-size: 1.2rem;">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    @Model.ContratosComissaoAtrasada Comissão em Atraso Verificar!
                                </h3>
                            </a>
                        }
                        else
                        {
                            <h3 class="fw-bold text-success mb-0" style="font-size: 1.2rem;">
                                <i class="bi bi-check-circle-fill me-1"></i> Tudo em Dia
                            </h3>
                        }
                    </div>
                    <div class="@(Model.PossuiComissaoAtrasada ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success") p-3 rounded-3">
                        <i class="bi @(Model.PossuiComissaoAtrasada ? "bi-exclamation-octagon" : "bi-shield-check") fs-4"></i>
                    </div>

                </div>
            </div>
            </a>
        </div>
    </div>

    @* Bloco 3: Gráficos *@
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-dark mb-3" style="font-size: 1rem;">Bancos Mais Digitados</h5>
                <div style="position: relative; height:250px;">
                    <canvas id="chartBancos"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-dark mb-3" style="font-size: 1rem;">Ranking de Promotoras</h5>
                <div style="position: relative; height:250px;">
                    <canvas id="chartPromotoras"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // 1. Gráfico de Bancos
        const ctxBancos = document.getElementById('chartBancos').getContext('2d');
        new Chart(ctxBancos, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.GraficoBancosLabels)),
                datasets: [{
                    label: 'Contratos',
                    data: @Html.Raw(Json.Serialize(ViewBag.GraficoBancosValores)),
                    backgroundColor: '#0d6efd',
                    borderWidth: 0,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // 2. Gráfico de Promotoras
        const ctxPromotoras = document.getElementById('chartPromotoras').getContext('2d');
        new Chart(ctxPromotoras, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.GraficoPromotorasLabels)),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.GraficoPromotorasValores)),
                    backgroundColor: ['#198754', '#ffc107', '#6c757d', '#0dcaf0', '#d63384'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }
</style>

