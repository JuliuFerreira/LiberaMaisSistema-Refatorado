        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%; /* Formato circular para um visual mais limpo */
        font-size: 1.25rem;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .card-modern-button:hover .icon-box-modern {
        transform: scale(1.08);
    }

    /* AJUSTE TEXTUAL */
    .card-title-text {
        font-size: 0.95rem;
        letter-spacing: -0.1px;
    }

    .card-desc-text {
        font-size: 0.78rem;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* CORES SUB-TOM BOOTSTRAP */
    .bg-primary-subtle {
        background-color: #e3f2fd;
    }

    .bg-success-subtle {
        background-color: #e8f5e9;
    }

    .bg-warning-subtle {
        background-color: #fffde7;
    }

    .bg-info-subtle {
        background-color: #e0f7fa;
    }

    .bg-secondary-subtle {
        background-color: #f5f5f5;
    }

    .bg-dark-subtle {
        background-color: #eceff1;
    }

    /* STATUS BLINK ANIMATION */
    .blink-animation {
        animation: pulse-green 1.8s infinite;
        font-size: 0.65rem;
        vertical-align: middle;
    }

    @@keyframes pulse-green {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }

        100% {
            opacity: 1;
        }
    }
