@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Painel Principal";
}

<div class="container-fluid mt-4">

    <!-- TOPO DO PAINEL -->
    <div class="row mb-4 pt-2 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-secondary mb-1" style="letter-spacing: -0.5px;">
                Bem-vindo ao sistema LiberaMais
            </h2>
            <p class="text-muted mb-0 small">
                Gerencie seus clientes, vendas e operações em um só lugar
            </p>
        </div>
        <div class="col-md-4 text-md-end mt-2 mt-md-0">
            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2 shadow-sm fw-semibold">
                <i class="bi bi-circle-fill me-1 text-success blink-animation"></i>
                Sistema Online
            </span>
        </div>
    </div>

    <!-- GRID DE CARDS COM ALTURA AJUSTADA -->
    <div class="row g-3">

        <!-- CLIENTES -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Clientes" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-primary-subtle text-primary mb-2">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Clientes</h6>
                        <small class="text-muted card-desc-text">Gerenciar cadastros</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- VENDAS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Venda" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-success-subtle text-success mb-2">
                            <i class="bi bi-currency-dollar"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Vendas</h6>
                        <small class="text-muted card-desc-text">Controle de contratos</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- PROMOTORAS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Promotora" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-warning-subtle text-warning mb-2">
                            <i class="bi bi-building"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Promotoras</h6>
                        <small class="text-muted card-desc-text">Acessos e parceiros</small>
                    </div>
                </div>
            </a>
        </div>

        @if (ViewBag.IsAdmin == true)
        {
            <!-- FINANCEIRO -->
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                <a asp-controller="Financa" asp-action="Index" class="text-decoration-none">
                    <div class="card border-0 shadow-sm card-modern-button">
                        <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                            <div class="icon-box-modern bg-info-subtle text-info mb-2">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1 card-title-text">Financeiro</h6>
                            <small class="text-muted card-desc-text">Fluxo de caixa</small>
                        </div>
                    </div>
                </a>
            </div>
        }

        @if (ViewBag.IsAdmin == true)
        {
            <!-- COMISSÕES -->
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                <a asp-controller="Comissao" asp-action="Relatorio" class="text-decoration-none">
                    <div class="card border-0 shadow-sm card-modern-button">
                        <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                            <div class="icon-box-modern bg-success-subtle text-success mb-2">
                                <i class="bi bi-coin"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1 card-title-text">Comissões</h6>
                            <small class="text-muted card-desc-text">Relatório de repasses</small>
                        </div>
                    </div>
                </a>
            </div>
        }

        <!-- LINKS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Util" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-secondary-subtle text-secondary mb-2">
                            <i class="bi bi-link-45deg"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Links Úteis</h6>
                        <small class="text-muted card-desc-text">Ferramentas externas</small>
                    </div>
                </div>
            </a>
        </div>

        @if (ViewBag.IsAdmin == true)
        {
            <!-- CONFIGURAÇÕES -->
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                <a asp-controller="Setup" asp-action="Index" class="text-decoration-none">
                    <div class="card border-0 shadow-sm card-modern-button">
                        <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                            <div class="icon-box-modern bg-dark-subtle text-dark mb-2">
                                <i class="bi bi-gear-fill"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1 card-title-text">Configurações</h6>
                            <small class="text-muted card-desc-text">Parâmetros gerais</small>
                        </div>
                    </div>
                </a>
            </div>
        }

    </div>
</div>

<style>
    /* ESTILIZAÇÃO E ALTURA DO CARD CONFIGURADA */
    .card-modern-button {
        height: 130px; /* Altura intermediária perfeita */
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        border-radius: 14px !important;
        background-color: #ffffff;
    }

        .card-modern-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.07) !important;
        }

    /* CONTAINER DO ÍCONE CENTRALIZADO */
    .icon-box-modern {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%; /* Formato circular para um visual mais limpo */
        font-size: 1.25rem;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .card-modern-button:hover .icon-box-modern {
        transform: scale(1.08);
    }

    /* AJUSTE TEXTUAL */
    .card-title-text {
        font-size: 0.95rem;
        letter-spacing: -0.1px;
    }

    .card-desc-text {
        font-size: 0.78rem;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* CORES SUB-TOM BOOTSTRAP */
    .bg-primary-subtle {
        background-color: #e3f2fd;
    }

    .bg-success-subtle {
        background-color: #e8f5e9;
    }

    .bg-warning-subtle {
        background-color: #fffde7;
    }

    .bg-info-subtle {
        background-color: #e0f7fa;
    }

    .bg-secondary-subtle {
        background-color: #f5f5f5;
    }

    .bg-dark-subtle {
        background-color: #eceff1;
    }

    /* STATUS BLINK ANIMATION */
    .blink-animation {
        animation: pulse-green 1.8s infinite;
        font-size: 0.65rem;
        vertical-align: middle;
    }

    @@keyframes pulse-green {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }

        100% {
            opacity: 1;
        }
    }
</style>