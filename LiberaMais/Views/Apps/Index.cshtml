@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Painel Principal";
}

<div class="container-fluid mt-4">

    <div class="row mb-4 mt-4 align-items-center">

        <div class="col-md-8">

            <h2 class="fw-bold text-secondary mb-0">
                Bem-vindo ao sistema LiberaMais
            </h2>

            <small class="text-muted">
                Gerencie seus clientes, vendas e operações
            </small>

        </div>

        <div class="col-md-4 text-end">

            <span class="badge rounded-pill bg-success px-3 py-2 shadow-sm">

                <i class="bi bi-circle-fill me-1"></i>

                Sistema Online

            </span>

        </div>

    </div>

    <div class="row g-4">

        <!-- CLIENTES -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Clientes"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">

                            <i class="bi bi-people-fill fs-1 text-primary"></i>

                        </div>

                        <h4 class="fw-bold text-dark">

                            Clientes

                        </h4>

                        <p class="text-muted mb-0">

                            Cadastro e gerenciamento de clientes

                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- VENDAS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Venda"
               asp-action="Venda"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">

                            <i class="bi bi-currency-dollar fs-1 text-success"></i>

                        </div>

                        <h4 class="fw-bold text-dark">

                            Vendas

                        </h4>

                        <p class="text-muted mb-0">

                            Controle completo das vendas

                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- PROMOTORAS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Promotora"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">

                            <i class="bi bi-building fs-1 text-warning"></i>

                        </div>

                        <h4 class="fw-bold text-dark">

                            Promotoras

                        </h4>

                        <p class="text-muted mb-0">

                            Gerencie promotoras e acessos

                        </p>

                    </div>

                </div>

            </a>

        </div>

        @if (ViewBag.IsAdmin)
        {
            <!-- FINANCEIRO -->
            <div class="col-lg-3 col-md-6">

                <a asp-controller="Financa"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm h-100 card-hover">

                        <div class="card-body text-center">

                            <div class="mb-3">

                                <i class="bi bi-wallet2 fs-1 text-info"></i>

                            </div>

                            <h4 class="fw-bold text-dark">

                                Financeiro

                            </h4>

                            <p class="text-muted mb-0">

                                Receitas, despesas e controle financeiro

                            </p>

                        </div>

                    </div>

                </a>

            </div>
        }

        <!-- LINKS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Util"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">

                            <i class="bi bi-link-45deg fs-1 text-secondary"></i>

                        </div>

                        <h4 class="fw-bold text-dark">

                            Links Úteis

                        </h4>

                        <p class="text-muted mb-0">

                            Acesso rápido a sistemas e ferramentas

                        </p>

                    </div>

                </div>

            </a>

        </div>

        @* <div class="col-lg-3 col-md-6">

            <a asp-controller="ClienteBeneficio"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">

                            <i class="bi bi-link-45deg fs-1 text-danger"></i>

                        </div>

                        <h4 class="fw-bold text-dark">

                            Beneficio por cliente

                        </h4>

                        <p class="text-muted mb-0">

                            Cadastro de beneficios à clientes.

                        </p>

                    </div>

                </div>

            </a>

        </div> *@

        @if (ViewBag.IsAdmin)
        {
            <!-- CONFIGURAÇÕES -->
            <div class="col-lg-3 col-md-6">

                <a asp-controller="Setup"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card border-0 shadow-sm h-100 card-hover">

                        <div class="card-body text-center">

                            <div class="mb-3">

                                <i class="bi bi-gear-fill fs-1 text-dark"></i>

                            </div>

                            <h4 class="fw-bold text-dark">

                                Configurações

                            </h4>

                            <p class="text-muted mb-0">

                                Cadastros e parâmetros do sistema

                            </p>

                        </div>

                    </div>

                </a>

            </div>
        }

    </div>

</div>

<style>

    .card-hover {
        transition: all .25s ease;
        cursor: pointer;
    }

        .card-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 24px rgba(0,0,0,.12) !important;
        }

    .card {
        background-color: #ffffff;
        min-height: 190px;
        border-radius: 16px !important;
    }

    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .card-body i {
            transition: .25s ease;
        }

    .card-hover:hover i {
        transform: scale(1.08);
    }

    .card h4 {
        font-size: 1.5rem;
        margin-bottom: 10px;
    }

    .card p {
        font-size: .95rem;
    }

</style>