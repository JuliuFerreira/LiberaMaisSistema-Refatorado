@model IEnumerable<Promotora>

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Promotoras e Acesso a Bancos";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<style>
    /* Elevação ultra suave e transição fluida */
    .promotora-card {
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

        .promotora-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06) !important;
        }

    /* Remove os divisores brutos da lista interna para suavizar */
    .list-group-flush > .list-group-item {
        border-bottom: 1px dashed rgba(0, 0, 0, 0.05) !important;
    }

        .list-group-flush > .list-group-item:last-child {
            border-bottom: none !important;
        }
</style>

<div class="container-fluid px-0 mt-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-light-subtle">
        <div>
            <h3 class="fw-bold text-dark tracking-tight mb-1">Promotoras e Acesso a Bancos</h3>
            <p class="text-muted small mb-0">Gerencie os acessos, credenciais e links das promotoras.</p>
        </div>

        @if (isAdmin)
        {
            <a asp-action="Criar" class="btn btn-success rounded-3 px-4 d-flex align-items-center gap-2 shadow-sm align-self-start align-self-md-center fw-medium">
                <i class="bi bi-plus-lg"></i> Nova Promotora
            </a>
        }
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 py-3">
            <i class="bi bi-check-circle-fill me-2 text-success"></i> @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 py-3">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var pro in Model)
            {
                <div class="col-sm-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 h-100 promotora-card bg-white">

                        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-1">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="text-truncate me-2">
                                    <h5 class="fw-bold text-dark mb-0 text-truncate" title="@pro.Nome">@pro.Nome</h5>
                                    <small class="text-primary fw-semibold" style="font-size: 0.8rem;">@pro.Usuario?.Nome</small>
                                </div>
                                <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1 fw-semibold" style="font-size: 0.75rem;">Promotora</span>
                            </div>
                        </div>

                        <div class="card-body px-4 pt-2 pb-3">
                            <ul class="list-group list-group-flush small">
                                <li class="list-group-item px-0 py-2.5 d-flex justify-content-between align-items-center bg-transparent">
                                    <span class="text-muted"><i class="bi bi-person me-1"></i> Login:</span>
                                    <span class="text-dark text-break fw-medium">@pro.Login</span>
                                </li>
                                <li class="list-group-item px-0 py-2.5 d-flex justify-content-between align-items-center bg-transparent">
                                    <span class="text-muted"><i class="bi bi-shield-lock me-1"></i> Senha:</span>
                                    <span class="text-secondary bg-light px-2 py-0.5 rounded font-monospace border-0" style="font-size: 0.85rem;">@pro.Senha</span>
                                </li>
                                <li class="list-group-item px-0 py-2.5 d-flex justify-content-between align-items-center bg-transparent">
                                    <span class="text-muted"><i class="bi bi-link-45deg me-1"></i> URL:</span>
                                    <a href="https://@pro.Url" target="_blank" class="text-decoration-none text-truncate ms-2 fw-medium d-inline-flex align-items-center gap-1" style="max-width: 150px;" title="Acessar link">
                                        @pro.Url <i class="bi bi-arrow-up-right style=" font-size: 0.7rem;""></i>
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 mt-auto">
                            <div class="d-flex flex-column gap-2">
                                <a asp-controller="PromotoraBanco"
                                   asp-action="Index"
                                   asp-route-promotoraId="@pro.Id"
                                   class="btn btn-light btn-sm rounded-3 fw-semibold py-2 d-flex align-items-center justify-content-center gap-2 border text-secondary hover-primary">
                                    <i class="bi bi-key"></i> Logins Vinculados
                                </a>

                                @if (isAdmin)
                                {
                                    <div class="d-flex gap-2">
                                        <a asp-action="Editar"
                                           asp-route-id="@pro.Id"
                                           class="btn btn-sm btn-outline-light text-warning border-warning-subtle w-100 rounded-3 d-flex align-items-center justify-content-center fw-medium py-1.5">
                                            <i class="bi bi-pencil me-1"></i> Editar
                                        </a>

                                        <button class="btn btn-sm btn-outline-light text-danger border-danger-subtle w-100 rounded-3 d-flex align-items-center justify-content-center fw-medium py-1.5"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalExcluir_@pro.Id">
                                            <i class="bi bi-trash3 me-1"></i> Excluir
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>

                @if (isAdmin)
                {
                    <div class="modal fade" id="modalExcluir_@pro.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-sm">
                            <div class="modal-content rounded-4 border-0 shadow-lg">
                                <div class="modal-body text-center p-4 pt-5">
                                    <div class="text-danger mb-3">
                                        <i class="bi bi-exclamation-circle" style="font-size: 2.5rem;"></i>
                                    </div>
                                    <h5 class="fw-bold text-dark mb-2">Excluir Promotora?</h5>
                                    <p class="text-muted small mb-0">
                                        Deseja realmente remover <strong class="text-dark">@pro.Nome</strong>?
                                    </p>
                                    <p class="text-muted mb-0" style="font-size: 0.75rem;">Os logins associados também serão afetados.</p>
                                </div>
                                <div class="modal-footer border-0 d-flex flex-column w-100 gap-1 p-4 pt-0">
                                    <form asp-action="Apagar" method="post" class="w-100 m-0">
                                        <input type="hidden" name="id" value="@pro.Id" />
                                        <button type="submit" class="btn btn-danger w-100 rounded-3 py-2 fw-medium">Confirmar Exclusão</button>
                                    </form>
                                    <button type="button" class="btn btn-light border w-100 rounded-3 py-2 text-secondary fw-medium" data-bs-dismiss="modal">Cancelar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-folder2-open display-6 d-block mb-3 opacity-50"></i>
                <p class="mb-0 small">Nenhuma promotora cadastrada no sistema.</p>
            </div>
        }
    </div>

    <!-- RODAPÉ DE AÇÕES -->
    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-medium p-0 btn-back-hover"
           asp-controller="Apps" asp-action="Index">
            <i class="bi bi-arrow-left-short" style="font-size: 1.4rem;"></i> Voltar ao painel
        </a>
    </div>
</div>

<script>
    setTimeout(function () {
        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");
    }, 3000);
</script>

<style>
    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }

    /* ANIMAÇÃO PISCAR ALERTA */
    .animacao-piscar {
        animation: pulse-danger 2s infinite;
    }

</style>