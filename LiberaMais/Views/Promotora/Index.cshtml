@model IEnumerable<Promotora>

@{
    Layout = "LayoutSistema";

    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}



<div class="container-fluid">


    <div class="justify-content-center align-items-center mb-4 mt-4 mt-5">

        <div class="card-header text-white rounded-top-4"
             style="background-color:dodgerblue;">

            <h3 class="text-center mb-0">
                Promotoras e acesso a bancos
            </h3>

        </div>

    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger">
            @TempData["MensagemErro"]
        </div>
    }

    <a asp-action="Criar"
       class="btn btn-success rounded-4 shadow-sm px-4 mb-3 ">

        <i class="bi bi-plus-circle-fill"></i>
        Nova Promotora

    </a>

    <div class="row g-3">

        @foreach (var pro in Model)
        {
            <div class="col-md-4 col-lg-3">

                <div class="card border-0 shadow-sm rounded-4 h-100 promotora-card">

                    <div class="card-body p-3">

                        <div class="d-flex justify-content-between align-items-start mb-3">

                            <div>

                                <h5 class="fw-bold mb-1">
                                    @pro.Nome
                                </h5>

                                <small class="text-muted">
                                    Sistema da promotora
                                </small>

                            </div>

                            <div> 

                                <h5 class="fw-bold mb-1 text-center">
                                    @pro.Usuario.Nome
                                </h5>

                                <small class="text-muted">
                                    Usuário cadastrado
                                </small>


                            </div>
                                                        
                                                       

                        </div>

                        <div class="info-box mb-2">

                            <span class="info-title">
                                Login
                            </span>

                            <div class="info-text">
                                @pro.Login
                            </div>

                        </div>

                        <div class="info-box mb-2">

                            <span class="info-title">
                                Senha
                            </span>

                            <div class="info-text">
                                @pro.Senha
                            </div>

                        </div>

                        <div class="info-box mb-3">

                            <span class="info-title">
                                URL
                            </span>

                            <div class="info-text text-truncate">

                                <a href="https://@pro.Url"
                                   target="_blank"
                                   class="text-decoration-none">

                                    @pro.Url

                                </a>

                            </div>

                        </div>

                        <div class="d-grid gap-2">

                            <a asp-controller="PromotoraBanco"
                               asp-action="Index"
                               asp-route-promotoraId="@pro.Id"
                               class="btn btn-primary rounded-3 btn-sm fw-semibold">

                                <i class="bi bi-key-fill"></i>
                                Logins

                            </a>

                            <div class="d-flex gap-2">

                                <a asp-action="Editar"
                                   asp-route-id="@pro.Id"
                                   class="btn btn-outline-warning btn-sm w-100 rounded-3">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <button class="btn btn-outline-danger btn-sm w-100 rounded-3"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalExcluir_@pro.Id">

                                    <i class="bi bi-trash"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- MODAL -->
            <div class="modal fade"
                 id="modalExcluir_@pro.Id"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">

                    <div class="modal-content rounded-4 border-0 shadow">

                        <div class="modal-header bg-danger text-white">

                            <h5 class="modal-title">
                                Excluir Promotora
                            </h5>

                            <button type="button"
                                    class="btn-close btn-close-white"
                                    data-bs-dismiss="modal">
                            </button>

                        </div>

                        <div class="modal-body text-center p-4">

                            <p class="fs-5 mb-0">

                                Deseja excluir a promotora

                                <strong class="text-primary">
                                    @pro.Nome
                                </strong>?

                            </p>

                        </div>

                        <div class="modal-footer border-0">

                            <button type="button"
                                    class="btn btn-secondary rounded-3"
                                    data-bs-dismiss="modal">

                                Cancelar

                            </button>

                            <form asp-action="Apagar" method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@pro.Id" />

                                <button type="submit"
                                        class="btn btn-danger rounded-3">

                                    Excluir

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    <div class="mt-4">

        <a class="btn btn-outline-secondary rounded-4 px-4"
           asp-controller="Apps"
           asp-action="Index">

            <i class="bi bi-arrow-return-left"></i>
            Voltar

        </a>

    </div>

</div>



<script>

    setTimeout(function () {

        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");

    }, 3000);

</script>