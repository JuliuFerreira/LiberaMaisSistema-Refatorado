@model Promotora

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Nova Promotora";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light-subtle">
        <div>
            <h3 class="fw-bold text-dark mb-1 tracking-tight">Cadastro de Promotora</h3>
            <p class="text-muted small mb-0">Preencha os dados abaixo para registrar uma nova promotora parceira.</p>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <form id="promotoraForm" asp-controller="Promotora" asp-action="Criar" method="post">

            <div class="row g-3">
                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label text-muted fw-bold small text-uppercase">Usuário Vinculado</label>
                    <select asp-for="UsuarioId" class="form-select border-light-subtle rounded-3 small py-2">
                        <option value="">Selecione...</option>
                        @foreach (var user in ViewBag.Usuarios)
                        {
                            <option value="@user.Id">@user.Nome</option>
                        }
                    </select>
                    <span asp-validation-for="UsuarioId" class="text-danger small mt-1 d-block" style="font-size: 0.75rem;"></span>
                </div>

                <div class="col-12 col-md-4 col-lg-3">
                    <label asp-for="Nome" class="form-label text-muted fw-bold small text-uppercase">Nome da Promotora</label>
                    <input asp-for="Nome" class="form-control border-light-subtle rounded-3 small py-2" maxlength="100" placeholder="Ex: Promotora Master" />
                    <span asp-validation-for="Nome" class="text-danger small mt-1 d-block" style="font-size: 0.75rem;"></span>
                </div>

                <div class="col-12 col-md-4 col-lg-2">
                    <label asp-for="Login" class="form-label text-muted fw-bold small text-uppercase">Login</label>
                    <input asp-for="Login" class="form-control border-light-subtle rounded-3 small py-2 font-monospace" maxlength="100" placeholder="Usuário ou e-mail" />
                    <span asp-validation-for="Login" class="text-danger small mt-1 d-block" style="font-size: 0.75rem;"></span>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="Senha" class="form-label text-muted fw-bold small text-uppercase">Senha</label>
                    <input asp-for="Senha" class="form-control border-light-subtle rounded-3 small py-2 font-monospace" maxlength="100" placeholder="Senha de acesso" />
                    <span asp-validation-for="Senha" class="text-danger small mt-1 d-block" style="font-size: 0.75rem;"></span>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label asp-for="Url" class="form-label text-muted fw-bold small text-uppercase">URL / Link</label>
                    <input asp-for="Url" class="form-control border-light-subtle rounded-3 small py-2" maxlength="255" placeholder="site.com.br" />
                    <span asp-validation-for="Url" class="text-danger small mt-1 d-block" style="font-size: 0.75rem;"></span>
                </div>
            </div>

            <hr class="my-4 border-light-subtle" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary border-0 px-4 py-2 rounded-3 text-white small fw-medium" style="background-color: #6c757d;">
                    Voltar
                </a>
                <button type="submit" class="btn btn-dark border-0 px-4 py-2 rounded-3 small fw-semibold">
                    Salvar Cadastro
                </button>
            </div>

        </form>
    </div>
</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    /* Customizações extras para inputs focados no padrão limpo */
    .form-control:focus, .form-select:focus {
        border-color: #dee2e6 !important;
        box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.05) !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // FadeOut automático das mensagens após 3 segundos
            setTimeout(function() {
                $(".alert").fadeOut("slow");
            }, 3000);
        });
    </script>
}   