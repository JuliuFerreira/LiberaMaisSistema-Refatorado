@model Promotora

@{
    Layout = "LayoutSistema";
}

<div class="container mt-6">

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["MensagemErro"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensagemSucesso"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="card shadow border-0 rounded-4 col-10">

        <div class="card-header text-white rounded-top-4"
             style="background-color:green;">

            <h3 class="text-center mb-0">
                Cadastro de Promotora
            </h3>

        </div>

        <div class="card-body p-4">

            <form id="promotoraForm"
                  asp-controller="Promotora"
                  asp-action="Criar"
                  method="post">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label asp-for="Nome"
                               class="form-label fw-bold">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               maxlength="100"
                               placeholder="Nome da promotora" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Login"
                               class="form-label fw-bold">
                            Login
                        </label>

                        <input asp-for="Login"
                               class="form-control"
                               maxlength="100"
                               placeholder="Login da promotora" />

                        <span asp-validation-for="Login"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Senha"
                               class="form-label fw-bold">
                            Senha
                        </label>

                        <input asp-for="Senha"
                               class="form-control"
                               maxlength="100"
                               placeholder="Senha da promotora" />

                        <span asp-validation-for="Senha"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="Url"
                               class="form-label fw-bold">
                            URL
                        </label>

                        <input asp-for="Url"
                               class="form-control"
                               maxlength="255"
                               placeholder="https://site.com.br" />

                        <span asp-validation-for="Url"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Voltar

                    </a>

                    <button type="submit"
                            class="btn btn-success">

                        Salvar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>