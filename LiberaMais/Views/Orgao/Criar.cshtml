@model LiberaMais.Models.Orgao

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Cadastrar Órgão";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light-subtle">
        <div>
            <h3 class="fw-bold text-dark mb-1 tracking-tight">Novo Órgão</h3>
            <p class="text-muted small mb-0">Cadastre um novo órgão público ou instituição no sistema.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <form asp-action="Criar" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label small fw-bold text-muted">NOME DO ORGÃO</label>
                        <input asp-for="Nome" class="form-control rounded-3 py-2" placeholder="Ex: Meu INSS" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Url" class="form-label small fw-bold text-muted">ACESSO AO PORTAL</label>
                        <input asp-for="Url" class="form-control rounded-3 py-2" placeholder="site.com.br" />
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-2">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-3 small fw-medium text-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-dark px-4 py-2 rounded-3 small fw-semibold">
                        Salvar Órgão
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none text-secondary p-0 d-inline-flex align-items-center gap-2 btn-back-hover">
            <i class="bi bi-arrow-left-short fs-4"></i> <span class="fw-medium small">Voltar para a listagem</span>
        </a>
    </div>

</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    /* Estilização dos inputs para combinar com o padrão SaaS */
    .form-control {
        border: 1px solid #dee2e6;
        font-size: 0.92rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .form-control:focus {
            border-color: #212529;
            box-shadow: 0 0 0 3px rgba(33, 37, 41, 0.1);
            outline: 0;
        }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}