@using LiberaMais.Models.Enums

@model IEnumerable<Orgao>

@{
    Layout = "LayoutSistema";

    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div>

    <div class="card shadow-sm mt-5 rounded-4">       

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Orgãos Cadastrados</h4>
        </div>
        @if (TempData["mensagemSucesso"] != null)
        {
            <div id="alertaSucesso" class="alert alert-success">
                @TempData["mensagemSucesso"]
            </div>
        }

        @if (TempData["mensagemErro"] != null)
        {
            <div id="alertaErro" class="alert alert-danger">
                @TempData["mensagemErro"]
            </div>
        }

        <div class="table-responsive">

            <div class="mb-3 mt-3">
                <a asp-action="Criar"
                   class="btn btn-success mb-3">
                    Adicionar Orgão
                </a>
            </div>

            <table class="table table-striped table-bordered">

                <thead class="table-dark">

                    <tr>
                        <th>Nome</th>
                        <th class="text-center">Ações</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var org in Model)
                    {
                        <tr>

                            <td>
                                @org.Nome
                            </td>

                            <td class="text-center">

                                <a asp-action="Editar"
                                   asp-route-id="@org.Id"
                                   class="btn btn-warning btn-sm me-2">
                                    Editar
                                </a>

                                <button class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalExcluir_@org.Id">

                                    Excluir

                                </button>

                            </td>

                        </tr>

                        <!-- MODAL -->
                        <div class="modal fade"
                             id="modalExcluir_@org.Id"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content rounded-4 border-0 shadow">

                                    <div class="modal-header bg-danger text-white">

                                        <h5 class="modal-title">

                                            Excluir Orgão

                                        </h5>

                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body text-center p-4">

                                        <h5 class="text-danger mb-3">
                                            Atenção!
                                        </h5>

                                        <p class="fs-5">

                                            Deseja realmente excluir o orgão

                                            <strong class="text-primary">
                                                @org.Nome
                                            </strong>?

                                        </p>

                                    </div>

                                    <div class="modal-footer border-0">

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">

                                            Cancelar

                                        </button>

                                        <form asp-action="Apagar" method="post">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@org.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger">

                                                Excluir

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </tbody>

            </table>

        </div>
    </div>
</div>
<div class="text-left my-3">
    <a class="btn btn-outline-secondary btn-lg" style="border-radius: 10px; font-size: 16px" asp-controller="Setup" asp-action="Index">
        <i class="bi bi-arrow-return-left"></i> Voltar
    </a>
</div>



<script>
    setTimeout(function () {

        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");

    }, 3000);
</script>