@using LiberaMais.Models.Enums
@model IEnumerable<Orgao>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Órgãos Cadastrados";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Órgãos Cadastrados</h2>
            <small class="text-muted">Gerencie os órgãos públicos e instituições registradas no sistema.</small>
        </div>

        <a asp-action="Criar" class="btn btn-dark d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">
            <i class="bi bi-plus-lg"></i> <span class="fw-semibold small">Adicionar Órgão</span>
        </a>
    </div>

    @if (TempData["mensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["mensagemSucesso"]
        </div>
    }
    @if (TempData["mensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["mensagemErro"]
        </div>
    }

    <div class="card card-table shadow-sm border-0 mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Nome</th>
                            <th>Acesso ao portal</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var org in Model)
                            {
                                <tr class="linha-clicavel" onclick="navegarParaEditar(event, '@Url.Action("Editar", new { id = org.Id })')">
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark">@org.Nome</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                                            @if (!string.IsNullOrEmpty(org.Url))
                                            {
                                                <a href="@org.Url" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 py-1 px-2.5 text-dark shadow-sm rounded-2 fw-semibold" style="font-size: 0.85rem;">
                                                    <i class="bi bi-box-arrow-up-right text-primary"></i> <span>Acessar Portal</span>
                                                </a>
                                                <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                        onclick="copiarTexto(event, '@org.Url', this)" title="Copiar Link">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted opacity-50 small">Não informado</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center pe-4" onclick="event.stopPropagation();">
                                        <button class="btn btn-sm btn-outline-danger border-0" data-bs-toggle="modal" data-bs-target="#modalExcluir_@org.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@org.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title">Confirmar Exclusão</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Deseja realmente remover o registro <strong>@org.Nome</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="Apagar" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@org.Id" />
                                                    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Nenhum registro encontrado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Setup" asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Voltar a configuração
        </a>
    </div>
</div>

<script>
    window.addEventListener('load', function() {
        setTimeout(function() {
            var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
            alertas.forEach(function(alerta) {
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(function() { alerta.style.display = "none"; }, 500);
                }
            });
        }, 3000);
    });

    function navegarParaEditar(event, url) {
        // Evita navegar se o usuário estiver apenas selecionando texto
        const selecao = window.getSelection().toString();
        if (selecao.length > 0) {
            return;
        }
        // Evita navegar se clicar em modais ou botões internos
        if (event.target.closest('.modal') || event.target.closest('button') || event.target.closest('a')) {
            return;
        }
        window.location.href = url;
    }

    function copiarTexto(event, texto, elemento) {
        event.stopPropagation();
        navigator.clipboard.writeText(texto).then(function() {
            var icone = elemento.querySelector('i');
            icone.classList.remove('bi-clipboard');
            icone.classList.add('bi-check-lg');
            icone.classList.remove('text-muted');
            icone.classList.add('text-success');
            setTimeout(function() {
                icone.classList.remove('bi-check-lg');
                icone.classList.add('bi-clipboard');
                icone.classList.remove('text-success');
                icone.classList.add('text-muted');
            }, 2000);
        });
    }
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .table-custom th {
        font-size: 0.82rem;
        color: #5c636a;
        padding: 14px 10px;
        text-transform: uppercase;
    }

    .table-custom td {
        padding: 14px 10px;
        font-size: 0.92rem;
    }

    .btn-outline-secondary {
        color: #6c757d;
    }

        .btn-outline-secondary:hover {
            background-color: #f1f3f5;
            color: #212529;
        }

    .linha-clicavel {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .linha-clicavel:hover {
            background-color: rgba(0, 0, 0, 0.02) !important;
        }
</style>