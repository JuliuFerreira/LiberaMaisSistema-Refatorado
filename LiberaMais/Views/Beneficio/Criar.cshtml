@model LiberaMais.Models.Beneficio

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Cadastrar Benefício";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light-subtle">
        <div>
            <h3 class="fw-bold text-dark mb-1 tracking-tight">Novo Benefício</h3>
            <p class="text-muted small mb-0">Cadastre um novo tipo de benefício associado a um órgão no sistema.</p>
        </div>
    </div>

    @if (TempData["mensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["mensagemSucesso"]
        </div>
    }
    @if (TempData["mensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["mensagemErro"]
        </div>
    }


    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <form asp-action="Criar" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="row g-4 mb-4">

                    <div class="col-md-3">
                        <label asp-for="OrgaoId" class="form-label small fw-bold text-muted">ÓRGÃO VINCULADO</label>
                        <select asp-for="OrgaoId" class="form-select">

                            <option value="">
                                Selecione
                            </option>

                            @foreach (var ben in ViewBag.orgao)
                            {
                                <option value="@ben.Id">
                                    @ben.Nome
                                </option>
                            }

                        </select>
                        <span asp-validation-for="OrgaoId" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Codigo" class="form-label small fw-bold text-muted">CÓDIGO DO BENEFÍCIO</label>
                        <input asp-for="Codigo" class="form-control rounded-3 py-2" placeholder="Ex: 87" required />
                        <span asp-validation-for="Codigo" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-6">
                        <label asp-for="Descricao" class="form-label small fw-bold text-muted">DESCRIÇÃO DO BENEFÍCIO</label>
                        <input asp-for="Descricao" class="form-control rounded-3 py-2" placeholder="Ex: Amparo Social ao Idoso (BPC)" required />
                        <span asp-validation-for="Descricao" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top border-light-subtle">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-3 small fw-medium text-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-dark px-4 py-2 rounded-3 small fw-semibold">
                        Salvar Benefício
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-link text-decoration-none text-secondary p-0 d-inline-flex align-items-center gap-2 btn-back-hover">
            <i class="bi bi-arrow-left-short fs-4"></i> <span class="fw-medium small">Voltar para a listagem</span>
        </a>
    </div>

</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    /* Estilização dos inputs e selects SaaS */
    .form-control, .form-select {
        border: 1px solid #dee2e6;
        font-size: 0.92rem;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #212529;
            box-shadow: 0 0 0 3px rgba(33, 37, 41, 0.1);
            outline: 0;
        }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}