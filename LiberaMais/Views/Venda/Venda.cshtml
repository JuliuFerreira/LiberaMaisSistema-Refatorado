                        <td>@iten.Cpf</td>
                        <td>@iten.Nome</td>
                        <td>@iten.StatusDescription.GetDisplayName()</td>
                        <td>@iten.BancoDescription.GetDisplayName()</td>
                        <td>@iten.OperacaoDescription.GetDisplayName()</td>
                        <td>@iten.Parcela</td>
                        <td>@iten.UsuarioNome</td>
