                                        <button type="button" class="btn btn-warning">
                                            <i class="bi bi-pencil-square text-white" style="font-size: 16px"></i>
                                        </button>
                                    </div>
                                </a>

                                <button class="btn btn-danger btn-excluir" data-nome="@iten.Nome" data-id="@iten.Id" data-url="@Url.Action("Apagar", "Venda", new { id = iten.Id })">
