@model Venda


@{
    Layout = "LayoutSistema";
}

<body>


    <form style="border: solid 1px black; padding:10px; border-radius: 10px" id="meuForm" asp-controller="Venda" asp-action="CadastroVenda" method="post" class="row g-3">
        <h2 style="text-align:center; margin-top: 50px; margin-bottom: 50px">NOVA VENDA</h2>
        <div class="col-md-4">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" asp-for="Nome" class="form-control" id="Nome" maxlength="50" readonly>
        </div>

        <div class="col-md-2">
            <label for="cpf" class="form-label">CPF</label>
            <input type="text" asp-for="Cpf" class="form-control" id="Cpf" maxlength="11" readonly>
        </div>

        <div style="margin-top: 30px; color: black; border-bottom: solid 1px black">
            <h5 style="padding: 5px; margin-top: 5px; margin-bottom: 5px; font-weight: bold">Dados da operação</h5>
        </div>

        <div class="col-md-2">
            <label for="data">Data da venda*</label>
            <input type="date" asp-for="Data" class="form-control" id="Data">
        </div>


        <div class="col-md-2">
            <label for="orgao" class="form-label">Orgão*</label>
            <select id="orgao" asp-for="Orgao" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.OrgaoEnum>()" class="form-select" required>
                <option value="">Selecione uma opção</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="beneficio" class="form-label">Benefício*</label>
            <select id="beneficio" asp-for="Beneficio" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.BeneficioEnum>()" class="form-select" required>
                <option value="">Selecione uma opção</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="promotora" class="form-label">Promotora*</label>
            <select id="operacao" asp-for="Promotora" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.PromotoraEnum>()" class="form-select" required>
                <option value="">Selecione uma opção</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="banco" class="form-label">Banco*</label>
            <select id="banco" asp-for="Banco" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.BancoEnum>()" class="form-select" required>
                <option value="">Selecione uma opção</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="operacao" class="form-label">Operação*</label>
            <select id="operacao" asp-for="Operacao" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.OperacaoEnum>()" class="form-select" required>
                <option value="">Selecione uma opção</option>
            </select>
        </div>

        <div class="col-md-2">
            <label for="valor" class="form-label">Valor (R$)</label>
            <input type="number" asp-for="Parcela" step="0.01" min="0" placeholder="0.00" class="form-control" id="Parcela" />
        </div>

        <div class="col-md-2">
            <label for="status" class="form-label">Status da operação*</label>
            <select id="status" asp-for="Status" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.StatusEnum>()" class="form-select" required>
                <option value="">Selecione uma opção</option>
            </select>
        </div>

        @* <div class="col-md-2">
            <label for="datapagamento" class="form-label">Data do pagamento</label>
            <input type="date" asp-for="DataPagamento" class="form-control" id="Datapagamento">
        </div> *@

        @* <div class="col-12">
            <label for="observacoes" class="form-label">Observações</label>
            <input type="text" asp-for="Observacoes" class="form-control upper-case" id="Observacoes" rows="3">
        </div>

        <div style="margin-top: 30px; background-color: #cccc; border: 1px solid darkorange">
            <h5 style="padding: 5px; margin-top: 5px; margin-bottom: 5px; margin-left: 10px">Detalhes da comissão</h5>
        </div>

        <div class="col-md-2">
            <label for="valorcomissao" class="form-label">Valor da comissão (R$)</label>
            <input type="text" asp-for="ValorComissao" step="0.01" min="0" placeholder="0.00" class="form-control" id="Valorcomissao">
        </div>

        <div class="col-md-2">
            <label for="comissaoStatus" class="form-label">Status da comissão</label>
            <select id="comissaoStatus" asp-for="ComissaoStatus" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.ComissaoEnum>()" class="form-select">
                <option value="">Selecione uma opção</option>
            </select>
        </div>

        <div class="col-2">
            <label for="dataComissao" class="form-label">Pago ao vendedor em</label>
            <input type="date" asp-for="DataComissao" id="dataComissao" class="form-control">
        </div>

        <div class="col-6">
            <label for="observacao2" class="form-label">Observações</label>
            <input type="text" asp-for="Observacao2" class="form-control upper-case" id="Observacao2" rows="3">
        </div> *@


        <div class="col-12">
            <button type="submit" class="btn btn-outline-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-floppy2-fill" viewBox="0 0 16 16">
                    <path d="M12 2h-2v3h2z" />
                    <path d="M1.5 0A1.5 1.5 0 0 0 0 1.5v13A1.5 1.5 0 0 0 1.5 16h13a1.5 1.5 0 0 0 1.5-1.5V2.914a1.5 1.5 0 0 0-.44-1.06L14.147.439A1.5 1.5 0 0 0 13.086 0zM4 6a1 1 0 0 1-1-1V1h10v4a1 1 0 0 1-1 1zM3 9h10a1 1 0 0 1 1 1v5H2v-5a1 1 0 0 1 1-1" />
                </svg>
                Gravar

            </button>
            <a role="button" class="btn btn-outline-danger" asp-controller="Clientes" asp-action="Clientes">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293z" />
                </svg>
                Cancelar
            </a>
        </div>
    </form>

    <script>
        function voltar() {
            window.history.back();
        }
    </script>

    <script>
        // Espera que o DOM esteja completamente carregado
        document.addEventListener("DOMContentLoaded", function () {
            // Obtém a referência para o campo de data
            var campoData = document.getElementById('Data');

            // Obtém a data atual
            var dataAtual = new Date();

            // Formata a data para o formato "YYYY-MM-DD", que é o formato esperado pelo campo de data
            var ano = dataAtual.getFullYear();
            var mes = ('0' + (dataAtual.getMonth() + 1)).slice(-2); // Adiciona um zero à esquerda para os meses < 10
            var dia = ('0' + dataAtual.getDate()).slice(-2); // Adiciona um zero à esquerda para os dias < 10

            // Define o valor do campo de data como a data atual
            campoData.value = ano + '-' + mes + '-' + dia;
        });
    </script>

    <script>
        $(document).ready(function () {
            // Adiciona um evento de entrada a todos os campos de entrada
            $('input[type="text"]').on('input', function () {
                // Converte o valor inserido para maiúsculas e define-o como o valor do campo
                $(this).val($(this).val().toUpperCase());
            });
        });
    </script>

    <script>
        // Obtém a referência para o campo de data
        var campoData = document.getElementById('data');

        // Obtém a data atual
        var dataAtual = new Date();

        // Formata a data para o formato "YYYY-MM-DD", que é o formato esperado pelo campo de data
        var ano = dataAtual.getFullYear();
        var mes = ('0' + (dataAtual.getMonth() + 1)).slice(-2); // Adiciona um zero à esquerda para os meses < 10
        var dia = ('0' + dataAtual.getDate()).slice(-2); // Adiciona um zero à esquerda para os dias < 10

        // Define o valor do campo de data como a data atual
        campoData.value = ano + '-' + mes + '-' + dia;
    </script>

    <script>
        var campoValor = document.getElementById('valor');

        campoValor.addEventListener('input', function (e) {
            // Obtém o valor do campo e remove qualquer formatação de moeda
            var valor = this.value.replace(/\D/g, '');

            // Se o valor não for vazio, converte para número
            if (valor !== "") {
                valor = parseFloat(valor) / 100; // Divide por 100 para considerar os centavos
            }

            // Formata o valor como um valor monetário
            var valorFormatado = valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

            // Define o valor formatado de volta no campo
            this.value = valorFormatado;
        });
    </script>

    <script>
        // Seleciona todos os elementos com a classe "upper-case"
        var elements = document.querySelectorAll('.upper-case');

        // Itera sobre os elementos e adiciona um event listener para o evento "input"
        elements.forEach(function (element) {
            element.addEventListener('input', function () {
                // Converte o valor do elemento para maiúsculas e atribui de volta ao elemento
                this.value = this.value.toUpperCase();
            });
        });
    </script>

    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {
                $("form").submit(function (event) {
                    event.preventDefault(); // Impede o envio do formulário padrão

                    var form = $(this);
                    $.ajax({
                        type: form.attr('method'),
                        url: form.attr('action'),
                        data: form.serialize(),
                        success: function (response) {
                            if (response.success) {
                                // Mostra o diálogo de confirmação com SweetAlert2
                                Swal.fire({
                                    title: 'Venda cadastrada com sucesso!',
                                    text: 'Deseja cadastrar uma nova venda para este cliente?',
                                    icon: 'success',
                                    showCancelButton: true,
                                    confirmButtonText: 'Sim',
                                    cancelButtonText: 'Não'
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        // Se o usuário clicar em "Sim", mantém na view CadastroVenda
                                        form.trigger("reset"); // Reseta o formulário para um novo cadastro
                                    } else {
                                        // Se o usuário clicar em "Não", redireciona para a view Venda
                                        window.location.href = "@Url.Action("Venda", "Venda")";
                                    }
                                });
                            } else {
                                Swal.fire({
                                    title: 'Erro',
                                    text: response.message,
                                    icon: 'error'
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                title: 'Erro',
                                text: 'Ops, ocorreu um erro. Tente novamente.',
                                icon: 'error'
                            });
                        }
                    });
                });
            });
        </script>
    }

</body>
