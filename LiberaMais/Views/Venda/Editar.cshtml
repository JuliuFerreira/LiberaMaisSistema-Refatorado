```cshtml
@using LiberaMais.Models.Enums
@model Venda

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Editar Venda";

    var clienteId = Model?.ClienteId;
    var clienteNome = Model?.Cliente?.Nome;
    var cpf = Model?.Cliente?.Cpf;

    var beneficios = ViewBag.Beneficios as List<ClienteBeneficio>;
    bool IsAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light-subtle">
        <div>
            <h3 class="fw-bold text-dark mb-1 tracking-tight">Editar Venda</h3>
            <p class="text-muted small mb-0">Atualize os parâmetros operacionais, financeiros ou cadastrais desta venda.</p>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success shadow-sm border-0 rounded-3 mb-3 small">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger shadow-sm border-0 rounded-3 mb-3 small">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 card-custom">

        <form asp-action="Editar" method="post" id="formVenda">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ClienteId" value="@clienteId" />

            <div class="card card-custom shadow-sm border-0 mb-4">

                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <span class="text-dark fw-bold fs-6">
                        <i class="bi bi-file-earmark-text text-secondary me-2"></i>
                        Informações do Contrato
                    </span>
                </div>

                <div class="card-body px-4 pt-3 pb-4">

                    <div class="row g-3">

                        @if (IsAdmin)
                        {
                            <div class="col-md-3">
                                <label class="form-label info-label text-muted mb-1">
                                    Usuário / Operador *
                                </label>

                                <select asp-for="UsuarioId"
                                        class="form-select rounded-3 small"
                                        asp-items='@(new SelectList(ViewBag.Usuario, "Id", "Nome"))'
                                        required>

                                    <option value="">Selecione o Operador</option>

                                </select>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="UsuarioId" />
                        }

                        <div class="col-md-2">
                            <label class="form-label info-label text-muted mb-1">
                                Cliente Nome
                            </label>

                            <input class="form-control bg-light border-light-subtle rounded-3 text-dark fw-medium small"
                                   value="@clienteNome"
                                   readonly
                                   disabled />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label info-label text-muted mb-1">
                                Cliente CPF
                            </label>

                            <input class="form-control bg-light border-light-subtle rounded-3 text-dark font-monospace small"
                                   value="@cpf"
                                   readonly
                                   disabled />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label info-label text-muted mb-1">
                                Benefício *
                            </label>

                            <select asp-for="ClienteBeneficioId"
                                    class="form-select rounded-3 small"
                                    required>

                                <option value="">Selecione o Benefício</option>

                                @if (beneficios != null)
                                {
                                    foreach (var b in beneficios)
                                    {
                                        <option value="@b.Id">
                                            @b.Beneficio?.Orgaos?.Nome - @b.Beneficio?.Descricao
                                        </option>
                                    }
                                }

                            </select>
                        </div>

                        <div class="col-12 col-md-4 mt-md-2">

                            <label class="form-label info-label text-muted mb-1">
                                Promotora *
                            </label>

                            <select asp-for="PromotoraId"
                                    class="form-select rounded-3 small"
                                    id="selectPromotora"
                                    required>

                                <option value="">Selecione</option>

                                @foreach (var p in ViewBag.Promotora ?? new List<Promotora>())
                                {
                                    <option value="@p.Id">@p.Nome</option>
                                }

                            </select>

                        </div>

                        <div class="col-12 col-md-4 mt-md-2">

                            <label class="form-label info-label text-muted mb-1">
                                Banco *
                            </label>

                            <select asp-for="BancoId"
                                    class="form-select rounded-3 small"
                                    id="selectBanco"
                                    data-atual="@Model?.BancoId"
                                    required>

                                <option value="">Selecione a promotora</option>

                            </select>

                        </div>

                        <div class="col-12 col-md-4 mt-md-2">

                            <label class="form-label info-label text-muted mb-1">
                                Operação *
                            </label>

                            <select asp-for="Operacao"
                                    class="form-select rounded-3 small fw-semibold text-primary"
                                    id="selectOperacao"
                                    asp-items="Html.GetEnumSelectList<OperacaoEnum>()"
                                    required>

                                <option value="">Selecione</option>

                            </select>

                        </div>

                        <div class="col-12 col-md-4 mt-md-2">

                            <label class="form-label info-label text-muted mb-1">
                                Status do Contrato *
                            </label>

                            <select asp-for="StatusContrato"
                                    class="form-select rounded-3 small fw-semibold"
                                    id="selectStatus"
                                    asp-items="Html.GetEnumSelectList<StatusEnum>()"
                                    required>

                                <option value="">Selecione</option>

                            </select>

                        </div>

                        <!-- DATA CADASTRO -->
                        <div id="divDataCadastro"
                             class="col-12 col-md-4 mt-md-2"
                             style="display: none;">

                            <label class="form-label info-label text-muted mb-1">
                                Data da Atualização
                            </label>

                            <input asp-for="DataCadastro"
                                   type="date"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="DataCadastro"
                                  class="text-danger small d-block mt-1"></span>

                        </div>

                    </div>

                </div>

            </div>


            <div id="secaoValoresNormais"
                 class="mb-4 bg-light border border-light-subtle rounded-4 p-4">

                <h6 class="text-secondary fw-bold tracking-tight mb-3">
                    <i class="bi bi-file-earmark-text me-1"></i>
                    Dados da Operação
                </h6>

                <div class="row g-3 align-items-end">

                    <div class="col-md-3">

                        <label class="form-label info-label text-muted mb-1">
                            Valor da Parcela
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white border-end-0 text-muted small">
                                R$
                            </span>

                            <input asp-for="ValorParcela"
                                   class="form-control decimal rounded-end-3 small bg-white"
                                   placeholder="0,00"
                                   value='@Model?.ValorParcela?.ToString("N2")' />

                        </div>

                    </div>

                    <div class="col-md-3">

                        <label class="form-label info-label text-muted mb-1">
                            Valor do Contrato
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white border-end-0 text-muted small">
                                R$
                            </span>

                            <input asp-for="ValorContrato"
                                   class="form-control decimal rounded-end-3 small text-success bg-white fw-bold"
                                   placeholder="0,00"
                                   value='@Model?.ValorContrato?.ToString("N2")' />

                        </div>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label info-label text-muted mb-1">
                            Qtd Parcelas
                        </label>

                        <input asp-for="NumeroDeParcelas"
                               type="number"
                               class="form-control rounded-3 small bg-white"
                               placeholder="Ex: 84" />

                    </div>

                    <div class="col-md-4 divDataPagamentoContainer"
                         style="display: none;">

                        <span asp-validation-for="DataPgtoContrato"
                              class="text-danger small d-block mt-1"></span>

                        <label class="form-label info-label text-success mb-1 fw-bold">
                            Data Pagamento (Contrato) *
                        </label>

                        <input type="date"
                               class="form-control border-success-subtle rounded-3 small inputDataPagamentoGeral" />

                    </div>

                </div>

            </div>


            <div id="secaoPortabilidade"
                 style="display: none;"
                 class="mb-4 bg-primary-subtle bg-opacity-25 border border-primary-subtle rounded-4 p-4">

                <h6 class="text-primary fw-bold tracking-tight mb-3">
                    <i class="bi bi-arrow-left-right me-1"></i>
                    Dados da Portabilidade
                </h6>

                <div class="row g-3 align-items-end">

                    <div class="col-md-2">

                        <label class="form-label info-label text-muted mb-1">
                            Nº Contrato Portado
                        </label>

                        <input asp-for="NumeroContrato"
                               class="form-control rounded-3 small bg-white font-monospace"
                               placeholder="Contrato" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label info-label text-muted mb-1">
                            Banco de Origem
                        </label>

                        <input asp-for="BancoComprado"
                               class="form-control rounded-3 small bg-white"
                               placeholder="Ex: Banco Itaú" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label info-label text-muted mb-1">
                            Parcela (Origem)
                        </label>

                        <input asp-for="ValorParcelaPort"
                               class="form-control decimal rounded-3 small bg-white text-danger fw-semibold"
                               placeholder="0,00"
                               value='@Model?.ValorParcelaPort?.ToString("N2")' />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label info-label text-muted mb-1">
                            Saldo Devedor
                        </label>

                        <input asp-for="SaldoDevedor"
                               class="form-control decimal rounded-3 small bg-white text-dark fw-bold"
                               placeholder="0,00"
                               value='@Model?.SaldoDevedor?.ToString("N2")' />

                    </div>

                    <div class="col-md-1">

                        <label class="form-label info-label text-muted mb-1">
                            Restantes
                        </label>

                        <input asp-for="ParcelasRestantes"
                               type="number"
                               class="form-control rounded-3 small bg-white"
                               placeholder="Qtd" />

                    </div>

                    <div class="col-md-2 divDataPagamentoContainer"
                         style="display: none;">

                        <span asp-validation-for="DataPgtoContrato"
                              class="text-danger small d-block mt-1"></span>

                        <label class="form-label info-label text-success mb-1 fw-bold">
                            Data Pagamento (Contrato) *
                        </label>

                        <input asp-for="DataPgtoContrato"
                               type="date"
                               value="@(Model?.DataPgtoContrato?.ToString("yyyy-MM-dd"))"
                               class="form-control border-success-subtle rounded-3 small inputDataPagamentoGeral" />

                    </div>

                </div>

            </div>


            <input type="hidden"
                   asp-for="DataPgtoContrato"
                   id="DataPgtoContrato" />


            <div id="secaoComissao"
                 style="display: none;"
                 class="mb-4 bg-light rounded-4 p-4 border border-light-subtle">

                <h6 class="text-success fw-bold tracking-tight mb-3">
                    <i class="bi bi-currency-dollar me-1"></i>
                    Recebimento da Comissão
                </h6>

                <div class="row g-3">

                    <div class="col-md-4">

                        <label class="form-label info-label text-muted mb-1">
                            Valor da Comissão Recebida
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white border-end-0 text-muted small">
                                R$
                            </span>

                            <input asp-for="ValorComissao"
                                   id="inputValorComissao"
                                   class="form-control decimal rounded-end-3 small bg-white text-primary fw-bold"
                                   placeholder="0,00"
                                   value='@Model?.ValorComissao?.ToString("N2")' />

                        </div>

                        <span asp-validation-for="ValorComissao"
                              class="text-danger small d-block mt-1"></span>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label info-label text-muted mb-1">
                            Data de Pagamento da Comissão
                        </label>

                        <input asp-for="DataPgtoComissao"
                               id="inputDataComissao"
                               type="date"
                               class="form-control rounded-3 small bg-white" />

                    </div>

                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-12">

                    <label class="form-label info-label text-muted mb-1">
                        Observação Geral
                    </label>

                    <textarea asp-for="Observacao"
                              class="form-control rounded-3 small"
                              rows="3"
                              placeholder="Insira observações relevantes aqui caso necessário..."></textarea>

                </div>

            </div>


            <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top border-light-subtle">

                <a asp-action="Index"
                   class="btn btn-light border rounded-3 px-3 py-2 small fw-medium text-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-dark rounded-3 px-4 py-2 small fw-semibold shadow-sm">
                    Atualizar Venda
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .card-custom {
        border: 1px solid rgba(0,0,0,0.05);
    }

    .info-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }

</style>


@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>

    <script>

        $(document).ready(function () {

            $('.decimal').mask('##0,00', { reverse: true });


            // ============================================================
            // DATA DE PAGAMENTO
            // ============================================================

            let dataInicial = $("#DataPgtoContrato").val();

            if (dataInicial) {
                $(".inputDataPagamentoGeral").val(dataInicial);
            }

            $(".inputDataPagamentoGeral").on("change input", function () {
                $("#DataPgtoContrato").val($(this).val());
            });


            // ============================================================
            // CONTROLE DA DATA DE CADASTRO
            // ============================================================

            function verificarDataCadastro() {

                let statusText = $("#selectStatus option:selected")
                    .text()
                    .trim()
                    .toLowerCase();

                if (
                    statusText.includes("digitado") ||
                    statusText.includes("assinado")
                ) {

                    $("#divDataCadastro").show();

                }
                else {

                    $("#divDataCadastro").hide();

                }
            }


            // ============================================================
            // CONTROLE DA OPERAÇÃO
            // ============================================================

            function alternarCamposPorOperacao() {

                let operacaoSelecionada = $("#selectOperacao option:selected")
                    .text()
                    .toLowerCase();

                if (operacaoSelecionada.includes("portabilidade")) {

                    $("#secaoPortabilidade").slideDown();
                    $("#secaoValoresNormais").slideUp();

                }
                else {

                    $("#secaoPortabilidade").slideUp();
                    $("#secaoValoresNormais").slideDown();

                }

                verificarStatusPagamento();
            }


            // ============================================================
            // CONTROLE DO STATUS DE PAGAMENTO / COMISSÃO
            // ============================================================

            function verificarStatusPagamento() {

                let statusText = $("#selectStatus option:selected")
                    .text()
                    .toLowerCase();

                let operacaoSelecionada = $("#selectOperacao option:selected")
                    .text()
                    .toLowerCase();


                // --------------------------------------------------------
                // DATA CADASTRO
                // Digitado ou Assinado = mostra
                // Pago / ComissãoRecebida / demais = esconde
                // --------------------------------------------------------

                verificarDataCadastro();


                // --------------------------------------------------------
                // COMISSÃO / PAGAMENTO
                // --------------------------------------------------------

                if (
                    statusText.includes("pago") ||
                    statusText.includes("comissao") ||
                    statusText.includes("comissão")
                ) {

                    $("#secaoComissao").slideDown();


                    // Gerencia qual bloco deve renderizar
                    // a Data de Pagamento interna

                    if (operacaoSelecionada.includes("portabilidade")) {

                        $("#secaoValoresNormais .divDataPagamentoContainer").hide();

                        $("#secaoPortabilidade .divDataPagamentoContainer").fadeIn();

                    }
                    else {

                        $("#secaoPortabilidade .divDataPagamentoContainer").hide();

                        $("#secaoValoresNormais .divDataPagamentoContainer").fadeIn();

                    }

                }
                else {

                    $(".divDataPagamentoContainer").fadeOut();

                    $("#secaoComissao").slideUp();


                    $(".inputDataPagamentoGeral").val("");

                    $("#DataPgtoContrato").val("");

                    $("#inputValorComissao").val("");

                    $("#inputDataComissao").val("");

                }

            }


            // ============================================================
            // CARREGAR BANCOS DA PROMOTORA
            // ============================================================

            function carregarBancos(callback) {

                let promotoraId = $("#selectPromotora").val();

                let bancoSelect = $("#selectBanco");

                let bancoAtualId = bancoSelect.data("atual");


                if (!promotoraId) {

                    bancoSelect
                        .empty()
                        .append('<option value="">Selecione a promotora</option>');

                    return;
                }


                $.get(
                    '/Venda/BuscarBancosPorPromotora',
                    { promotoraId: promotoraId },
                    function (data) {

                        bancoSelect
                            .empty()
                            .append('<option value="">Selecione</option>');


                        $.each(data, function (i, b) {

                            let selected =
                                (b.id == bancoAtualId)
                                    ? "selected"
                                    : "";


                            bancoSelect.append(
                                `<option value="${b.id}" ${selected}>${b.nome}</option>`
                            );

                        });


                        if (callback) {
                            callback();
                        }

                    }
                );

            }


            // ============================================================
            // DATA DA COMISSÃO -> ALTERA STATUS
            // ============================================================

            $("#inputDataComissao").change(function () {

                if ($(this).val()) {

                    $("#selectStatus option").each(function () {

                        let textoOpcao = $(this)
                            .text()
                            .toLowerCase();


                        if (
                            textoOpcao.includes("comissaopaga") ||
                            textoOpcao.includes("comissão paga") ||
                            textoOpcao.includes("comissao paga")
                        ) {

                            $("#selectStatus")
                                .val($(this).val())
                                .change();

                        }

                    });

                }

            });


            // ============================================================
            // EVENTOS
            // ============================================================

            $("#selectOperacao").change(alternarCamposPorOperacao);

            $("#selectStatus").change(verificarStatusPagamento);


            $("#selectPromotora").change(function () {

                $("#selectBanco").data("atual", "");

                carregarBancos();

            });


            // ============================================================
            // INICIALIZAÇÃO
            // ============================================================

            alternarCamposPorOperacao();

            carregarBancos();


            // ============================================================
            // SUBMIT
            // ============================================================

            $("#formVenda").on("submit", function (e) {

                $(".decimal").each(function () {

                    let val = $(this).val();

                    if (val) {

                        val = val
                            .replace("R$", "")
                            .trim();

                        $(this).val(val);

                    }

                });

                return true;

            });


            // ============================================================
            // ALERTAS
            // ============================================================

            setTimeout(function () {

                $(".alert").fadeOut("slow");

            }, 3000);

        });

    </script>
}
```
