@using LiberaMais.Models.Enums
@model Venda

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Editar Venda";

    // Dados obtidos diretamente do modelo mapeado da Venda
    var clienteId = Model?.ClienteId;
    var clienteNome = Model?.Cliente?.Nome;
    var cpf = Model?.Cliente?.Cpf;

    var beneficios = ViewBag.Beneficios as List<ClienteBeneficio>;
    var IsAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="row justify-content-center">
    <div class="card shadow border-0 rounded-4 col-10 mt-5">
        <div class="card-header bg-warning text-dark">
            <h4 class="text-center mb-0 fw-bold">Editar Venda</h4>
        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div id="alertaSucesso" class="alert alert-success mt-3 mx-4">@TempData["MensagemSucesso"]</div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="alert alert-danger mt-3 mx-4">@TempData["MensagemErro"]</div>
        }

        <div class="card-body p-4">

            <!-- FORMULÁRIO PRINCIPAL DE EDIÇÃO -->
            <form asp-action="Editar" method="post" id="formVenda">
                <!-- Chaves ocultas fundamentais para atualização segura -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ClienteId" value="@clienteId" />

                <!-- PRIMEIRA LINHA: Usuário operador -->
                <div class="row mb-3">
                    @if (IsAdmin)
                    {
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Usuário / Operador *</label>
                            <select asp-for="UsuarioId" class="form-select" asp-items='@(new SelectList(ViewBag.Usuario, "Id", "Nome"))' required>
                                <option value="">Selecione o Operador</option>
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="UsuarioId" />
                    }
                </div>

                <!-- SEGUNDA LINHA: Dados do Cliente e Benefício -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cliente Nome</label>
                        <input class="form-control bg-light" value="@clienteNome" readonly disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Cliente CPF</label>
                        <input class="form-control bg-light" value="@cpf" readonly disabled />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Benefício *</label>
                        <select asp-for="ClienteBeneficioId" class="form-select" required>
                            <option value="">Selecione o Benefício</option>
                            @if (beneficios != null)
                            {
                                foreach (var b in beneficios)
                                {
                                    <option value="@b.Id">@b.Beneficio?.Orgaos?.Nome - @b.Beneficio?.Descricao</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <!-- TERCEIRA LINHA: Configuração do Contrato -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Promotora *</label>
                        <select asp-for="PromotoraId" class="form-select" id="selectPromotora" required>
                            <option value="">Selecione</option>
                            @foreach (var p in ViewBag.Promotora ?? new List<Promotora>())
                            {
                                <option value="@p.Id">@p.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Banco *</label>
                        <!-- Guardamos o ID do banco atual na propriedade data-atual para o script selecionar automaticamente -->
                        <select asp-for="BancoId" class="form-select" id="selectBanco" data-atual="@Model?.BancoId" required>
                            <option value="">Selecione a promotora</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Operação *</label>
                        <select asp-for="Operacao" class="form-select" id="selectOperacao" asp-items="Html.GetEnumSelectList<OperacaoEnum>()" required>
                            <option value="">Selecione</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Status do Contrato *</label>
                        <select asp-for="StatusContrato" class="form-select" id="selectStatus" asp-items="Html.GetEnumSelectList<StatusEnum>()" required>
                            <option value="">Selecione</option>
                        </select>
                    </div>
                </div>

                <!-- QUARTA LINHA: Valores Base Dinâmicos e Data de Pagamento do Contrato -->
                <div class="row mb-3">
                    <!-- Seção de Valores de Contratos Comuns -->
                    <div class="col-md-9" id="secaoValoresNormais">
                        <div class="row">
                            <div class="col-md-4">
                                <label class="form-label">Valor da Parcela</label>
                                <input asp-for="ValorParcela" class="form-control decimal" placeholder="0,00" value='@Model?.ValorParcela?.ToString("N2")' />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Valor do Contrato</label>
                                <input asp-for="ValorContrato" class="form-control decimal" placeholder="0,00" value='@Model?.ValorContrato?.ToString("N2")' />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Quantidade de Parcelas</label>
                                <input asp-for="NumeroDeParcelas" type="number" class="form-control" placeholder="Ex: 84" />
                            </div>

                            <div class="col-md-3" id="divDataPagamento" style="display: none;">
                                <label class="form-label fw-bold text-success">Data de Pagamento (Contrato)</label>
                                <input asp-for="DataPgtoContrato" id="DataPgtoContrato" type="date" class="form-control border-success" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO EXCLUSIVA: Dados da Comissão (Aparece se o status for Pago) -->
                <div id="secaoComissao" style="display: none;">
                    <hr class="text-success" />
                    <h5 class="text-success mb-3"><i class="bi bi-currency-dollar me-2"></i>Dados do Recebimento de Comissão</h5>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Valor da Comissão Recebida</label>
                            <input asp-for="ValorComissao" id="inputValorComissao" class="form-control decimal border-success" placeholder="0,00" value='@Model?.ValorComissao?.ToString("N2")' />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Data de Pagamento da Comissão</label>
                            <input asp-for="DataPgtoComissao" id="inputDataComissao" type="date" class="form-control border-success" />
                        </div>
                    </div>
                </div>

                <!-- SEÇÃO EXCLUSIVA: Portabilidade -->
                <div id="secaoPortabilidade" style="display: none;">
                    <hr class="text-primary" />
                    <h5 class="text-primary mb-3"><i class="bi bi-arrow-left-right me-2"></i>Dados da Portabilidade</h5>
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Número do Contrato Portado</label>
                            <input asp-for="NumeroContrato" class="form-control" placeholder="Contrato de origem" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Banco de origem</label>
                            <input asp-for="BancoComprado" class="form-control" placeholder="Contrato o banco de origem" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Valor da Parcela (Origem)</label>
                            <input asp-for="ValorParcelaPort" class="form-control decimal" placeholder="0,00" value='@Model?.ValorParcelaPort?.ToString("N2")' />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Saldo Devedor</label>
                            <input asp-for="SaldoDevedor" class="form-control decimal" placeholder="0,00" value='@Model?.SaldoDevedor?.ToString("N2")' />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Parcelas Restantes</label>
                            <input asp-for="ParcelasRestantes" type="number" class="form-control" placeholder="Qtd" />
                        </div>
                    </div>
                </div>

                <!-- QUINTA LINHA: Observação Geral -->
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label">Observação Geral</label>
                        <textarea asp-for="Observacao" class="form-control" rows="2" placeholder="Observações importantes..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
                    <button type="submit" class="btn btn-warning px-4 fw-bold">Atualizar Venda</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Alterna dinamicamente os blocos dependendo do tipo de Operação escolhido
            function alternarCamposPorOperacao() {
                let operacaoSelecionada = $("#selectOperacao option:selected").text().toLowerCase();

                if (operacaoSelecionada.includes("portabilidade")) {
                    $("#secaoPortabilidade").slideDown();
                    $("#secaoValoresNormais").slideUp();
                } else {
                    $("#secaoPortabilidade").slideUp();
                    $("#secaoValoresNormais").slideDown();
                }
            }

            // Regra do Status: Se "Pago", abre a data de pagamento e o bloco de comissões
            function verificarStatusPagamento() {
                let statusText = $("#selectStatus option:selected").text().toLowerCase();

                // Exibe os campos caso o status seja "Pago" ou "Comissão Paga"
                if (statusText.includes("pago") || statusText.includes("comissao") || statusText.includes("comissão")) {
                    $("#divDataPagamento").fadeIn();
                    $("#secaoComissao").slideDown();
                } else {
                    $("#divDataPagamento").fadeOut();
                    $("#secaoComissao").slideUp();

                    // Reseta os valores de pagamento e comissão caso o status retroceda para pendente/cancelado
                    $("#DataPgtoContrato").val("");
                    $("#inputValorComissao").val("");
                    $("#inputDataComissao").val("");
                }
            }

            // AJAX: Carrega os bancos vinculados à Promotora selecionada
            function carregarBancos(callback) {
                let promotoraId = $("#selectPromotora").val();
                let bancoSelect = $("#selectBanco");
                let bancoAtualId = bancoSelect.data("atual"); // Resgata o ID salvo do banco original

                if (!promotoraId) {
                    bancoSelect.empty().append('<option value="">Selecione a promotora</option>');
                    return;
                }

                $.get('/Venda/BuscarBancosPorPromotora', { promotoraId: promotoraId }, function(data) {
                    bancoSelect.empty().append('<option value="">Selecione</option>');
                    $.each(data, function(i, b) {
                        let selected = (b.id == bancoAtualId) ? "selected" : "";
                        bancoSelect.append(`<option value="${b.id}" ${selected}>${b.nome}</option>`);
                    });

                    if(callback) callback();
                });
            }

            // --- ESCUTADORES DE EVENTO (TRIGGERS) ---

            // Quando preencher a data de pagamento da comissão, muda o status automaticamente para Comissão Paga
            $("#inputDataComissao").change(function () {
                if ($(this).val()) {
                    $("#selectStatus option").each(function() {
                        let textoOpcao = $(this).text().toLowerCase();
                        if (textoOpcao.includes("comissaopaga") || textoOpcao.includes("comissão paga") || textoOpcao.includes("comissao paga")) {
                            $("#selectStatus").val($(this).val()).change();
                        }
                    });
                }
            });

            // Vincula os gatilhos de mudança dos selects
            $("#selectOperacao").change(alternarCamposPorOperacao);
            $("#selectStatus").change(verificarStatusPagamento);

            $("#selectPromotora").change(function(){
                // Se o usuário mudar a promotora manualmente, removemos a pré-seleção anterior
                $("#selectBanco").data("atual", "");
                carregarBancos();
            });

            // --- CARGA INICIAL DO DOM ---
            alternarCamposPorOperacao();
            verificarStatusPagamento();
            carregarBancos();

            // CORREÇÃO: Mantém a vírgula intacta para que o pt-BR do C# faça o bind correto!
            $("#formVenda").on("submit", function (e) {
                $(".decimal").each(function () {
                    let val = $(this).val();
                    if(val) {
                        val = val.replace("R$", "").trim();
                        $(this).val(val);
                    }
                });
                return true;
            });
        });
    </script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
<script>
    $(document).ready(function () {
        // Aplica a mesma máscara sem o ponto separador de milhar para evitar conflitos de conversão
        $('.decimal').mask('##0,00', { reverse: true });
    });
</script>