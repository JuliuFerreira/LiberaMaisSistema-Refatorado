@model LiberaMais.Models.DashboardVendaViewModel

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Painel de Vendas";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 text-uppercase tracking-wide" style="font-size: 1.6rem;">
                Painel de Vendas
            </h2>
            <small class="text-muted">Acompanhe o status e o fluxo dos contratos em tempo real</small>
        </div>

        <div>
            <a asp-action="Criar" class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 btn-adicionar shadow-sm">
                <i class="bi bi-plus-circle-fill" style="font-size: 1rem;"></i>
                <span class="fw-semibold small">Cadastrar Venda</span>
            </a>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success shadow-sm rounded-3 mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger shadow-sm rounded-3 mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        </div>
    }

    @if (Model.PossuiComissaoAtrasada)
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center justify-content-between p-3 mb-4 animacao-piscar" style="border-radius: 12px;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                <span class="fw-semibold small">
                    @(Model.ContratosComissaoAtrasada == 1
                                    ? $"Atenção: Existe {Model.ContratosComissaoAtrasada} comissão em atraso!"
                                    : $"Atenção: Existem {Model.ContratosComissaoAtrasada} comissões em atraso!")
            </span>
        </div>
        <a asp-action="PorStatus" asp-route-status="Pago" class="btn btn-sm btn-danger rounded-2 fw-bold px-3">Verificar</a>
    </div>
        }

    <div class="row g-3">

        <div class="col-xl col-lg-4 col-md-6">
            <a asp-action="PorStatus" asp-route-status="Digitado" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="icon-box-modern bg-warning-subtle text-warning">
                                <i class="bi bi-file-earmark-check-fill"></i>
                            </div>
                            <h3 class="fw-extrabold text-dark mb-0 font-counter">@Model.Digitado</h3>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Digitado</h6>
                        <small class="text-muted card-desc-text">Aguardando assinatura</small>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <a asp-action="PorStatus" asp-route-status="Assinado" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="icon-box-modern bg-info-subtle text-info">
                                <i class="bi bi-pen-fill"></i>
                            </div>
                            <h3 class="fw-extrabold text-dark mb-0 font-counter">@Model.Assinado</h3>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Assinado</h6>
                        <small class="text-muted card-desc-text">Aguardando pagamento</small>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <a asp-action="PorStatus" asp-route-status="Pago" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="icon-box-modern bg-primary-subtle text-primary">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <h3 class="fw-extrabold text-dark mb-0 font-counter">@Model.Pago</h3>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Pago ao Cliente</h6>
                        <small class="text-muted card-desc-text">Aguardando comissão</small>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <a asp-action="PorStatus" asp-route-status="ComissaoPaga" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="icon-box-modern bg-success-subtle text-success">
                                <i class="bi bi-piggy-bank-fill"></i>
                            </div>
                            <h3 class="fw-extrabold text-dark mb-0 font-counter">@Model.ComissaoPaga</h3>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Comissão Paga</h6>
                        <small class="text-muted card-desc-text">Fluxo finalizado</small>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <a asp-action="PorStatus" asp-route-status="Cancelado" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="icon-box-modern bg-danger-subtle text-danger">
                                <i class="bi bi-x-octagon-fill"></i>
                            </div>
                            <h3 class="fw-extrabold text-dark mb-0 font-counter">@Model.Cancelado</h3>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Cancelado</h6>
                        <small class="text-muted card-desc-text">Contratos arquivados</small>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-medium p-0 btn-back-hover"
           asp-controller="Apps" asp-action="Index">
            <i class="bi bi-arrow-left-short" style="font-size: 1.4rem;"></i> Voltar ao painel
        </a>
    </div>
</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    /* ESTILIZAÇÃO E ALTURA DO CARD PADRONIZADA (130px) */
    .card-modern-button {
        height: 130px;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        border-radius: 14px !important;
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }

        .card-modern-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.07) !important;
        }

    /* CONTAINER DO ÍCONE CENTRALIZADO */
    .icon-box-modern {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.15rem;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .card-modern-button:hover .icon-box-modern {
        transform: scale(1.08);
    }

    /* AJUSTE TEXTUAL */
    .card-title-text {
        font-size: 0.95rem;
        letter-spacing: -0.1px;
    }

    .card-desc-text {
        font-size: 0.78rem;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .font-counter {
        font-size: 1.8rem;
        letter-spacing: -0.5px;
    }

    /* CORES SUB-TOM BOOTSTRAP */
    .bg-primary-subtle {
        background-color: #e3f2fd;
    }

    .bg-success-subtle {
        background-color: #e8f5e9;
    }

    .bg-warning-subtle {
        background-color: #fffde7;
    }

    .bg-info-subtle {
        background-color: #e0f7fa;
    }

    .bg-danger-subtle {
        background-color: #ffebee;
    }

    /* BOTÃO ADICIONAR */
    .btn-adicionar {
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    /* COMPORTAMENTO DO BOTÃO VOLTAR PADRÃO */
    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }

    /* ANIMAÇÃO PISCAR ALERTA */
    .animacao-piscar {
        animation: pulse-danger 2s infinite;
    }

    @@keyframes pulse-danger {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.8;
        }

        100% {
            opacity: 1;
        }
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        setTimeout(function () {
            $("#alertaSucesso").fadeOut("slow");
            $("#alertaErro").fadeOut("slow");
        }, 3000);
    });
</script>