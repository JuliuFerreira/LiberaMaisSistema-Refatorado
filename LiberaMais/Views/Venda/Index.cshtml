@model LiberaMais.Models.DashboardVendaViewModel

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Painel de Vendas";

    var usuarioLogado = ViewBag.UsuarioAtual ?? 0;

    string[] nomesMeses = {"Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro" };
    int mesAtual = ViewBag.Mes ?? DateTime.Today.Month;
    int anoAtual = ViewBag.Ano ?? DateTime.Today.Year;
    string nomesMesCompetencia = nomesMeses[mesAtual - 1];
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 tracking-tight" style="font-size: 1.5rem;">
                Painel de Vendas
            </h2>
            <small class="text-muted">Acompanhe o status e o fluxo dos contratos em tempo real</small>
        </div>

        <div>
            <a asp-action="Criar" class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 btn-adicionar shadow-sm rounded-3">
                <i class="bi bi-plus-lg"></i>
                <span class="fw-semibold small">Nova Venda</span>
            </a>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-3 small">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-3 small">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        </div>
    }

    @if (Model.PossuiComissaoAtrasada)
    {
        <div class="alerta-fixo-atraso mb-4 animate__animated animate__fadeIn">
            <div class="pulse-icon-container">
                <i class="bi bi-bell-fill text-danger"></i>
                <span class="badge-count">@Model.ContratosComissaoAtrasada</span>
            </div>
            <div class="alerta-texto small">
                <span class="fw-bold text-danger me-1">Atenção:</span> Existem comissões pendentes além do prazo.
            </div>
            <a asp-action="PorStatus" asp-route-status="Pago" class="btn btn-sm btn-outline-danger btn-atraso-acao ms-auto fw-semibold small">
                Verificar
            </a>
        </div>
    }

    @if (ViewBag.IsAdmin == true)
    {
        <div class="col-12 col-md-4 col-lg-3">
                <label class="text-muted small fw-semibold d-block mb-1">Filtrar painel por Mês:</label>

            <form id="formFiltroDashboard" method="get" asp-action="Index">
                <div class="d-flex flex-wrap align-items-center gap-2">

                    <select name="mes" class="form-select form-select-sm shadow-sm border" style="width: auto;" onchange="this.form.submit()">
                        <option value="1" selected="@(ViewBag.Mes == 1)">Janeiro</option>
                        <option value="2" selected="@(ViewBag.Mes == 2)">Fevereiro</option>
                        <option value="3" selected="@(ViewBag.Mes == 3)">Março</option>
                        <option value="4" selected="@(ViewBag.Mes == 4)">Abril</option>
                        <option value="5" selected="@(ViewBag.Mes == 5)">Maio</option>
                        <option value="6" selected="@(ViewBag.Mes == 6)">Junho</option>
                        <option value="7" selected="@(ViewBag.Mes == 7)">Julho</option>
                        <option value="8" selected="@(ViewBag.Mes == 8)">Agosto</option>
                        <option value="9" selected="@(ViewBag.Mes == 9)">Setembro</option>
                        <option value="10" selected="@(ViewBag.Mes == 10)">Outubro</option>
                        <option value="11" selected="@(ViewBag.Mes == 11)">Novembro</option>
                        <option value="12" selected="@(ViewBag.Mes == 12)">Dezembro</option>
                    </select>

                    <select name="ano" class="form-select form-select-sm shadow-sm border" style="width: auto;" onchange="this.form.submit()">
                        @for (int a = DateTime.Now.Year - 2; a <= DateTime.Now.Year + 1; a++)
                        {
                            <option value="@a" selected="@(ViewBag.Ano == a)">@a</option>

                        }
                    </select>

                        <div class="col-12 col-md-3">
                            <select name="usuarioId" class="form-select form-select-sm filter-dropdown" style="min-width: 180px;" onchange="this.form.submit()">
                                <option value="" selected="@(string.IsNullOrEmpty(Context.Request.Query["usuarioId"]) && Context.Request.Query.ContainsKey("usuarioId"))">Todos os Usuários</option>
                                @if (ViewBag.Usuarios != null)
                                {
                                    foreach (var user in ViewBag.Usuarios)
                                    {
                                        <option value="@user.Id" selected="@(ViewBag.UsuarioAtual == user.Id)">@user.Nome</option>
                                    }
                                }
                            </select>
                        </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="todos"
                               value="true"
                               id="todos"
                               onchange="this.form.submit()"
                               checked="@(ViewBag.Todos == true)">

                        <label class="form-check-label small fw-semibold d-block mb-1" for="todos">
                            Mostrar Todos Os Periodos
                        </label>
                    </div>
                                            
                </div>

            </form>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-5 g-3">

        <div class="col">
            <a asp-action="PorStatus" asp-route-status="Digitado" asp-route-usuarioId="@ViewBag.UsuarioAtual" class="text-decoration-none">
                <div class="card card-modern-button status-digitado">
                    <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="text-muted fw-semibold small-title">Digitado</span>
                            <div class="icon-box-modern bg-warning-subtle text-warning">
                                <i class="bi bi-file-earmark-text"></i>
                            </div>
                        </div>
                        <div class="mt-2">
                            <h3 class="fw-bold text-dark mb-0 font-counter">@Model.Digitado</h3>
                            <small class="text-muted card-desc-text">Aguardando assinatura</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-action="PorStatus" asp-route-status="Assinado" asp-route-usuarioId="@ViewBag.UsuarioAtual" class="text-decoration-none">
                <div class="card card-modern-button status-assinado">
                    <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="text-muted fw-semibold small-title">Assinado</span>
                            <div class="icon-box-modern bg-info-subtle text-info">
                                <i class="bi bi-pen"></i>
                            </div>
                        </div>
                        <div class="mt-2">
                            <h3 class="fw-bold text-dark mb-0 font-counter">@Model.Assinado</h3>
                            <small class="text-muted card-desc-text">Aguardando pagamento</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-action="PorStatus" asp-route-status="Pago" asp-route-usuarioId="@ViewBag.UsuarioAtual" class="text-decoration-none">
                <div class="card card-modern-button status-pago">
                    <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="text-muted fw-semibold small-title">Pago ao Cliente</span>
                            <div class="icon-box-modern bg-primary-subtle text-primary">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                        </div>
                        <div class="mt-2">
                            <h3 class="fw-bold text-dark mb-0 font-counter">@Model.Pago</h3>
                            <small class="text-muted card-desc-text">Aguardando comissão</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-action="PorStatus" asp-route-status="ComissaoPaga" asp-route-usuarioId="@ViewBag.UsuarioAtual" class="text-decoration-none">
                <div class="card card-modern-button status-concluido">
                    <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="text-muted fw-semibold small-title">Comissão Paga</span>
                            <div class="icon-box-modern bg-success-subtle text-success">
                                <i class="bi bi-check-circle"></i>
                            </div>
                        </div>
                        <div class="mt-2">
                            <h3 class="fw-bold text-dark mb-0 font-counter">@Model.ComissaoPaga</h3>
                            <small class="text-muted card-desc-text">Fluxo finalizado</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <div class="col">
            <a asp-action="PorStatus" asp-route-status="Cancelado" asp-route-usuarioId="@ViewBag.UsuarioAtual" class="text-decoration-none">
                <div class="card card-modern-button status-cancelado">
                    <div class="card-body p-3 d-flex flex-column justify-content-between h-100">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="text-muted fw-semibold small-title">Cancelado</span>
                            <div class="icon-box-modern bg-danger-subtle text-danger">
                                <i class="bi bi-archive"></i>
                            </div>
                        </div>
                        <div class="mt-2">
                            <h3 class="fw-bold text-dark mb-0 font-counter">@Model.Cancelado</h3>
                            <small class="text-muted card-desc-text">Contratos arquivados</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-semibold small p-0 btn-back-hover"
           asp-controller="Apps" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Voltar ao painel geral
        </a>
    </div>
</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .card-modern-button {
        height: 135px;
        transition: transform 0.22s cubic-bezier(0.2, 1, 0.2, 1), box-shadow 0.22s cubic-bezier(0.2, 1, 0.2, 1), border-color 0.22s ease;
        cursor: pointer;
        border-radius: 12px !important;
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.06) !important;
        position: relative;
        overflow: hidden;
    }

    .card-modern-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.04) !important;
        border-color: rgba(0, 0, 0, 0.12) !important;
    }

    .status-digitado {
        border-left: 3px solid #ffc107 !important;
    }

    .status-assinado {
        border-left: 3px solid #0dcaf0 !important;
    }

    .status-pago {
        border-left: 3px solid #0d6efd !important;
    }

    .status-concluido {
        border-left: 3px solid #198754 !important;
    }

    .status-cancelado {
        border-left: 3px solid #dc3545 !important;
    }

    .icon-box-modern {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .small-title {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .card-desc-text {
        font-size: 0.76rem;
        display: block;
    }

    .font-counter {
        font-size: 1.75rem;
        letter-spacing: -0.5px;
        line-height: 1.1;
    }

    .bg-primary-subtle {
        background-color: #f0f7ff;
    }

    .bg-success-subtle {
        background-color: #f0fdf4;
    }

    .bg-warning-subtle {
        background-color: #fdfbe7;
    }

    .bg-info-subtle {
        background-color: #f0fdfa;
    }

    .bg-danger-subtle {
        background-color: #fef2f2;
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .btn-back-hover:hover {
        color: #000 !important;
        transform: translateX(-2px);
    }

    .alerta-fixo-atraso {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #ffffff;
        padding: 10px 16px;
        border-radius: 10px;
        border: 1px solid #fee2e2;
        box-shadow: 0 4px 14px rgba(220, 53, 69, 0.05);
        max-width: 500px;
    }

    .pulse-icon-container {
        position: relative;
        font-size: 1.25rem;
        animation: ring 3s infinite;
        display: inline-flex;
    }

    .badge-count {
        position: absolute;
        top: -4px;
        right: -6px;
        background: #dc3545;
        color: white;
        font-size: 0.62rem;
        padding: 1px 5px;
        border-radius: 20px;
        font-weight: bold;
    }

    .btn-atraso-acao {
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
    }

    @@keyframes ring {
        0%, 100% {
            transform: rotate(0deg);
        }
        10%, 30%, 50% {
            transform: rotate(-8deg);
        }
        20%, 40%, 60% {
            transform: rotate(8deg);
        }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $("#alertaSucesso").fadeOut("slow");
                $("#alertaErro").fadeOut("slow");
            }, 3000);
        });
    </script>
}