@using System.Globalization
@model IEnumerable<Venda>

@{
    Layout = "LayoutSistema";
    decimal totalComissoes = Model.Sum(venda => venda.ValorComissao ?? 0);
}

<div class="container-fluid">
    <h2 style="text-align:center; margin-top: 50px; margin-bottom: 20px">RELATÓRIO DE COMISSÃO</h2>

    <div class="row justify-content-center mb-4">
        <div class="col-md-8 col-lg-6">
            <form id="relatorioForm" method="post" asp-controller="Venda" asp-action="RelatorioVendasFiltrado" class="my-4">
                <div class="form-row">
                    <div class="col-12 mb-2">
                        <div class="input-group">
                            <input class="form-control" type="date" placeholder="Data Início" aria-label="Data Início" name="startDate" id="startDatePicker">
                            <input class="form-control ml-2" type="date" placeholder="Data Fim" aria-label="Data Fim" name="endDate" id="endDatePicker">
                            <select class="form-control ml-2" name="searchString" id="searchString">
                                <option value="">Selecione um Usuário</option>
                                @foreach (var usuario in ViewBag.Usuarios)
                                {
                                    <option value="@usuario.Nome">@usuario.Nome</option>
                                }
                            </select>

                            <div class="input-group-append ml-2">
                                <button class="btn btn-outline-success mr-1" type="submit">
                                    <i class="bi bi-search"></i>
                                    Gerar Relatório
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="container-fluid">
        <div class="table-responsive">
            <table class="table table-hover" id="table-cliente" style="width: 100%">
                <thead style="background-color: #666; color: white">
                    <tr>
                        <th>Data</th>
                        <th>CPF</th>
                        <th>Cliente</th>                        
                        <th>Banco</th>
                        <th>Operação</th>
                        <th>Parcela</th>
                        <th>Status</th>
                        <th>Comissão</th>
                        <th>Vendedor</th>
                        <th style="text-align: center">Pago</th>
                        <th>Editar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var venda in Model)
                    {
                        <tr>
                            <td>@venda.Data.ToString("dd/MM/yyyy")</td>
                            <td>@venda.Cpf</td>
                            <td>@venda.Nome</td>                            
                            <td>@Html.DisplayFor(Model => venda.BancoDescription)</td>
                            <td>@Html.DisplayFor(model => venda.OperacaoDescription)</td>
                            <td>@venda.Parcela?.ToString("C2", new CultureInfo(1046))</td>
                            <td>@Html.DisplayFor(model => venda.ComissaoStatusDescription)</td>
                            <td>@venda.ValorComissao?.ToString("C2", new CultureInfo(1046))</td>
                            <td>@venda.UsuarioNome.ToString()</td>
                            <td style="text-align: center">@venda.DataComissao?.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a role="button" asp-route-id="@venda.Id" asp-controller="Venda" asp-action="EditarComissao">
                                    <div class="d-flex flex-column align-items-center mr-2">
                                        <button type="button" class="btn btn-warning">
                                            <i class="bi bi-pencil-square text-white" style="font-size: 16px"></i>
                                        </button>
                                    </div>
                                </a>

                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td style="border: none" colspan="6" class="text-right font-weight-bold">Total de Comissões:</td>
                        <td style="border: none">@Model.Sum(v => v.ValorComissao ?? 0).ToString("C2", new CultureInfo(1046))</td>
                    </tr>
                </tfoot>
            </table>
        </div>

    </div>
    <div class="text-left my-3">
        <a class="btn btn-outline-secondary btn-lg" style="border-radius: 10px; font-size: 16px" asp-controller="Financa" asp-action="Index">
            <i class="bi bi-arrow-return-left"></i> Voltar
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#relatorioForm").submit(function (event) {
                event.preventDefault(); // Impede o envio do formulário padrão

                // Mostra o diálogo de carregamento
                Swal.fire({
                    title: 'Carregando relatório...',
                    text: 'Aguarde um momento...',
                    icon: 'info',
                    timer: 3000, // 3 segundos
                    showConfirmButton: false,
                    allowOutsideClick: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                }).then(() => {
                    // Submete o formulário após o tempo de carregamento
                    this.submit();
                });
            });
        });
    </script>
}
