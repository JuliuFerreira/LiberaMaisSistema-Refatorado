@model Venda

@{
    Layout = "LayoutSistema";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;

}
<body>    

    <form id="vendaForm" asp-controller="Venda" asp-action="EditarComissao" method="post" class="row g-3">
        <h2 style="text-align:center; margin-top: 50px; margin-bottom: 50px">ALTERAR COMISSÃO</h2>

        <input type="hidden" asp-for="Id" />


        <div class="col-md-4">
            <label for="nome" class="form-label">Nome</label>
            <input type="text" asp-for="Nome" class="form-control" id="Nome" maxlength="50" readonly>
        </div>

        <div class="col-md-2">
            <label for="cpf" class="form-label">CPF</label>
            <input type="text" asp-for="Cpf" class="form-control" id="Cpf" maxlength="11" readonly>
        </div>

        <div style="margin-top: 30px; color: black; border-bottom: solid 1px black">
            <h5 style="padding: 5px; margin-top: 5px; margin-bottom: 5px; font-weight: bold">Dados da operação</h5>
        </div>

        <div class="col-md-2">
            <label for="data" class="form-label">Data</label>
            <input type="date" asp-for="Data" class="form-control" id="Data" readonly>
        </div>


        <div class="col-md-2">
            <label for="promotora" class="form-label">Promotora</label>
            <select id="operacao" class="form-select" asp-for="Promotora" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.PromotoraEnum>()" disabled>
            </select>
            <!-- Campo oculto para enviar o valor ao servidor -->
            <input type="hidden" asp-for="Promotora" />
        </div>

        <div class="col-md-2">
            <label for="banco" class="form-label">Banco</label>
            <select id="banco" asp-for="Banco" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.BancoEnum>()"disabled>
            </select>
            <input type="hidden" asp-for="Banco" />
        </div>

        <div class="col-md-2">
            <label for="operacao" class="form-label">Operação</label>
            <select id="operacao" asp-for="Operacao" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.OperacaoEnum>()" disabled>
            </select>
            <input type="hidden" asp-for="Operacao" />
        </div>

        <div class="col-md-2">
            <label for="valor" class="form-label">Valor (R$)</label>
            <input type="number" asp-for="Parcela" step="0.01" min="0" placeholder="0.00" class="form-control" id="Parcela" readonly> 
        </div>

        <div class="col-md-2">
            <label for="status" class="form-label">Status da operação</label>
            <select id="status" asp-for="Status" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.StatusEnum>()" disabled>
            </select>
            <input type="hidden" asp-for="Status" />
        </div>


        <div class="col-md-2">
            <label for="datapagamento" class="form-label">Data do pagamento</label>
            <input type="date" asp-for="DataPagamento" class="form-control" id="Datapagamento" readonly>
        </div>

        <div class="col-12">
            <label for="observacoes" class="form-label">Observações</label>
            <input type="text" asp-for="Observacoes" class="form-control" id="Observacoes" rows="3" readonly>
        </div>

        <div style="margin-top: 30px; color: black; border-bottom: solid 1px black">
            <h5 style="padding: 5px; margin-top: 5px; margin-bottom: 5px; font-weight: bold">Detalhes da comissão</h5>
        </div>

        <div class="col-md-2">
            <label for="valorcomissao" class="form-label">Valor da comissão (R$)</label>
            <input type="number" asp-for="ValorComissao" step="0.01" min="0" placeholder="0.00" class="form-control" id="Valorcomissao">
        </div>

        <div class="col-md-2">
            <label for="comissaoStatus" class="form-label">Status da comissão</label>
            <select id="comissaoStatus" asp-for="ComissaoStatus" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.ComissaoEnum>()">
            </select>
        </div>

        <div class="col-2">
            <label for="dataComissao" class="form-label">Pago ao vendedor em</label>
            <input type="date" asp-for="DataComissao" id="dataComissao" class="form-control">
        </div>

        <div class="col-6">
            <label for="observacao2" class="form-label">Observações</label>
            <input type="text" asp-for="Observacao2" class="form-control" id="Observacao2" rows="3">
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-outline-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-floppy2-fill" viewBox="0 0 16 16">
                    <path d="M12 2h-2v3h2z" />
                    <path d="M1.5 0A1.5 1.5 0 0 0 0 1.5v13A1.5 1.5 0 0 0 1.5 16h13a1.5 1.5 0 0 0 1.5-1.5V2.914a1.5 1.5 0 0 0-.44-1.06L14.147.439A1.5 1.5 0 0 0 13.086 0zM4 6a1 1 0 0 1-1-1V1h10v4a1 1 0 0 1-1 1zM3 9h10a1 1 0 0 1 1 1v5H2v-5a1 1 0 0 1 1-1" />
                </svg>
                Gravar

            </button>
            <a role="button" class="btn btn-outline-danger" asp-controller="Venda" asp-action="RelatorioVendas">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293z" />
                </svg>
                Cancelar
            </a>
        </div>
    </form>

    <script>
        function voltar() {
            window.history.back();
        }
    </script>

    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
        <script type="text/javascript">
            $(document).ready(function () {
                $("form#vendaForm").submit(function (event) {
                    event.preventDefault(); // Impede o envio do formulário padrão

                    var form = $(this);
                    $.ajax({
                        type: form.attr('method'),
                        url: form.attr('action'),
                        data: form.serialize(),
                        success: function (response) {
                            if (response.success) {
                                // Mostra o diálogo de sucesso com SweetAlert2
                                Swal.fire({
                                    title: 'Comissão editada com sucesso!',
                                    text: 'Redirecionando...',
                                    icon: 'success',
                                    timer: 3000, // 3 segundos
                                    showConfirmButton: false
                                }).then(() => {
                                    // Redireciona para a view Clientes após 3 segundos
                                    window.location.href = "@Url.Action("RelatorioVendas", "Venda")";
                                });
                            } else {
                                Swal.fire({
                                    title: 'Erro',
                                    text: response.message,
                                    icon: 'error'
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                title: 'Erro',
                                text: 'Ops, ocorreu um erro. Tente novamente.',
                                icon: 'error'
                            });
                        }
                    });
                });
            });
        </script>
    }

</body>