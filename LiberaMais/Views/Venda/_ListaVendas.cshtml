@using LiberaMais.Models.Enums
@using System.Globalization
@model IEnumerable<Venda>
@{
    var vendasOrdenadas = Model.OrderBy(v => v.Data);
}
<div class="table-responsive">
    <table class="table table-hover">
        <thead style="background-color: #666; color: white">
            <tr>
                <th>Data</th>
                <th style="text-align: initial">CPF</th>
                <th>Nome</th>
                <th>Banco</th>
                <th>Operação</th>
                <th>Parcela</th>
                <th>Status da comissão</th>
                <th>Usuário</th>
                <th style="text-align: center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var venda in vendasOrdenadas)
            {
                <tr style="font-size: 16px; border-color: black;">
                    <td>@venda.Data.ToString("dd/MM/yyyy")</td>
                    <td>@venda.Cpf</td>
                    <td>@venda.Nome</td>
                    <td>@Html.DisplayFor(model => venda.BancoDescription)</td>
                    <td>@Html.DisplayFor(model => venda.OperacaoDescription)</td>
                    <td>@venda.Parcela?.ToString("C2", new CultureInfo(1046))</td>
                    <td>@Html.DisplayFor(model => venda.ComissaoStatusDescription)</td>
                    <td>@venda.UsuarioNome</td>
                    <td style="border-color: black;">
                        <div class="d-flex justify-content-center">
                            <a role="button" asp-route-id="@venda.Id" asp-controller="Venda" asp-action="DetalheVenda">
                                <div class="d-flex flex-column align-items-center mr-2">
                                    <button type="button" class="btn btn-primary">
                                        <i class="bi bi-eye text-white" style="font-size: 16px;"></i>
                                    </button>
                                </div>
                            </a>
                            <a role="button" asp-route-id="@venda.Id" asp-controller="Venda" asp-action="EditarVenda">
                                <div class="d-flex flex-column align-items-center mr-2">
                                    <button type="button" class="btn btn-warning">
                                        <i class="bi bi-pencil-square text-white" style="font-size: 16px;"></i>
                                    </button>
                                </div>
                            </a>
                            <div class="d-flex">
                                <button class="btn btn-danger btn-excluir-venda" data-nome="@venda.Nome" data-id="@venda.Id" data-url="@Url.Action("Apagar", "Venda", new { id = venda.Id })">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        const btnsExcluirVenda = document.querySelectorAll('.btn-excluir-venda');

        btnsExcluirVenda.forEach(btn => {
            btn.addEventListener('click', function () {
                const id = btn.getAttribute('data-id');
                const nome = btn.getAttribute('data-nome');
                const url = btn.getAttribute('data-url');

                Swal.fire({
                    text: 'Tem certeza que deseja excluir essa venda?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Excluir',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(url, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: JSON.stringify({ id: id })
                        })
                            .then(response => response.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire({
                                        title: 'Venda excluída com sucesso!',
                                        text: 'Atualizado lista...',
                                        icon: 'success',
                                        showConfirmButton: false,
                                        timer: 3000 
                                    }).then(() => {
                                        // Redirecionar após a mensagem de sucesso
                                        window.location.reload(); // Recarregar a página para atualizar a lista
                                    });
                                } else {
                                    Swal.fire({
                                        title: 'Erro!',
                                        text: data.message,
                                        icon: 'error',
                                        confirmButtonText: 'Ok'
                                    });
                                }
                            })
                            .catch(error => {
                                Swal.fire({
                                    title: 'Erro!',
                                    text: 'Ocorreu um erro ao tentar excluir a venda.',
                                    icon: 'error',
                                    confirmButtonText: 'Ok'
                                });
                            });
                    }
                });
            });
        });
    });
</script>
