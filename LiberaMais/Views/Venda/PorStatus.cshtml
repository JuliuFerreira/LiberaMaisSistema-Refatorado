@using LiberaMais.Models.Enums
@model List<LiberaMais.Models.Venda>

@{
Layout = "_LayoutSistema";
ViewData["Title"] = $"Vendas - {ViewBag.StatusAtual}";

bool exibirColunaPortabilidade = Model != null &&
    Model.Any(v => v.Operacao.ToString().ToLower().Contains("portabilidade"));

int paginaAtual = ViewBag.PaginaAtual ?? 1;
int totalPaginas = ViewBag.TotalPaginas ?? 1;

decimal valorContratoTotal = ViewBag.ValorContrato ?? 0m;
decimal valorSaldoTotal = ViewBag.ValorSaldo ?? 0m;
decimal ValorComissao = ViewBag.ValorComissao ?? 0m;

int? mesSelecionado = ViewBag.Mes;
int anoSelecionado = ViewBag.Ano ?? DateTime.Now.Year;

int mesAtual = DateTime.Today.Month;
int anoAtuasl = DateTime.Today.Year;

bool atrasadas = ViewBag.Atrasadas ?? false;

var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

// =========================================================
// REGRA PARA IDENTIFICAR COMISSÃO EM ATRASO
// =========================================================
bool ComissaoEstaAtrasada(LiberaMais.Models.Venda venda)
{
    if (venda.StatusContrato != StatusEnum.Pago ||
        !venda.DataPgtoContrato.HasValue)
    {
        return false;
    }

    var dataPagamento = venda.DataPgtoContrato.Value;

    // =====================================================
    // BANCO 34 - BRB (RED CONSIG)
    // =====================================================
    if (venda.BancoId == 34)
    {
        DateTime dataPrevistaComissao;

        if (dataPagamento.Day <= 15)
        {
            dataPrevistaComissao = new DateTime(
                dataPagamento.Year,
                dataPagamento.Month,
                DateTime.DaysInMonth(
                    dataPagamento.Year,
                    dataPagamento.Month));
        }
        else
        {
            var proximoMes = dataPagamento.AddMonths(1);

            dataPrevistaComissao = new DateTime(
                proximoMes.Year,
                proximoMes.Month,
                15);
        }

        return DateTime.Now.Date > dataPrevistaComissao.Date;
    }

    // =====================================================
    // DEMAIS BANCOS
    // Regra atual: 5 dias após o pagamento
    // =====================================================

    var dataLimite = DateTime.Now.AddDays(-5);

    return dataPagamento < dataLimite;
}

}

<div class="container-fluid px-0 mt-4 inner-system-page">

<!-- CABEÇALHO -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-light-subtle">

    <div>
        <h3 class="fw-bold text-dark mb-1 tracking-tight">
            Vendas: @ViewBag.StatusAtual
        </h3>

        <p class="text-muted small mb-0">
            Consulte e acompanhe as vendas neste status.
        </p>
    </div>

    <div>
        <a asp-controller="Venda"
           asp-action="Criar"
           class="btn btn-dark rounded-3 px-3 d-inline-flex align-items-center gap-2 shadow-sm">

            <i class="bi bi-plus-lg"></i>

            <span>Nova Venda</span>

        </a>
    </div>

</div>

<!-- MENSAGENS -->
@if (TempData["MensagemSucesso"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-3">

        <i class="bi bi-check-circle-fill"></i>

        <span>@TempData["MensagemSucesso"]</span>

    </div>
}

@if (TempData["mensagemErro"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-3">

        <i class="bi bi-exclamation-triangle-fill"></i>

        <span>@TempData["mensagemErro"]</span>

    </div>
}

<!-- FILTROS -->
<div class="card border-0 shadow-sm rounded-4 mb-4">

    <div class="card-body p-3">

        <form asp-controller="Venda"
              asp-action="PorStatus"
              method="get">

            <input type="hidden"
                   name="status"
                   value="@ViewBag.StatusParametro" />

            <input type="hidden"
                   name="atrasadas"
                   value="@atrasadas.ToString().ToLower()" />

            <div class="row g-2 align-items-end">

                <!-- BUSCA -->
                <div class="col-12 col-md-2">

                    <label class="form-label small fw-semibold text-secondary mb-1">
                        Buscar
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <input type="text"
                               name="busca"
                               value="@ViewBag.BuscaAtual"
                               class="form-control border-start-0"
                               placeholder="Nome, CPF, nosso número..." />

                    </div>

                </div>

                <!-- OPERAÇÃO -->
                <div class="col-12 col-md-2">

                    <label class="form-label small fw-semibold text-secondary mb-1">
                        Operação
                    </label>

                    <select name="operacao"
                            class="form-select"
                            onchange="this.form.submit()">

                        @if (ViewBag.OperacaoEnum == null)
                        {
                            <option value="" selected>
                                Todas as Operações
                            </option>
                        }
                        else
                        {
                            <option value="">
                                Todas as Operações
                            </option>
                        }

                        @foreach (var op in Enum.GetValues<OperacaoEnum>())
                        {
                            if (ViewBag.OperacaoEnum != null &&
                                (OperacaoEnum)ViewBag.OperacaoEnum == op)
                            {
                                <option value="@op" selected>
                                    @op.GetDisplayName()
                                </option>
                            }
                            else
                            {
                                <option value="@op">
                                    @op.GetDisplayName()
                                </option>
                            }
                        }

                    </select>

                </div>

                <!-- USUÁRIO -->
                @if (ViewBag.IsAdmin == true)
                {
                    <div class="col-12 col-md-3">

                        <label class="form-label small fw-semibold text-secondary mb-1">
                            Usuário
                        </label>

                        <select name="usuarioId"
                                class="form-select"
                                onchange="this.form.submit()">

                            @if (ViewBag.UsuarioAtual == null)
                            {
                                <option value="" selected>
                                    Todos os Usuários
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    Todos os Usuários
                                </option>
                            }

                            @foreach (var usuario in ViewBag.Usuarios)
                            {
                                if (ViewBag.UsuarioAtual != null &&
                                    (int)ViewBag.UsuarioAtual == usuario.Id)
                                {
                                    <option value="@usuario.Id" selected>
                                        @usuario.Nome
                                    </option>
                                }
                                else
                                {
                                    <option value="@usuario.Id">
                                        @usuario.Nome
                                    </option>
                                }
                            }

                        </select>

                    </div>
                }

                <!-- MÊS -->
                <div class="col-12 col-md-2">

                    <label class="form-label small fw-semibold text-secondary mb-1">
                        Mês
                    </label>

                    <select name="mes"
                            class="form-select"
                            onchange="this.form.submit()">

                        <!-- TODOS OS MESES -->
                        @if (!mesSelecionado.HasValue)
                        {
                            <option value="" selected>
                                Todos os meses
                            </option>
                        }
                        else
                        {
                            <option value="">
                                Todos os meses
                            </option>
                        }

                        <!-- JANEIRO A DEZEMBRO -->
                        @for (int i = 1; i <= 12; i++)
                        {
                            string nomeMes = cultura.DateTimeFormat.GetMonthName(i);

                            if (mesSelecionado.HasValue && i == mesSelecionado.Value)
                            {
                                <option value="@i" selected>
                                    @nomeMes
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    @nomeMes
                                </option>
                            }
                        }

                    </select>

                </div>

                <!-- ANO -->
                <div class="col-12 col-md-2">

                    <label class="form-label small fw-semibold text-secondary mb-1">
                        Ano
                    </label>

                    <select name="ano"
                            class="form-select"
                            onchange="this.form.submit()">

                        @for (int i = anoSelecionado - 2; i <= anoSelecionado + 1; i++)
                        {
                            if (i == anoSelecionado)
                            {
                                <option value="@i" selected>
                                    @i
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    @i
                                </option>
                            }
                        }

                    </select>

                </div>

                <!-- BOTÃO LIMPAR -->
                <div class="col-12 col-md-auto">

                    <a asp-controller="Venda"
                       asp-action="PorStatus"
                       asp-route-status="@ViewBag.StatusParametro"
                       asp-route-atrasadas="@atrasadas"
                       class="btn btn-light border rounded-3 px-3 w-100">

                        <i class="bi bi-x-circle me-1"></i>

                        Limpar

                    </a>

                </div>

            </div>

        </form>

    </div>

</div>

<!-- TABELA -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th class="ps-4 small text-secondary fw-semibold">
                        Nosso Número
                    </th>

                    <th class="small text-secondary fw-semibold">
                        Data
                    </th>

                    <th class="small text-secondary fw-semibold">
                        CPF
                    </th>

                    <th class="small text-secondary fw-semibold">
                        Cliente
                    </th>

                    <th class="small text-secondary fw-semibold">
                        Operação
                    </th>

                    <th class="small text-secondary fw-semibold">
                        Banco
                    </th>

                    @if (ViewBag.IsAdmin == true)
                    {
                        <th class="small text-secondary fw-semibold">
                            Usuário
                        </th>
                    }

                    <th class="small text-secondary fw-semibold">
                        Parcela
                    </th>

                    <th class="small text-secondary fw-semibold">
                        Contrato / Saldo
                    </th>

                    <th class="small text-secondary fw-semibold">

                        @if (Model.Any(x => x.StatusContrato == StatusEnum.Pago))
                        {
                            @:Prévia
                        }
                        else if (Model.Any(x => x.StatusContrato == StatusEnum.ComissaoPaga))
                        {
                            @:Comissão
                        }

                    </th>

                    <th class="small text-secondary fw-semibold">

                        @if (Model.Any(x => x.StatusContrato == StatusEnum.Pago))
                        {
                            @:Data de Pagamento Contrato
                        }
                        else if (Model.Any(x => x.StatusContrato == StatusEnum.ComissaoPaga))
                        {
                            @:Data de Pagamento Comissão
                        }

                    </th>

                    <th class="pe-4 text-end small text-secondary fw-semibold">
                        Ações
                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    foreach (var venda in Model)
                    {
                        bool comissaoEmAtraso = ComissaoEstaAtrasada(venda);

                        <tr class="linha-clicavel"
                            data-href="@Url.Action("Detalhe", "Venda", new { id = venda.Id })"
                            onclick="abrirDetalheVenda(this, event)">

                            <!-- NOSSO NÚMERO -->
                            <td class="ps-4">

                                <span class="fw-semibold text-dark small">
                                    @venda.Id
                                </span>

                            </td>

                            <!-- DATA -->
                            <td>

                                <span class="small text-muted">
                                    @venda.DataCadastro?.ToString("dd/MM/yyyy")
                                </span>

                            </td>

                            <!-- CPF -->
                            <td>

                                <span class="small text-dark">
                                    @venda.Cliente?.Cpf
                                </span>

                            </td>

                            <!-- CLIENTE -->
                            <td>

                                <div class="fw-semibold text-dark small">
                                    @venda.Cliente?.Nome
                                </div>

                            </td>

                            <!-- OPERAÇÃO -->
                            <td>

                                <span class="badge rounded-pill bg-light text-dark border px-2 py-1">
                                    @venda.Operacao.GetDisplayName()
                                </span>

                            </td>

                            <!-- BANCO -->
                            <td>

                                <span class="small text-dark">
                                    @venda.Banco?.Nome
                                </span>

                            </td>

                            <!-- USUÁRIO -->
                            @if (ViewBag.IsAdmin == true)
                            {
                                <td>

                                    <span class="small text-muted">
                                        @venda.Usuario?.Nome
                                    </span>

                                </td>
                            }

                            <!-- PARCELA -->
                            <td>

                                <span class="small text-dark">

                                    @if (venda.Operacao.ToString().ToLower().Contains("portabilidade"))
                                    {
                                        @:R$ @venda.ValorParcelaPort?.ToString("N2")
                                    }
                                    else
                                    {
                                        @:R$ @venda.ValorParcela?.ToString("N2")
                                    }

                                </span>

                            </td>

                            <!-- CONTRATO / SALDO -->
                            <td>

                                <div class="fw-bold text-dark small">
                                    R$ @venda.ValorContrato?.ToString("N2")
                                </div>

                                @if (venda.SaldoDevedor.HasValue)
                                {
                                    <div class="text-muted"
                                         style="font-size: .72rem;">

                                        Saldo:
                                        R$ @venda.SaldoDevedor.Value.ToString("N2")

                                    </div>
                                }

                            </td>

                            <!-- PRÉVIA / COMISSÃO -->
                            <td>

                                @if (venda.StatusContrato == StatusEnum.Pago ||
                                     venda.StatusContrato == StatusEnum.ComissaoPaga)
                                {
                                    <div class="small text-dark">

                                        @if (venda.ValorComissao.HasValue)
                                        {
                                            @:R$ @venda.ValorComissao.Value.ToString("N2")
                                        }
                                        else
                                        {
                                            @:R$ 0,00
                                        }

                                    </div>
                                }

                            </td>

                            <!-- DATA DE PAGAMENTO -->
                            <td>

                                @if (venda.StatusContrato == StatusEnum.Pago)
                                {
                                    @if (venda.DataPgtoContrato.HasValue)
                                    {
                                        <div class="small text-dark">
                                            @venda.DataPgtoContrato.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            —
                                        </span>
                                    }

                                    @if (comissaoEmAtraso)
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle mt-1"
                                              style="font-size: .68rem;">

                                            <i class="bi bi-clock-history me-1"></i>

                                            Comissão em atraso

                                        </span>
                                    }
                                }
                                else if (venda.StatusContrato == StatusEnum.ComissaoPaga)
                                {
                                    @if (venda.DataPgtoComissao.HasValue)
                                    {
                                        <div class="small text-dark">
                                            @venda.DataPgtoComissao.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            —
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        —
                                    </span>
                                }

                            </td>

                            <!-- AÇÕES -->
                            <td class="pe-4 text-end ignorar-clique">

                                <div class="d-inline-flex align-items-center gap-1">

                                    <a asp-controller="Venda"
                                       asp-action="Editar"
                                       asp-route-id="@venda.Id"
                                       class="btn btn-sm btn-outline-warning border-0"
                                       title="Editar">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <button class="btn btn-sm btn-outline-danger border-0"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalExcluir_@venda.Id">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </div>

                            </td>

                        </tr>

                        <div class="modal fade"
                             id="modalExcluir_@venda.Id"
                             tabindex="-1"
                             aria-hidden="true"
                             onclick="event.stopPropagation();">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content border-0 shadow">

                                    <div class="modal-header border-0">

                                        <h5 class="modal-title">
                                            Confirmar Exclusão
                                        </h5>

                                        <button type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                                aria-label="Close">
                                        </button>

                                    </div>

                                    <div class="modal-body">
                                        Deseja realmente excluir essa venda?
                                    </div>

                                    <div class="modal-footer border-0">

                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                data-bs-dismiss="modal">
                                            Cancelar
                                        </button>

                                        <form asp-action="Apagar"
                                              method="post"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@venda.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger">
                                                Confirmar Exclusão
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="@(ViewBag.IsAdmin == true ? 12 : 11)"
                            class="text-center py-5">

                            <div class="text-muted">

                                <i class="bi bi-inbox fs-1 d-block mb-2 opacity-50"></i>

                                <div class="fw-semibold">
                                    Nenhuma venda encontrada
                                </div>

                                <small>
                                    Não existem vendas para os filtros selecionados.
                                </small>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

            <!-- TOTAIS -->
            <tfoot>

                <tr class="border-top">

                    <!-- TOTAL DE VENDAS -->
                    <td colspan="@(ViewBag.IsAdmin == true ? 7 : 6)"
                        class="ps-4 py-3 bg-light">

                        <div class="d-flex align-items-center gap-2">

                            <i class="bi bi-bar-chart-fill text-secondary"></i>

                            <span class="small text-secondary">

                                Total de

                                <strong class="text-dark">
                                    @ViewBag.TotalRegistros
                                </strong>

                                vendas encontradas

                            </span>

                        </div>

                    </td>

                    <!-- PARCELA - IDENTIFICAÇÕES -->
                    <td class="py-3 bg-light">

                        <div class="text-muted"
                             style="font-size: .70rem;">
                            Valor dos contratos:
                        </div>

                        <div class="mt-1 text-muted"
                             style="font-size: .70rem;">
                            Saldo devedor:
                        </div>

                    </td>

                    <!-- CONTRATO / SALDO - VALORES -->
                    <td class="py-3 bg-light">

                        <div class="fw-bold text-dark small">
                            R$ @valorContratoTotal.ToString("N2")
                        </div>

                        <div class="mt-1 fw-bold text-secondary small">
                            R$ @valorSaldoTotal.ToString("N2")
                        </div>

                    </td>

                    <!-- PRÉVIA / COMISSÃO -->
                    <td class="py-3 bg-light">

                        @if (Model.Any(x => x.StatusContrato == StatusEnum.Pago ||
                                            x.StatusContrato == StatusEnum.ComissaoPaga))
                        {
                            <div class="small text-dark">
                                R$ @ValorComissao.ToString("N2")
                            </div>
                        }

                    </td>

                    <!-- DATA DE PAGAMENTO -->
                    <td class="py-3 bg-light">
                    </td>

                    <!-- AÇÕES -->
                    <td class="pe-4 bg-light">
                    </td>

                </tr>

            </tfoot>

        </table>

    </div>

    <!-- PAGINAÇÃO -->
    @if (totalPaginas > 1)
    {
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 px-4 py-3 border-top">

            <div class="small text-muted">

                Página

                <strong class="text-dark">
                    @paginaAtual
                </strong>

                de

                <strong class="text-dark">
                    @totalPaginas
                </strong>

            </div>

            <nav aria-label="Paginação">

                <ul class="pagination pagination-sm mb-0">

                    <!-- ANTERIOR -->
                    <li class="page-item @(paginaAtual <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           href="@Url.Action("PorStatus", "Venda", new {
                               status = ViewBag.StatusParametro,
                               busca = ViewBag.BuscaAtual,
                               usuarioId = ViewBag.UsuarioAtual,
                               operacao = ViewBag.OperacaoEnum,
                               mes = ViewBag.Mes,
                               ano = ViewBag.Ano,
                               atrasadas = ViewBag.Atrasadas,
                               pagina = paginaAtual - 1
                           })">

                            <i class="bi bi-chevron-left"></i>

                        </a>

                    </li>

                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaAtual ? "active" : "")">

                            <a class="page-link"
                               href="@Url.Action("PorStatus", "Venda", new {
                                   status = ViewBag.StatusParametro,
                                   busca = ViewBag.BuscaAtual,
                                   usuarioId = ViewBag.UsuarioAtual,
                                   operacao = ViewBag.OperacaoEnum,
                                   mes = ViewBag.Mes,
                                   ano = ViewBag.Ano,
                                   atrasadas = ViewBag.Atrasadas,
                                   pagina = i
                               })">

                                @i

                            </a>

                        </li>
                    }

                    <!-- PRÓXIMA -->
                    <li class="page-item @(paginaAtual >= totalPaginas ? "disabled" : "")">

                        <a class="page-link"
                           href="@Url.Action("PorStatus", "Venda", new {
                               status = ViewBag.StatusParametro,
                               busca = ViewBag.BuscaAtual,
                               usuarioId = ViewBag.UsuarioAtual,
                               operacao = ViewBag.OperacaoEnum,
                               mes = ViewBag.Mes,
                               ano = ViewBag.Ano,
                               atrasadas = ViewBag.Atrasadas,
                               pagina = paginaAtual + 1
                           })">

                            <i class="bi bi-chevron-right"></i>

                        </a>

                    </li>

                </ul>

            </nav>

        </div>
    }

</div>

<div class="mt-4">

    <a asp-controller="Venda"
       asp-action="Index"
       class="btn btn-link text-decoration-none text-secondary p-0 d-inline-flex align-items-center gap-2 btn-back-hover">

        <i class="bi bi-arrow-left-short fs-4"></i>

        <span class="fw-medium small">
            Voltar
        </span>

    </a>

</div>

</div>

<style>

    .linha-clicavel {
        cursor: pointer;
        transition: background-color .15s ease;
    }

    .linha-clicavel:hover {
        background-color: rgba(0, 0, 0, .025);
    }

    .linha-clicavel td {
        vertical-align: middle;
    }

    .pagination .page-link {
        color: #343a40;
        border-color: #dee2e6;
    }

    .pagination .page-item.active .page-link {
        background-color: #212529;
        border-color: #212529;
        color: #fff;
    }

    .pagination .page-link:hover {
        background-color: #f1f1f1;
        color: #212529;
    }

    .pagination .page-item.active .page-link:hover {
        background-color: #212529;
        color: #fff;
    }

    .btn-light {
        transition: all .15s ease;
    }

    .btn-light:hover {
        background-color: #f1f1f1;
    }

    .btn-back-hover {
        transition: color .2s ease, transform .2s ease;
    }

    .btn-back-hover:hover {
        color: #212529 !important;
        transform: translateX(-2px);
    }

</style>

<script>

    function abrirDetalheVenda(linha, evento) {

        // Se clicou em Editar ou Excluir, não abre o Detalhe
        if (evento.target.closest(".ignorar-clique")) {
            return;
        }

        // Pega a URL armazenada na própria linha
        var url = linha.getAttribute("data-href");

        // Redireciona para o Detalhe
        if (url) {
            window.location.href = url;
        }

    }

</script>
