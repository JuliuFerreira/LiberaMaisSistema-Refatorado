@model Venda

@{
    Layout = "LayoutSistema";
}



<body>

    <form style="border: solid 1px black; padding:10px; border-radius: 10px" id="meuForm" asp-controller="Venda" asp-action="DetalheVenda" method="post" class="row g-3">
        <h2 style="text-align:center; margin-top: 50px; margin-bottom: 50px">DETALHES</h2>


        <input type="hidden" asp-for="Id" />    
        

        <div class="col-md-4">
            <label for="nome" style="font-weight: bold" class="form-label">Nome</label>
            <input type="text" asp-for="Nome" class="form-control" id="Nome" style="border:none; background:none; padding-left: 0" maxlength="50" disabled>
        </div>

        <div class="col-md-2">
            <label for="cpf" style="font-weight: bold" class="form-label">CPF</label>
            <input type="text" asp-for="Cpf" class="form-control" id="Cpf" style="border:none; background:none; padding-left: 0" maxlength="11" disabled>
        </div>

        <div style="margin-top: 30px; color: black; border-bottom: solid 1px black">
            <h5 style="padding: 5px; margin-top: 5px; margin-bottom: 5px; font-weight: bold">Dados da operação</h5>
        </div>

        <div class="col-md-2">
            <label for="data" style="font-weight: bold" class="form-label">Data</label>
            <input type="date" asp-for="Data" class="form-control" id="Data" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-md-2">
            <label for="orgao" style="font-weight: bold" class="form-label">Orgão</label>
            <select id="orgao" asp-for="Orgao" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.OrgaoEnum>()" style="border:none; background:none; padding-left: 0" disabled>
            </select>
        </div>

        <div class="col-md-2">
            <label for="beneficio" style="font-weight: bold" class="form-label">Benefício</label>
            <select id="beneficio" asp-for="Beneficio" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.BeneficioEnum>()" style="border:none; background:none; padding-left: 0" disabled>
            </select>
        </div>

        <div class="col-md-2">
            <label for="promotora" style="font-weight: bold" class="form-label">Promotora</label>
            <select id="promotora" asp-for="Promotora" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.PromotoraEnum>()" style="border:none; background:none; padding-left: 0" disabled>
            </select>

        </div>

        <div class="col-md-2">
            <label for="banco" style="font-weight: bold" class="form-label">Banco</label>
            <select id="banco" asp-for="Banco" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.BancoEnum>()" style="border:none; background:none; padding-left: 0" disabled>
            </select>
        </div>

        <div class="col-md-2">
            <label for="operacao" style="font-weight: bold" class="form-label">Operação</label>
            <select id="operacao" asp-for="Operacao" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.OperacaoEnum>()" style="border:none; background:none; padding-left: 0" disabled>
            </select>
        </div>

        <div class="col-md-2">
            <label for="Parcela" style="font-weight: bold" class="form-label">Valor</label>
            <div class="input-group">
                <input type="text" class="form-control" id="Parcela" style="border:none; padding-left: 5px; background:none" disabled value="@(Model.Parcela?.ToString("C2"))">
            </div>
        </div>

        <div class="col-md-2">
            <label for="status" style="font-weight: bold" class="form-label">Status da operação</label>
            <select id="status" asp-for="Status" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.StatusEnum>()" style="border:none; background:none; padding-left: 0" disabled>
            </select>

        </div>

        <div class="col-md-2">
            <label for="datapagamento" style="font-weight: bold" class="form-label">Data do pagamento</label>
            <input type="date" asp-for="DataPagamento" class="form-control" id="Datapagamento" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-12">
            <label for="observacoes" style="font-weight: bold" class="form-label">Observações</label>
            <input type="text" asp-for="Observacoes" class="form-control" id="Observacoes" rows="3" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div style="margin-top: 30px; color: black; border-bottom: solid 1px black">
            <h5 style="padding: 5px; margin-top: 5px; margin-bottom: 5px; font-weight: bold">Detalhes da comissão</h5>
        </div>

        <div class="col-md-2">
            <label for="valorcomissao" style="font-weight: bold" class="form-label">Valor comissão</label>
            <div class="input-group">
                <input type="text" class="form-control" id="valorcomissao" style="border:none; padding-left: 5px; background:none" disabled value="@(Model.ValorComissao?.ToString("C2"))">
            </div>
        </div>

        <div class="col-md-2">
            <label for="comissaoStatus" style="font-weight: bold" class="form-label">Status da comissão</label>
            <select id="comissaoStatus" asp-for="ComissaoStatus" class="form-select" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.ComissaoEnum>()" style="border:none; background:none; padding-left: 0" disabled>
            </select>
        </div>

        <div class="col-2">
            <label for="dataComissao" style="font-weight: bold" class="form-label">Pago ao vendedor em</label>
            <input type="date" asp-for="DataComissao" class="form-control" id="dataComissao" rows="3" style="border:none; background:none; padding-left: 0" disabled>
        </div>  

        <div class="col-6">
            <label for="observacao2" style="font-weight: bold" class="form-label">Observações</label>
            <input type="text" asp-for="Observacao2" class="form-control" id="Observacao2" rows="3" style="border:none; background:none; padding-left: 0" disabled>
        </div>
               
        <div style="margin-top: 15px; margin-bottom: 10px">
            <a button style="border-radius: 10px; font-size: 18px; width: 100px" role="button" class="btn btn-outline-secondary" role="button" class="btn btn-outline-dark" asp-controller="Venda" asp-action="Venda">
                <i class="bi bi-arrow-return-left"></i>
                Voltar
            </a>
        </div>
                
    </form>

    <script>
        function voltar() {
            window.history.back();
        }
    </script>


    <script>
        function validarForm() {
            var nomeInput = document.getElementById('nome').value;

            // Verifica se o nome contém um espaço, indicando nome e sobrenome
            if (nomeInput.indexOf(' ') === -1) {
                document.getElementById('nomeError').style.display = 'block'; // Exibe a mensagem de erro
                return false; // Impede o envio do formulário
            } else {
                document.getElementById('nomeError').style.display = 'none'; // Oculta a mensagem de erro
                return true; // Permite o envio do formulário
            }
        }
    </script>

    <script>
        // Obtém a referência para o campo de data
        var campoData = document.getElementById('data');

        // Obtém a data atual
        var dataAtual = new Date();

        // Formata a data para o formato "YYYY-MM-DD", que é o formato esperado pelo campo de data
        var ano = dataAtual.getFullYear();
        var mes = ('0' + (dataAtual.getMonth() + 1)).slice(-2); // Adiciona um zero à esquerda para os meses < 10
        var dia = ('0' + dataAtual.getDate()).slice(-2); // Adiciona um zero à esquerda para os dias < 10

        // Define o valor do campo de data como a data atual
        campoData.value = ano + '-' + mes + '-' + dia;
    </script>

    <script>
        var campoValor = document.getElementById('valor');

        campoValor.addEventListener('input', function (e) {
            // Obtém o valor do campo e remove qualquer formatação de moeda
            var valor = this.value.replace(/\D/g, '');

            // Se o valor não for vazio, converte para número
            if (valor !== "") {
                valor = parseFloat(valor) / 100; // Divide por 100 para considerar os centavos
            }

            // Formata o valor como um valor monetário
            var valorFormatado = valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

            // Define o valor formatado de volta no campo
            this.value = valorFormatado;
        });
    </script>
    
</body>