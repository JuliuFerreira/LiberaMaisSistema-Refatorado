<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - LiberaMais</title>
    <!-- CSS Otimizado (apenas o essencial) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --sidebar-width: 260px;
            --primary-dark: #2c3e50;
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: #f4f7f6;
        }

        /* SIDEBAR */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--primary-dark);
            position: fixed;
            top: 0;
            left: 0;
            color: #fff;
            padding: 20px;
        }

            .sidebar .brand {
                font-weight: bold;
                font-size: 1.4rem;
                margin-bottom: 30px;
                display: block;
                text-align: center;
                color: #fff;
            }

        /* MENU LINKS */
        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #adb5bd;
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.3s;
        }

            .menu-item:hover, .menu-item.active {
                background: #34495e;
                color: #fff;
            }

            .menu-item i {
                margin-right: 15px;
                font-size: 1.2rem;
            }

        /* CONTEÚDO */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 40px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <a href="/" class="brand text-decoration-none">LIBERA<span class="text-danger">MAIS</span></a>

        <div class="d-flex flex-column">
            <a asp-controller="Home" asp-action="Index" class="menu-item"><i class="bi bi-house-door"></i> Dashboard</a>
            <a asp-controller="Venda" asp-action="Index" class="menu-item"><i class="bi bi-file-earmark-text"></i> Vendas</a>
            <a asp-controller="Clientes" asp-action="Index" class="menu-item"><i class="bi bi-people"></i> Clientes</a>
            <a asp-controller="Logins" asp-action="Index" class="menu-item"><i class="bi bi-shield-lock"></i> Logins</a>
        </div>        <nav>
            @await Component.InvokeAsync("Menu")
        </nav>
    </aside>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>