@using System.Globalization
@model IEnumerable<Financa>

@{
    Layout = "LayoutSistema";
}


<div class="container-fluid">

    <div class="justify-content-center align-items-center mb-4 mt-4 mt-5">

        <div class="card-header text-white rounded-top-4"
             style="background-color:dodgerblue;">

            <h3 class="text-center mb-0">
                Financeiro
            </h3>

        </div>

    </div>

    <div class="top-actions">

        <a class="action-card"
           asp-controller="Financa"
           asp-action="AddMesAno">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="35"
                 height="35"
                 fill="currentColor"
                 class="bi bi-calendar3"
                 viewBox="0 0 16 16">

                <path d="M14 0H2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2M1 3.857C1 3.384 1.448 3 2 3h12c.552 0 1 .384 1 .857v10.286c0 .473-.448.857-1 .857H2c-.552 0-1-.384-1-.857z" />
                <path d="M6.5 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m-9 3a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2m3 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2" />

            </svg>

            <p>
                Adicionar <br />
                mês / ano
            </p>

        </a>

        <a class="action-card"
           asp-controller="Venda"
           asp-action="RelatorioVendas">

            <svg xmlns="http://www.w3.org/2000/svg"
                 width="35"
                 height="35"
                 fill="currentColor"
                 class="bi bi-person-lines-fill"
                 viewBox="0 0 16 16">

                <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zM11 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5m.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1zm2 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1zm0 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1z" />

            </svg>

            <p>
                Relatório <br />
                comissão
            </p>

        </a>

    </div>

        <div class="cards-container">

        @foreach (var financa in Model)
        {
            <div class="card financa-card">

                <div class="card-body">

                    <div class="financa-header">

                        <div class="financa-title">
                            @financa.Mesdescription.GetDisplayName() DE @financa.Ano
                        </div>

                        <a href="#"
                           class="btn-delete-financa"
                           data-id="@financa.Id"
                           data-mes="@financa.Mesdescription"
                           data-ano="@financa.Ano"
                           data-url="@Url.Action("Apagar", "Financa", new { id = financa.Id })">

                            <i class="bi bi-trash delete-icon"></i>

                        </a>

                    </div>

                    <div class="saldo-box">

                        <div class="saldo-label">
                            VALOR EM CAIXA
                        </div>

                        <div class="saldo-valor">
                            @financa.SaldoTotal.ToString("C2", new CultureInfo(1046))
                        </div>

                    </div>

                    <div class="d-grid gap-2">

                        <a asp-route-idFinanca="@financa.Id"
                           asp-controller="Receita"
                           asp-action="Index"
                           class="btn btn-outline-success btn-financa">

                            <i class="bi bi-arrow-up-left-square-fill"></i>
                            Receitas

                        </a>

                        <a asp-route-idFinanca="@financa.Id"
                           asp-controller="Despesa"
                           asp-action="Index"
                           class="btn btn-outline-danger btn-financa">

                            <i class="bi bi-arrow-down-right-square-fill"></i>
                            Despesas

                        </a>

                        <a asp-route-id="@financa.Id"
                           asp-controller="Financa"
                           asp-action="FechamentoCaixa"
                           class="btn btn-dark btn-financa">

                            <i class="bi bi-safe2"></i>
                            Fechamento de Caixa

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

    <div class="mt-4">

        <a class="btn btn-outline-secondary btn-voltar"
           asp-controller="Apps"
           asp-action="Index">

            <i class="bi bi-arrow-return-left"></i>
            Voltar

        </a>

    </div>

</div>

<script>

    document.addEventListener('DOMContentLoaded', function () {

        const deleteButtons = document.querySelectorAll('.btn-delete-financa');

        deleteButtons.forEach(button => {

            button.addEventListener('click', function (event) {

                event.preventDefault();

                const url = button.getAttribute('data-url');

                Swal.fire({
                    text: 'Confirma a exclusão?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Excluir',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {

                    if (result.isConfirmed) {

                        fetch(url, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => response.json())
                        .then(data => {

                            if (data.success) {

                                Swal.fire({
                                    title: 'Exclusão efetuada com sucesso!',
                                    text: 'Redirecionando...',
                                    icon: 'success',
                                    showConfirmButton: false,
                                    timer: 3000
                                }).then(() => {

                                    window.location.reload();

                                });

                            } else {

                                Swal.fire({
                                    title: 'Erro!',
                                    text: data.message,
                                    icon: 'error',
                                    confirmButtonText: 'Ok'
                                });

                            }

                        })
                        .catch(error => {

                            Swal.fire({
                                title: 'Erro!',
                                text: 'Ocorreu um erro ao tentar excluir.',
                                icon: 'error',
                                confirmButtonText: 'Ok'
                            });

                        });

                    }

                });

            });

        });

    });

</script>
