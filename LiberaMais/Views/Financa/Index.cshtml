@using System.Globalization
@model IEnumerable<Financa>

@{
    Layout = "LayoutSistema";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 text-uppercase tracking-wide" style="font-size: 1.6rem;">
                Gestão Financeira
            </h2>
            <small class="text-muted">Acompanhe o fluxo de caixa, receitas e despesas mensais do LiberaMais</small>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 btn-adicionar shadow-sm"
               asp-controller="Financa" asp-action="AddMesAno">
                <i class="bi bi-calendar3" style="font-size: 1.1rem;"></i>
                <span class="fw-semibold small">Adicionar Mês/Ano</span>
            </a>
        </div>
    </div>

    <div class="card card-table shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0" id="table-financas-normal" style="width: 100%">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Período / Mês de Referência</th>
                            <th scope="col" class="text-center">Valor em Caixa</th>
                            <th scope="col" class="text-end pe-4">Ações Financeiras</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var financa in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold text-dark text-uppercase" style="letter-spacing: 0.5px;">
                                        @financa.Mesdescription de @financa.Ano
                                    </td>

                                    <td class="text-center fw-bold text-dark">
                                        <span class="badge bg-light text-dark border px-3 py-2 rounded-2" style="font-size: 0.95rem;">
                                            @financa.SaldoTotal.ToString("C2", new CultureInfo(1046))
                                        </span>
                                    </td>

                                    <td class="pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-route-idFinanca="@financa.Id" asp-controller="Receita" asp-action="Index"
                                               class="btn btn-outline-success btn-action-financeiro d-flex align-items-center gap-1 px-2 py-1 small fw-medium" title="Receitas">
                                                <i class="bi bi-arrow-up-left-square-fill"></i> Receitas
                                            </a>

                                            <a asp-route-idFinanca="@financa.Id" asp-controller="Despesa" asp-action="Index"
                                               class="btn btn-outline-danger btn-action-financeiro d-flex align-items-center gap-1 px-2 py-1 small fw-medium" title="Despesas">
                                                <i class="bi bi-arrow-down-right-square-fill"></i> Despesas
                                            </a>

                                            <a asp-route-id="@financa.Id" asp-controller="Financa" asp-action="FechamentoCaixa"
                                               class="btn btn-dark btn-action-financeiro d-flex align-items-center gap-1 px-2 py-1 small fw-medium" title="Fechamento de Caixa">
                                                <i class="bi bi-safe2"></i> Fechamento
                                            </a>

                                            <button type="button" class="btn btn-outline-danger btn-action-sm d-flex align-items-center justify-content-center btn-delete-financa"
                                                    data-id="@financa.Id" data-mes="@financa.Mesdescription" data-ano="@financa.Ano"
                                                    data-url="@Url.Action("Apagar", "Financa", new { id = financa.Id })" title="Excluir Período">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="bi bi-calendar-x mb-2 d-block text-secondary" style="font-size: 2rem;"></i>
                                    Nenhum período financeiro cadastrado.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-medium p-0 btn-back-hover"
           asp-controller="Apps" asp-action="Index">
            <i class="bi bi-arrow-left-short" style="font-size: 1.4rem;"></i> Voltar ao painel
        </a>
    </div>

</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom thead {
            background-color: #f8f9fa;
            border-bottom: 2px solid #efefef;
        }

        .table-custom th {
            font-size: 0.82rem;
            font-weight: 700;
            text-uppercase: true;
            color: #5c636a;
            padding: 14px 10px;
            letter-spacing: 0.5px;
        }

        .table-custom tbody tr {
            border-bottom: 1px solid #f1f3f5;
            transition: background-color 0.15s ease;
        }

            .table-custom tbody tr:hover {
                background-color: #f8f9fa !important;
            }

        .table-custom tbody td {
            padding: 12px 10px;
            font-size: 0.92rem;
            color: #495057;
        }

    .btn-action-financeiro {
        font-size: 0.8rem;
        border-radius: 6px;
        transition: all 0.2s;
    }

    .btn-action-sm {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .btn-adicionar {
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }

    /* Ajustes customizados para o SweetAlert seguir o estilo das suas modais */
    .swal2-popup-custom {
        border-radius: 16px !important;
        font-family: 'Segoe UI', system-ui, sans-serif !important;
        padding: 1.5rem !important;
    }

    .swal2-actions-custom {
        display: flex !important;
        flex-direction: column !important;
        width: 100% !important;
        gap: 6px !important;
        margin-top: 15px !important;
    }

    .swal2-confirm-custom {
        width: 100% !important;
        margin: 0 !important;
        padding: 10px 0 !important;
        font-size: 0.95rem !important;
        font-weight: 500 !important;
        border-radius: 8px !important;
        background-color: #dc3545 !important;
    }

    .swal2-cancel-custom {
        width: 100% !important;
        margin: 0 !important;
        padding: 10px 0 !important;
        font-size: 0.95rem !important;
        font-weight: 500 !important;
        border-radius: 8px !important;
        background-color: #f8f9fa !important;
        color: #6c757d !important;
        border: 1px solid #dee2e6 !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const deleteButtons = document.querySelectorAll('.btn-delete-financa');

        deleteButtons.forEach(button => {
            button.addEventListener('click', function (event) {
                event.preventDefault();

                const id = button.getAttribute('data-id');
                const mes = button.getAttribute('data-mes');
                const ano = button.getAttribute('data-ano');
                const url = button.getAttribute('data-url');

                Swal.fire({
                    title: 'Excluir Período?',
                    html: `Deseja realmente remover o período de <strong class="text-dark">${mes} de ${ano}</strong> do sistema? Esta ação não pode ser desfeita.`,
                    icon: 'overflow', // desativa o layout gigante padrão
                    iconColor: '#dc3545',
                    showCancelButton: true,
                    confirmButtonText: 'Confirmar Exclusão',
                    cancelButtonText: 'Cancelar',
                    reverseButtons: true,
                    customClass: {
                        popup: 'swal2-popup-custom shadow-lg',
                        actions: 'swal2-actions-custom',
                        confirmButton: 'swal2-confirm-custom btn btn-danger',
                        cancelButton: 'swal2-cancel-custom btn btn-light'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(url, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                Swal.fire({
                                    title: 'Sucesso!',
                                    text: 'Período excluído com sucesso.',
                                    icon: 'success',
                                    showConfirmButton: false,
                                    timer: 1500
                                }).then(() => {
                                    window.location.reload();
                                });
                            } else {
                                Swal.fire({
                                    title: 'Erro!',
                                    text: data.message || 'Não foi possível excluir o período.',
                                    icon: 'error',
                                    confirmButtonText: 'Ok',
                                    confirmButtonColor: '#212529'
                                });
                            }
                        })
                        .catch(error => {
                            Swal.fire({
                                title: 'Erro!',
                                text: 'Ocorreu um problema de rede ou no servidor.',
                                icon: 'error',
                                confirmButtonText: 'Ok',
                                confirmButtonColor: '#212529'
                            });
                        });
                    }
                });
            });
        });
    });
</script>