@model Financa

@{
    Layout = "LayoutSistema";
}

<body>
    <form style="border: solid 1px black; padding:10px; border-radius: 10px" id="meuForm" asp-controller="Financa" asp-action="AddMesAno" method="post" class="row g-3">
        <h2 style="text-align:center; margin-top: 50px">ADICIONE O MÊS E O ANO</h2>


        <div class="col-md-3">
            <label for="mes" class="form-label">Mês</label>
            <select id="mes" asp-for="Mes" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.MesEnum>()" class="form-select" required>
                <option value="">Selecione o mês</option>
            </select>
        </div>

        <div class="col-md-3">
            <label for="ano" class="form-label">Ano</label>
            <select id="ano" asp-for="Ano" class="form-select" required>
                @foreach (var ano in ViewBag.Anos)
                {
                    <option value="@ano">@ano</option>
                }
            </select>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-outline-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-floppy2-fill" viewBox="0 0 16 16">
                    <path d="M12 2h-2v3h2z" />
                    <path d="M1.5 0A1.5 1.5 0 0 0 0 1.5v13A1.5 1.5 0 0 0 1.5 16h13a1.5 1.5 0 0 0 1.5-1.5V2.914a1.5 1.5 0 0 0-.44-1.06L14.147.439A1.5 1.5 0 0 0 13.086 0zM4 6a1 1 0 0 1-1-1V1h10v4a1 1 0 0 1-1 1zM3 9h10a1 1 0 0 1 1 1v5H2v-5a1 1 0 0 1 1-1" />
                </svg>
                Gravar
            </button>
            <a role="button" class="btn btn-outline-danger" asp-controller="Financa" asp-action="Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293z" />
                </svg>
                Cancelar
            </a>
        </div>
    </form>

    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
        <script type="text/javascript">
            document.getElementById("meuForm").addEventListener("submit", function (event) {
                event.preventDefault(); // Impede o envio do formulário

                const mes = document.getElementById("mes").value;
                const ano = document.getElementById("ano").value;

                if (mes && ano) {
                    fetch(`/Financa/VerificarDuplicidade?mes=${mes}&ano=${ano}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.exists) {
                                Swal.fire({
                                    title: 'Erro',
                                    text: 'Já existe um registro com esse mês e ano.',
                                    icon: 'error',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    window.location.href = "@Url.Action("AddMesAno", "Financa")";
                                });
                            } else {
                                // Envia o formulário via AJAX se não houver duplicidade
                                $.ajax({
                                    type: "POST",
                                    url: "/Financa/AddMesAno",
                                    data: $("#meuForm").serialize(),
                                    success: function (response) {
                                        if (response.success) {
                                            Swal.fire({
                                                title: 'Mês/ano adicionado com sucesso!',
                                                text: 'Redirecionando...',
                                                icon: 'success',
                                                timer: 3000, // 3 segundos
                                                showConfirmButton: false
                                            }).then(() => {
                                                window.location.href = "@Url.Action("Index", "Financa")";
                                            });
                                        } else {
                                            Swal.fire({
                                                title: 'Erro',
                                                text: response.message,
                                                icon: 'error'
                                            });
                                        }
                                    },
                                    error: function () {
                                        Swal.fire({
                                            title: 'Erro',
                                            text: 'Ops, ocorreu um erro. Tente novamente.',
                                            icon: 'error'
                                        });
                                    }
                                });
                            }
                        })
                        .catch(error => {
                            console.error("Erro ao verificar duplicidade:", error);
                        });
                }
            });
        </script>
    }
</body>

