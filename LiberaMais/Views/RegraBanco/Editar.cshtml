@using LiberaMais.Models
@model RegraBanco

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Editar Regra de Banco";
}

<div class="container-fluid py-4 inner-system-page">

    <!-- CABEÇALHO -->

    <div class="page-header mb-4">

        <div class="d-flex align-items-center gap-3">

            <div class="page-icon">

                <i class="bi bi-pencil-square"></i>

            </div>

            <div>

                <h3 class="fw-bold text-dark mb-1 tracking-tight">
                    Editar Regra de Banco
                </h3>

                <p class="text-muted small mb-0">
                    Atualize as regras específicas para o banco vinculado à promotora.
                </p>

            </div>

        </div>

    </div>



    <!-- CARD PRINCIPAL -->

    <div class="card form-card border-0 shadow-sm rounded-4 bg-white">

        <div class="card-body p-4">


            <!-- IDENTIFICAÇÃO -->

            <div class="section-header mb-4">

                <div class="section-icon">

                    <i class="bi bi-bank2"></i>

                </div>

                <div>

                    <h6 class="fw-bold text-dark mb-0">
                        Identificação
                    </h6>

                    <small class="text-muted">
                        Selecione o banco e a promotora desta regra.
                    </small>

                </div>

            </div>


            <form asp-controller="RegraBanco"
                  asp-action="Editar"
                  method="post">
                                 

                <input type="hidden"
                       asp-for="Id" />


                <div class="row g-4">


                    <!-- BANCO / PROMOTORA -->

                    <div class="col-12 col-md-6">

                        <label asp-for="PromotoraBancoId"
                               class="form-label text-muted fw-bold small text-uppercase">

                            Banco / Promotora

                        </label>

                        <select asp-for="PromotoraBancoId"
                                class="form-select border-light-subtle rounded-3 small py-2">

                            <option value="">
                                Selecione...
                            </option>

                            @foreach (PromotoraBanco promotoraBanco in ViewBag.PromotoraBanco)
                            {
                                <option value="@promotoraBanco.Id">

                                    @promotoraBanco?.Promotora?.Nome -
                                    @promotoraBanco?.Banco?.Nome

                                </option>
                            }

                        </select>

                        <span asp-validation-for="PromotoraBancoId"
                              class="text-danger small mt-1 d-block">
                        </span>

                    </div>



                    <!-- DATA -->

                    <div class="col-12 col-md-6">

                        <label asp-for="DataAtualizacao"
                               class="form-label small fw-bold text-muted text-uppercase">

                            Data de Atualização

                        </label>

                        <input asp-for="DataAtualizacao"
                               type="date"
                               class="form-control rounded-3 py-2" />

                        <span asp-validation-for="DataAtualizacao"
                              class="text-danger small">
                        </span>

                    </div>



                    <!-- DIVISOR -->

                    <div class="col-12">

                        <div class="section-divider">

                            <span>
                                Regras e condições
                            </span>

                        </div>

                    </div>



                    <!-- REGRAS DE VALORES -->

                    <div class="col-6">

                        <label asp-for="RegrasValores"
                               class="form-label text-muted fw-bold small text-uppercase">

                            Regras de Valores

                        </label>

                        <textarea asp-for="RegrasValores"
                                  class="form-control border-light-subtle rounded-3 rule-textarea"
                                  rows="5"
                                  placeholder="Informe as regras de valores, limites, parcelas, valores mínimos e máximos..."></textarea>

                        <span asp-validation-for="RegrasValores"
                              class="text-danger small">
                        </span>

                    </div>



                    <!-- REGRAS DE IDADE -->

                    <div class="col-6">

                        <label asp-for="RegraIdade"
                               class="form-label text-muted fw-bold small text-uppercase">

                            Regras de Idade

                        </label>

                        <textarea asp-for="RegraIdade"
                                  class="form-control border-light-subtle rounded-3 rule-textarea"
                                  rows="5"
                                  placeholder="Informe as regras de idade e prazo máximo..."></textarea>

                        <span asp-validation-for="RegraIdade"
                              class="text-danger small">
                        </span>

                    </div>
                    <div class="col-12 col-lg-4">

                        <label asp-for="BancoRegraGeral"
                               class="form-label text-muted fw-bold small text-uppercase">

                            Regra Geral de Portabilidade

                        </label>

                        <textarea asp-for="BancoRegraGeral"
                                  class="form-control border-light-subtle rounded-3 rule-textarea"
                                  rows="5"
                                  placeholder="Informe a regra geral aplicadapara portar..."></textarea>

                        <span asp-validation-for="BancoRegraGeral"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-12 col-lg-4">

                        <label asp-for="BancoComRegra"
                               class="form-label text-muted fw-bold small text-uppercase">

                            Bancos Com Regra para Portar

                        </label>

                        <textarea asp-for="BancoComRegra"
                                  class="form-control border-light-subtle rounded-3 rule-textarea"
                                  rows="5"
                                  placeholder="Informe os bancos que possuem regras específicas para portabilidade..."></textarea>

                        <span asp-validation-for="BancoComRegra"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-12 col-lg-4">

                        <label asp-for="BancoNaoPortado"
                               class="form-label text-muted fw-bold small text-uppercase">

                            Bancos Não Portados

                        </label>

                        <textarea asp-for="BancoNaoPortado"
                                  class="form-control border-light-subtle rounded-3 rule-textarea"
                                  rows="5"
                                  placeholder="Informe os bancos que não podem ser portados..."></textarea>

                        <span asp-validation-for="BancoNaoPortado"
                              class="text-danger small">
                        </span>

                    </div>


                </div>

                <hr class="my-4 border-light-subtle" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="RegraBanco"
                       asp-action="Index"
                       class="btn btn-light border rounded-3 px-4 py-2">

                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-dark border-0 px-4 py-2 rounded-3 fw-semibold">

                        Salvar Cadastro

                    </button>

                </div>


            </form>

        </div>

    </div>

</div>



<style>

    /* =========================================
           BASE
           ========================================= */

    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }


    .tracking-tight {
        letter-spacing: -0.5px;
    }



    /* =========================================
           CABEÇALHO
           ========================================= */

    .page-header {
        padding-bottom: 20px;
        border-bottom: 1px solid #e9ecef;
    }


    .page-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #f1f3f5;
        color: #343a40;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }



    /* =========================================
           CARD
           ========================================= */

    .form-card {
        background: #fff;
    }



    /* =========================================
           CABEÇALHO DAS SEÇÕES
           ========================================= */

    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #f8f9fa;
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }



    /* =========================================
           DIVISOR
           ========================================= */

    .section-divider {
        display: flex;
        align-items: center;
        gap: 15px;
        color: #6c757d;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }


        .section-divider::before,
        .section-divider::after {
            content: "";
            height: 1px;
            background: #e9ecef;
            flex: 1;
        }



    /* =========================================
           CAMPOS DE REGRAS
           ========================================= */

    .rule-textarea {
        min-height: 110px;
        resize: vertical;
        font-size: 0.9rem;
        line-height: 1.6;
        padding: 12px 14px;
        color: #343a40;
        background-color: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }


        .rule-textarea:focus {
            border-color: #adb5bd;
            box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.05);
        }


        .rule-textarea::placeholder {
            color: #adb5bd;
            font-size: 0.85rem;
        }



    /* =========================================
           SELECT E INPUTS
           ========================================= */

    .form-select:focus,
    .form-control:focus {
        border-color: #adb5bd;
        box-shadow: 0 0 0 0.15rem rgba(0, 0, 0, 0.05);
    }


    .form-label {
        margin-bottom: 7px;
    }



    /* =========================================
           BOTÃO SALVAR
           ========================================= */

    .btn-salvar {
        transition: all 0.2s ease;
    }


        .btn-salvar:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.12);
        }



    /* =========================================
           BOTÃO VOLTAR
           ========================================= */

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }


        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-3px);
        }



    /* =========================================
           RESPONSIVO
           ========================================= */

    @@media (max-width: 768px) {

        .card-body {
            padding: 1.25rem !important;
        }


        .page-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            font-size: 1.1rem;
        }


        .rule-textarea {
            min-height: 120px;
        }


        .section-divider {
            margin-top: 5px;
        }
    }

</style>
