@using LiberaMais.Models.Enums
@model TaxaCoeficiente

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Editar Taxa";
}

<div class="container-fluid py-4 inner-system-page">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Editar Taxa</h2>
            <small class="text-muted">Altere a taxa, o coeficiente e o status da taxa.</small>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="row">
        <div class="col-12">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <form asp-controller="TaxaCoeficiente" asp-action="Editar" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="row g-4">

                            <!-- OPERAÇÃO -->
                            <div class="col-md-4">

                                <label asp-for="Operacao"
                                       class="form-label small fw-bold text-muted">

                                    OPERAÇÃO *

                                </label>

                                <select asp-for="Operacao"
                                        class="form-select rounded-3 py-2"
                                        asp-items="Html.GetEnumSelectList<OperacaoEnum>()"
                                        required>

                                    <option value="">
                                        Selecione a operação
                                    </option>

                                </select>

                                <span asp-validation-for="Operacao"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- TAXA -->
                            <div class="col-md-4">

                                <label asp-for="Taxa" class="form-label small fw-bold text-muted">
                                    TAXA
                                </label>

                                <input asp-for="Taxa"
                                       type="text"
                                       inputmode="decimal"
                                       class="form-control rounded-3 py-2"
                                       value="@Model.Taxa" />

                                <span asp-validation-for="Taxa"
                                      class="text-danger small"></span>

                            </div>

                            <!-- COEFICIENTE -->
                            <div class="col-md-4">

                                <label asp-for="Coeficiente" class="form-label small fw-bold text-muted">
                                    COEFICIENTE
                                </label>

                                <input asp-for="Coeficiente"
                                       type="text"
                                       inputmode="decimal"
                                       class="form-control rounded-3 py-2"
                                       value="@Model.Coeficiente.ToString("0.########", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))" />

                                <span asp-validation-for="Coeficiente"
                                      class="text-danger small"></span>

                            </div>

                            <!-- ATIVO -->
                            <div class="col-md-4">

                                <label asp-for="Ativo" class="form-label small fw-bold text-muted">
                                    STATUS
                                </label>

                                <div class="form-check form-switch mt-2">

                                    <input asp-for="Ativo"
                                           class="form-check-input"
                                           style="width: 3em; height: 1.5em;" />

                                    <label asp-for="Ativo"
                                           class="form-check-label ms-2">
                                        Taxa ativa
                                    </label>

                                </div>

                                <small class="text-muted">
                                    Taxas ativas estarão disponíveis na calculadora.
                                </small>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 rounded-3">
                                Voltar
                            </a>

                            <button type="submit"
                                    class="btn btn-dark px-4 rounded-3 shadow-sm">
                                Salvar Alterações
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

<script>
    window.addEventListener('load', function () {

        setTimeout(function () {

            var alertas = [
                document.getElementById("alertaSucesso"),
                document.getElementById("alertaErro")
            ];

            alertas.forEach(function (alerta) {

                if (alerta) {

                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";

                    setTimeout(function () {
                        alerta.style.display = "none";
                    }, 500);

                }

            });

        }, 3000);

    });
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .form-control {
        border: 1px solid #dee2e6;
    }

        .form-control:focus {
            border-color: #212529;
            box-shadow: 0 0 0 0.2rem rgba(33, 37, 41, 0.1);
        }

    .form-check-input {
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #212529;
            border-color: #212529;
        }
</style>
