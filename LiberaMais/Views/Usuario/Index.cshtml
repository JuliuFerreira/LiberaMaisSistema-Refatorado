@model IEnumerable<UsuarioModel>
@{
    Layout = "LayoutSistema";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 text-uppercase tracking-wide" style="font-size: 1.6rem;">
                Controle de Usuários
            </h2>
            <small class="text-muted">Gerencie as credenciais e permissões de acesso ao LiberaMais</small>
        </div>

        <div>
            <a class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 btn-adicionar shadow-sm" asp-controller="Usuario" asp-action="Criar">
                <i class="bi bi-person-plus-fill" style="font-size: 1.1rem;"></i>
                <span class="fw-semibold small">Adicionar Usuário</span>
            </a>
        </div>
    </div>

    <div class="card card-table shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0" id="table-usuarios-normal" style="width: 100%">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">#</th>
                            <th scope="col">Nome</th>
                            <th scope="col">Login</th>
                            <th scope="col">Email</th>
                            <th scope="col">Perfil</th>
                            <th scope="col" class="text-center">Total de Vendas</th>
                            <th scope="col">Data de Cadastro</th>
                            <th scope="col" class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                var editarUrl = Url.Action("Editar", "Usuario", new { id = user.Id });

                                <tr onclick="location.href='@editarUrl'" style="cursor: pointer;" title="Clique para editar">
                                    <th scope="row" class="ps-4 text-secondary">@user.Id</th>
                                    <td class="fw-bold text-dark">@user.Nome</td>
                                    <td><code class="text-muted bg-light px-2 py-1 rounded small">@user.Login</code></td>
                                    <td>@user.Email</td>
                                    <td>
                                        @if (user.Perfil == LiberaMais.Models.Enums.PerfilEnum.Admin)
                                        {
                                            <span class="badge badge-profile-admin">Administrador</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-profile-user">Padrão</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success fw-bold rounded-pill px-3 py-1">
                                            @(user.Vendas != null && user.Vendas.Any() ? user.Vendas.Count() : 0)
                                        </span>
                                    </td>
                                    <td class="text-muted small">@user.DataCadastro</td>

                                    <td class="pe-4" onclick="event.stopPropagation();">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-outline-danger btn-action-sm d-flex align-items-center justify-content-center"
                                                    data-bs-toggle="modal" data-bs-target="#modalExcluirUsuario_@user.Id" title="Excluir Usuário">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluirUsuario_@user.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
                                        <div class="modal-content modal-custom shadow-lg border-0">
                                            <div class="modal-body text-center p-4">
                                                <div class="modal-icon-container mb-3 text-danger">
                                                    <i class="bi bi-trash3-fill fs-3"></i>
                                                </div>

                                                <h5 class="fw-bold text-dark mb-2">Excluir Usuário?</h5>
                                                <p class="text-muted small mb-4 px-2">
                                                    Deseja realmente remover o usuário <strong class="text-dark">@user.Nome</strong> ("@user.Login") do sistema? Esta ação não poderá ser desfeita.
                                                </p>

                                                <div class="d-flex flex-column gap-2 w-100">
                                                    <form asp-controller="Usuario" asp-action="Apagar" method="post" class="m-0 p-0 w-100">
                                                        <input type="hidden" name="id" value="@user.Id" />
                                                        <button type="submit" class="btn btn-danger w-100 py-2 fw-medium btn-modal-confirm">
                                                            Confirmar Exclusão
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-light w-100 py-2 fw-medium btn-modal-cancel border" data-bs-dismiss="modal">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-people mb-2 d-block text-secondary" style="font-size: 2.2rem;"></i>
                                    Nenhum usuário cadastrado até o momento.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-medium p-0 btn-back-hover" asp-controller="Setup" asp-action="Index">
            <i class="bi bi-arrow-left-short" style="font-size: 1.4rem;"></i> Voltar ao painel
        </a>
    </div>
</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom thead {
            background-color: #f8f9fa;
            border-bottom: 2px solid #efefef;
        }

        .table-custom th {
            font-size: 0.82rem;
            font-weight: 700;
            text-uppercase: true;
            color: #5c636a;
            padding: 14px 10px;
            letter-spacing: 0.5px;
        }

        .table-custom tbody tr {
            border-bottom: 1px solid #f1f3f5;
            transition: background-color 0.15s ease;
        }

            .table-custom tbody tr:hover {
                background-color: #f8f9fa !important;
            }

        .table-custom tbody td, .table-custom tbody th {
            padding: 14px 10px;
            font-size: 0.92rem;
            color: #495057;
        }

    .badge-profile-admin {
        background-color: #212529 !important;
        color: #ffffff !important;
        font-weight: 600;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .badge-profile-user {
        background-color: #e9ecef !important;
        color: #495057 !important;
        font-weight: 600;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
    }

    .btn-action-sm {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .btn-adicionar {
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }

    /* ESTILIZAÇÃO DA MODAL PREMIUM MINIMALISTA */
    .modal-custom {
        border-radius: 16px !important;
        overflow: hidden;
    }

    .modal-icon-container {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        background-color: #ffebee;
        border-radius: 50%;
    }

    .btn-modal-confirm {
        font-size: 0.9rem !important;
        border-radius: 8px !important;
        background-color: #dc3545 !important;
        border: none !important;
    }

    .btn-modal-cancel {
        font-size: 0.9rem !important;
        border-radius: 8px !important;
        background-color: #f8f9fa !important;
        color: #6c757d !important;
    }
</style>