@using LiberaMais.Models.Enums
@model UsuarioModel

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Adicionar Usuário";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Adicionar Usuário</h2>
            <small class="text-muted">Cadastre credenciais e defina o perfil de acesso à plataforma</small>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="card card-table shadow-sm border-0 mb-3">
        <div class="card-body p-4">
            <form id="usuarioForm" asp-controller="Usuario" asp-action="Criar" method="post" onsubmit="return validarForm();">

                <div class="row g-3">
                    <div class="col-12 col-md-3">
                        <label asp-for="Nome" class="form-label fw-semibold text-dark small">Nome Completo</label>
                        <input type="text" asp-for="Nome" class="form-control form-control-custom" id="nome" placeholder="NOME DO USUÁRIO" required />
                        <span asp-validation-for="Nome" class="text-danger small mt-1 d-block" id="nomeError"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark small">E-mail</label>
                        <input type="email" asp-for="Email" class="form-control form-control-custom" id="email" placeholder="exemplo@email.com" required />
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>  

                    <div class="col-12 col-md-2">
                        <label asp-for="Perfil" class="form-label fw-semibold text-dark small">Perfil de Permissão</label>
                        <select asp-for="Perfil" class="form-select form-control-custom" required>
                            <option value="">Selecione um perfil...</option>
                            <option value="@PerfilEnum.Admin">Administrador</option>
                            <option value="@PerfilEnum.Padrao">Padrão</option>
                        </select>
                        <span asp-validation-for="Perfil" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-2">
                        <label asp-for="Login" class="form-label fw-semibold text-dark small">Login de Acesso</label>
                        <input type="text" asp-for="Login" class="form-control form-control-custom font-monospace" id="login" placeholder="usuario.login" required />
                        <span asp-validation-for="Login" class="text-danger small mt-1 d-block"></span>
                    </div>
                    <div class="col-12 col-md-2">
                        <label asp-for="Senha" class="form-label fw-semibold text-dark small">Senha Provisória</label>
                        <input type="password" asp-for="Senha" class="form-control form-control-custom" placeholder="••••••••" required />
                        <span asp-validation-for="Senha" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <hr class="my-4 opacity-50" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-medium rounded-2 small">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-sm btn-dark px-4 py-2 fw-semibold rounded-2 small shadow-sm">
                        Salvar Usuário
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div>
        <a asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1 small btn-back-hover">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

</div>

<script>
    // Validação nativa de Nome e Sobrenome
    function validarForm() {
        var nomeInput = document.getElementById('nome').value;
        var errorSpan = document.getElementById('nomeError');

        if (nomeInput.trim().indexOf(' ') === -1) {
            errorSpan.textContent = "Por favor, insira o nome completo (Nome e Sobrenome).";
            errorSpan.style.display = 'block';
            return false;
        } else {
            errorSpan.style.display = 'none';
            return true;
        }
    }

    // // Caixa alta em tempo real para o Nome e Fade-out dos alertas
    // window.addEventListener('load', function() {
    //     var inputNome = document.getElementById('nome');
    //     if(inputNome) {
    //         inputNome.addEventListener('input', function () {
    //             this.value = this.value.toUpperCase();
    //         });
    //     }

        setTimeout(function() {
            var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
            alertas.forEach(function(alerta) {
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(function() { alerta.style.display = "none"; }, 500);
                }
            });
        }, 3000);
    });
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.05);
        background-color: #ffffff;
    }

    .form-control-custom {
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 0.9rem;
        border: 1px solid #dee2e6;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #212529;
            box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.1);
            outline: 0;
        }

    .btn-back-hover {
        transition: color 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
        }
</style>
