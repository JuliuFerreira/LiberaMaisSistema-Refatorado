@using LiberaMais.Models.Enums
@using System.Globalization
@model List<LiberaMais.Models.ComissaoRelatorioViewModel>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Relatório de Comissões";

    int mesFechamento = ViewBag.MesFechamento ?? DateTime.Today.Month;
    int anoFechamento = ViewBag.AnoFechamento ?? DateTime.Today.Year;

    string nomeUsuarioSelecionado = "Todos os Usuários";

    if (ViewBag.Usuarios != null && ViewBag.UsuarioAtual != null)
    {
        foreach (var user in ViewBag.Usuarios)
        {
            if (user.Id == ViewBag.UsuarioAtual)
            {
                nomeUsuarioSelecionado = user.Nome;
                break;
            }
        }
    }

    var cultura = CultureInfo.GetCultureInfo("pt-BR");

    string nomeMesAtual;

    if (mesFechamento == 0)
    {
        nomeMesAtual = "Todos os períodos";
    }
    else
    {
        nomeMesAtual = cultura.DateTimeFormat.GetMonthName(mesFechamento);
        nomeMesAtual = char.ToUpper(nomeMesAtual[0]) + nomeMesAtual.Substring(1);
    }
}


@* ============================================================
   ALERTA DE SUCESSO
   ============================================================ *@

@if (TempData["MensagemSucesso"] != null)
{
    <div id="alertaSucesso"
         class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["MensagemSucesso"]

    </div>
}


@* ============================================================
   ALERTA DE ERRO
   ============================================================ *@

@if (TempData["MensagemErro"] != null)
{
    <div id="alertaErro"
         class="alert alert-danger alert-dismissible fade show"
         role="alert">

        @TempData["MensagemErro"]

    </div>
}


<div class="inner-system-page">

    @* ============================================================
       CABEÇALHO
       ============================================================ *@

    <div>

        <span class="text-uppercase fw-bold text-secondary font-monospace tracking-wider"
              style="font-size: 0.75rem;">

            Módulo Financeiro

        </span>


        <h2 class="fw-bold text-dark mb-1 tracking-tight">

            Relatório de Comissões

        </h2>


        <p class="text-muted small mb-3">

            Competência atual:

            <strong class="text-dark">

                @nomeMesAtual

                @if (mesFechamento != 0)
                {
                    <span>/@anoFechamento</span>
                }

            </strong>

            |

            Operador:

            <strong class="text-dark">

                @nomeUsuarioSelecionado

            </strong>

        </p>


        @* ========================================================
           FILTROS
           ======================================================== *@

        <form method="get"
              asp-controller="Comissao"
              asp-action="Relatorio"
              class="row g-2 align-items-center">


            


            @* ====================================================
               MÊS
               ==================================================== *@

            <div class="col-auto">

                <select name="mesFechamento"
                        class="form-select form-select-sm filter-dropdown"
                        style="min-width: 160px;">

                    @if (mesFechamento == 0)
                    {
                        <option value="0" selected>
                            Todos os períodos
                        </option>
                    }
                    else
                    {
                        <option value="0">
                            Todos os períodos
                        </option>
                    }


                    @for (int mes = 1; mes <= 12; mes++)
                    {
                        string nomeMes =
                        cultura.DateTimeFormat.GetMonthName(mes);

                        nomeMes =
                        char.ToUpper(nomeMes[0])
                        + nomeMes.Substring(1);

                        if (mes == mesFechamento)
                        {
                            <option value="@mes" selected>
                                @nomeMes
                            </option>
                        }
                        else
                        {
                            <option value="@mes">
                                @nomeMes
                            </option>
                        }
                    }

                </select>

            </div>

            @* ====================================================
               ANO
               ==================================================== *@

            <div class="col-auto">

                <select name="anoFechamento"
                        class="form-select form-select-sm filter-dropdown"
                        style="min-width: 110px;"
                        @(mesFechamento == 0 ? "disabled" : "")>

                    @for (int ano = DateTime.Today.Year - 2;
                                        ano <= DateTime.Today.Year + 1;
                                        ano++)
                    {
                        if (ano == anoFechamento)
                        {
                            <option value="@ano" selected>
                                @ano
                            </option>
                        }
                        else
                        {
                            <option value="@ano">
                                @ano
                            </option>
                        }
                    }

                </select>

            </div>


            @* ====================================================
               USUÁRIO
               ==================================================== *@

            <div class="col-auto">

                <select name="usuarioId"
                        class="form-select form-select-sm filter-dropdown"
                        style="min-width: 180px;">

                    <option value="">
                        Todos os Usuários
                    </option>


                    @if (ViewBag.Usuarios != null)
                    {
                        foreach (var user in ViewBag.Usuarios)
                        {
                            if (ViewBag.UsuarioAtual == user.Id)
                            {
                                <option value="@user.Id" selected>
                                    @user.Nome
                                </option>
                            }
                            else
                            {
                                <option value="@user.Id">
                                    @user.Nome
                                </option>
                            }
                        }
                    }

                </select>

            </div>


            @* ====================================================
               STATUS
               ==================================================== *@

            <div class="col-auto">

                <select name="filtroStatus"
                        class="form-select form-select-sm filter-dropdown">

                    <option value="">
                        Todos os Status
                    </option>


                    @if (ViewBag.FiltroAtual == "Paga")
                    {
                        <option value="Paga" selected>
                            Paga
                        </option>
                    }
                    else
                    {
                        <option value="Paga">
                            Paga
                        </option>
                    }


                    @if (ViewBag.FiltroAtual == "Em Atraso")
                    {
                        <option value="Em Atraso" selected>
                            Em Atraso
                        </option>
                    }
                    else
                    {
                        <option value="Em Atraso">
                            Em Atraso
                        </option>
                    }


                    @if (ViewBag.FiltroAtual == "Aguardando Recebimento")
                    {
                        <option value="Aguardando Recebimento" selected>
                            Aguardando Recebimento
                        </option>
                    }
                    else
                    {
                        <option value="Aguardando Recebimento">
                            Aguardando Recebimento
                        </option>
                    }

                </select>

            </div>


            @* ====================================================
               BOTÃO FILTRAR
               ==================================================== *@

            <div class="col-auto">

                <button type="submit"
                        class="btn btn-sm btn-dark px-3 btn-filter-submit">

                    <i class="bi bi-funnel me-1"></i>

                    Filtrar

                </button>

            </div>

        </form>

    </div>


    @* ============================================================
       RESUMO FINANCEIRO
       ============================================================ *@

    <div class="row g-3 mt-3">


        @* ========================================================
           COMISSÕES PAGAS
           ======================================================== *@

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <div class="text-muted small fw-semibold mb-2">

                                COMISSÕES PAGAS

                            </div>

                            <div class="fs-3 fw-bold text-dark">

                                @ViewBag.TotalComissoesPagas

                            </div>

                            <div class="text-muted small mt-1">

                                @if (mesFechamento == 0)
                                {
                                    <span>Todo o período</span>
                                }
                                else
                                {
                                    <span>
                                        @nomeMesAtual / @anoFechamento
                                    </span>
                                }

                            </div>

                        </div>


                        <div class="resumo-icon resumo-icon-blue">

                            <i class="bi bi-check-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        @* ========================================================
           VALOR TOTAL PAGO
           ======================================================== *@

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <div class="text-muted small fw-semibold mb-2">

                                VALOR TOTAL PAGO

                            </div>

                            <div class="fs-3 fw-bold text-success">

                                @(((decimal)(ViewBag.TotalValorComissoesPagas ?? 0m)).ToString("C2"))

                            </div>

                            <div class="text-muted small mt-1">

                                Comissões efetivamente pagas

                            </div>

                        </div>


                        <div class="resumo-icon resumo-icon-green">

                            <i class="bi bi-cash-stack"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        @* ========================================================
           VALOR VENDIDO
           ======================================================== *@

        <div class="col-md-4">

            <div class="card border-0 shadow-sm rounded-4 h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <div class="text-muted small fw-semibold mb-2">

                                VALOR VENDIDO

                            </div>

                            <div class="fs-3 fw-bold text-dark">

                                @(((decimal)(ViewBag.TotalValorVendido ?? 0m)).ToString("C2"))

                            </div>

                            <div class="text-muted small mt-1">

                                Valor dos contratos

                            </div>

                        </div>


                        <div class="resumo-icon resumo-icon-purple">

                            <i class="bi bi-graph-up-arrow"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    @* ============================================================
       GRÁFICO
       ============================================================ *@

    <div class="card border-0 shadow-sm rounded-4 mt-3">

        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <div>

                    <h5 class="fw-bold text-dark mb-1">

                        Comissões pagas por mês

                    </h5>

                    <p class="text-muted small mb-0">

                        Visualização das comissões efetivamente pagas

                    </p>

                </div>


                <div class="text-muted small">

                    <i class="bi bi-calendar3 me-1"></i>

                    @if (mesFechamento == 0)
                    {
                        <span>Todos os períodos</span>
                    }
                    else
                    {
                        <span>
                            @nomeMesAtual / @anoFechamento
                        </span>
                    }

                </div>

            </div>


            @{
                var dadosGrafico =
                ViewBag.ComissoesPorMes as IEnumerable<dynamic>;
            }


            @if (dadosGrafico != null && dadosGrafico.Any())
            {
                var maiorValor =
                dadosGrafico.Max(x => (decimal)x.Total);


                <div class="grafico-container">

                    @foreach (var item in dadosGrafico)
                    {
                        var percentual =
                        maiorValor > 0
                        ? ((decimal)item.Total / maiorValor) * 100
                        : 0;


                        string nomeMesGrafico =
                        cultura.DateTimeFormat
                        .GetAbbreviatedMonthName((int)item.Mes);

                        nomeMesGrafico =
                        char.ToUpper(nomeMesGrafico[0])
                        + nomeMesGrafico.Substring(1);


                        <div class="grafico-coluna">

                            <div class="grafico-valor">

                                @(((decimal)item.Total).ToString("C0"))

                            </div>


                            <div class="grafico-barra-area">

                                <div class="grafico-barra"
                                     style="height: @percentual%;"
                                     title="@nomeMesGrafico/@item.Ano - @(((decimal)item.Total).ToString("C2")) - @item.Quantidade comissões">
                                </div>

                            </div>


                            <div class="grafico-mes">

                                @nomeMesGrafico

                            </div>


                            <div class="grafico-quantidade">

                                @item.Quantidade

                            </div>

                        </div>
                    }

                </div>


                <div class="text-center text-muted small mt-3">

                    <i class="bi bi-info-circle me-1"></i>

                    Passe o mouse sobre uma barra para visualizar os detalhes.

                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">

                    <i class="bi bi-bar-chart-line fs-2 d-block mb-2"></i>

                    Nenhuma comissão paga encontrada para este período.

                </div>
            }

        </div>

    </div>


    @* ============================================================
       TABELA
       ============================================================ *@

    <div class="col-lg-12 mt-4">

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">

            <div class="table-responsive">

                <table class="table align-middle mb-0 text-nowrap">

                    <thead class="bg-table-header">

                        <tr>

                            <th scope="col"
                                class="text-center"
                                style="width: 70px;">

                                <i class="bi bi-check2-square"></i>

                            </th>


                            <th scope="col"
                                class="ps-4">

                                Número

                            </th>


                            <th scope="col"
                                class="ps-4">

                                Beneficiário

                            </th>


                            <th scope="col">

                                Operação / Banco

                            </th>


                            <th scope="col">

                                Usuário

                            </th>


                            <th scope="col">

                                Operação / Valor Contrato

                            </th>


                            <th scope="col"
                                class="text-end pe-4">

                                Valor Comissão / Status

                            </th>


                            <th scope="col"
                                class="text-end pe-4">

                                Data Pgto Comissão

                            </th>


                            <th scope="col"
                                class="text-end">

                                Valor Repasse

                            </th>


                            <th scope="col">

                                Status Repasse

                            </th>


                            <th scope="col">

                                Data Repasse

                            </th>


                            <th scope="col">

                                Ação

                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                bool usuarioPadrao =
                                item.Venda.Usuario?.Perfil ==
                                PerfilEnum.Padrao;


                                <tr class="financas-row">


                                    @* CHECKBOX *@

                                    <td class="text-center">

                                        @if (usuarioPadrao &&
                                                                        item.Venda.ValorRepasse.HasValue &&
                                                                        item.Venda.RepasseComissao !=
                                                                        StatusRepasseComissaoEnum.Pago)
                                        {
                                            <input type="checkbox"
                                                   class="form-check-input repasse-checkbox"
                                                   value="@item.Venda.Id"
                                                   data-contrato="@item.Venda.ValorComissao?.ToString(CultureInfo.InvariantCulture)"
                                                   data-repasse="@item.Venda.ValorRepasse.Value.ToString(CultureInfo.InvariantCulture)" />
                                        }
                                        else if (usuarioPadrao &&
                                        item.Venda.RepasseComissao ==
                                        StatusRepasseComissaoEnum.Pago)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"
                                               title="Repasse já efetivado"></i>
                                        }

                                    </td>


                                    @* NÚMERO *@

                                    <td class="ps-4">

                                        <div class="fw-bold text-dark mb-0 text-truncate"
                                             style="max-width: 200px;">

                                            @item.Venda.Id

                                        </div>

                                    </td>


                                    @* BENEFICIÁRIO *@

                                    <td class="ps-4">

                                        <div class="fw-bold text-dark mb-0 text-truncate"
                                             style="max-width: 200px;">

                                            @item.Venda.Cliente?.Nome

                                        </div>


                                        <small class="text-muted font-monospace"
                                               style="font-size: 0.75rem;">

                                            @item.Venda.Cliente?.Cpf

                                        </small>

                                    </td>


                                    @* OPERAÇÃO / BANCO *@

                                    <td>

                                        <div class="small fw-medium text-secondary">

                                            @item.Venda.Promotora?.Nome

                                        </div>


                                        <span class="badge bg-light text-dark border-0 px-2 py-1"
                                              style="font-size: 0.7rem;">

                                            @item.Venda.Banco?.Nome

                                        </span>

                                    </td>


                                    @* USUÁRIO *@

                                    <td>

                                        @item.Venda.Usuario?.Nome

                                    </td>


                                    @* OPERAÇÃO / VALOR *@

                                    <td class="ps-4">

                                        <div class="small fw-medium text-secondary">

                                            @item.Venda.Operacao.GetDisplayName()

                                        </div>

                                        <span class="text-muted font-monospace"
                                              style="font-size: 0.75rem;">

                                            @item.Venda.ValorContrato?.ToString("C2")

                                            @item.Venda.SaldoDevedor?.ToString("C2")

                                        </span>

                                    </td>


                                    @* COMISSÃO / STATUS *@

                                    <td class="ps-4">

                                        <div class="fw-bold text-dark mb-0 text-truncate"
                                             style="max-width: 200px;">

                                            @item.Venda.ValorComissao?.ToString("C2")

                                        </div>


                                        <small class="text-muted font-monospace"
                                               style="font-size: 0.75rem;">

                                            @if (item.StatusFinanceiro == "Paga")
                                            {
                                                <span class="status-dot status-paga">
                                                    Paga
                                                </span>
                                            }
                                            else if (item.StatusFinanceiro == "Em Atraso")
                                            {
                                                <span class="status-dot status-atraso">
                                                    Atraso
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-dot status-aguardando">
                                                    Aguardando
                                                </span>
                                            }

                                        </small>

                                    </td>


                                    @* DATA PAGAMENTO COMISSÃO *@

                                    <td class="font-monospace text-secondary small">

                                        @item.Venda.DataPgtoComissao?.ToString("dd/MM/yyyy")

                                    </td>


                                    @* REPASSE *@

                                    @if (usuarioPadrao)
                                    {

                                        <td class="text-end fw-bold font-monospace text-dark">

                                            @if (item.Venda.ValorRepasse.HasValue)
                                            {
                                                @item.Venda.ValorRepasse.Value.ToString("C2")
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    -
                                                </span>
                                            }

                                        </td>


                                        @* STATUS REPASSE *@

                                        <td>

                                            @if (item.Venda.RepasseComissao ==
                                                                            StatusRepasseComissaoEnum.Pago)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">

                                                    <i class="bi bi-check-circle-fill me-1"></i>

                                                    Pago

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">

                                                    <i class="bi bi-clock me-1"></i>

                                                    Aberto

                                                </span>
                                            }

                                        </td>


                                        @* DATA REPASSE *@

                                        <td class="font-monospace text-secondary small">

                                            @item.Venda.DataRepasse?.ToString("dd/MM/yyyy")

                                        </td>


                                        @* AÇÃO *@

                                        <td>

                                            @if (item.Venda.RepasseComissao ==
                                                                            StatusRepasseComissaoEnum.Pago)
                                            {
                                                <a asp-controller="Comissao"
                                                   asp-action="RegistrarRepasse"
                                                   asp-route-vendaId="@item.Venda.Id"
                                                   class="btn btn-outline-success btn-sm px-3 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold">

                                                    <i class="bi bi-pencil-square"></i>

                                                    Editar Repasse

                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Comissao"
                                                   asp-action="RegistrarRepasse"
                                                   asp-route-vendaId="@item.Venda.Id"
                                                   class="btn btn-success btn-sm px-3 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2 fw-semibold">

                                                    <i class="bi bi-cash-coin"></i>

                                                    Registrar Repasse

                                                </a>
                                            }

                                        </td>

                                    }
                                    else
                                    {

                                        <td colspan="4"></td>

                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="11"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-receipt mb-2 d-block text-secondary"
                                       style="font-size: 1.8rem;"></i>

                                    Nenhum registro encontrado para este filtro.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    @* ============================================================
       RESUMO DOS CONTRATOS SELECIONADOS
       ============================================================ *@

    <div id="resumoRepasses"
         class="card border-0 shadow-sm rounded-4 mt-4">

        <div class="card-body">

            <div class="row g-4 align-items-center">

                <div class="col-md-4">

                    <div class="text-muted small mb-1">

                        Contratos selecionados

                    </div>

                    <div class="fs-4 fw-bold text-dark">

                        <span id="quantidadeSelecionados">
                            0
                        </span>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <div class="d-flex justify-content-end">

                <button type="button"
                        id="btnGerarRelatorio"
                        class="btn btn-primary px-4 rounded-3"
                        disabled>

                    <i class="bi bi-file-earmark-text me-2"></i>

                    Gerar relatório de pagamento

                </button>

            </div>

        </div>

    </div>


    @* ============================================================
       VOLTAR AO PAINEL
       ============================================================ *@

    <div class="mt-4">

        <a asp-controller="Apps"
           asp-action="Index"
           class="btn btn-link text-decoration-none text-secondary p-0 d-inline-flex align-items-center gap-2 btn-back-hover">

            <i class="bi bi-arrow-left-short fs-4"></i>

            <span class="fw-medium small">

                Voltar ao Painel

            </span>

        </a>

    </div>

</div>


<style>

    /* =========================================================
           PÁGINA
           ========================================================= */

    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }


    .tracking-tight {
        letter-spacing: -0.5px;
    }


    .tracking-wider {
        letter-spacing: 0.8px;
    }


    /* =========================================================
           FILTROS
           ========================================================= */

    .filter-dropdown {
        border-color: #dee2e6 !important;
        border-radius: 6px;
        color: #495057;
        font-size: 0.85rem !important;
        height: 34px;
        background-color: #ffffff;
    }


        .filter-dropdown:focus {
            border-color: #212529 !important;
            box-shadow: 0 0 0 0.2rem rgba(33, 37, 41, 0.04) !important;
        }


        .filter-dropdown:disabled {
            background-color: #f8f9fa;
            color: #adb5bd;
            cursor: not-allowed;
        }


    .btn-filter-submit {
        height: 34px;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 6px;
    }


    /* =========================================================
           CARDS RESUMO
           ========================================================= */

    .resumo-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }


    .resumo-icon-blue {
        background-color: #eef4ff;
        color: #3b82f6;
    }


    .resumo-icon-green {
        background-color: #ecfdf3;
        color: #198754;
    }


    .resumo-icon-purple {
        background-color: #f4f0ff;
        color: #7c3aed;
    }


    /* =========================================================
           GRÁFICO
           ========================================================= */

    .grafico-container {
        height: 230px;
        max-width: 850px;
        margin: 0 auto;
