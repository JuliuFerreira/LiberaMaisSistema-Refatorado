@model List<LiberaMais.Models.ComissaoRelatorioViewModel>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Relatório de Comissões";

    int mesFechamento = ViewBag.MesFechamento ?? DateTime.Today.Month;
    int anoFechamento = ViewBag.AnoFechamento ?? DateTime.Today.Year;
    decimal totalSalarioMes = ViewBag.TotalSalarioMes ?? 0m;
    int quantidadePagaMes = ViewBag.QuantidadePagaMes ?? 0;

    // Captura o nome do usuário selecionado para o cabeçalho dinâmico
    string nomeUsuarioSelecionado = "Todos os Usuários";
    if (ViewBag.Usuarios != null && ViewBag.UsuarioAtual != null)
    {
        foreach (var user in ViewBag.Usuarios)
        {
            if (user.Id == ViewBag.UsuarioAtual)
            {
                nomeUsuarioSelecionado = user.Nome;
                break;
            }
        }
    }
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="text-uppercase fw-bold text-secondary font-monospace tracking-wider" style="font-size: 0.75rem;">Módulo Financeiro</span>
            <h2 class="fw-bold text-dark mb-1 tracking-tight">Relatório de Comissões</h2>
            <p class="text-muted small mb-0">Competência atual: <strong class="text-dark">@ViewBag.MesFechamento/@ViewBag.AnoFechamento</strong> | Operador: <strong class="text-dark">@nomeUsuarioSelecionado</strong></p>
        </div>

        <div>
            <form method="get" asp-controller="Comissao" asp-action="Relatorio" class="row g-2 align-items-center mb-0">
                <input type="hidden" name="mesFechamento" value="@mesFechamento" />
                <input type="hidden" name="anoFechamento" value="@anoFechamento" />

                <div class="col-auto">
                    <select name="usuarioId" class="form-select form-select-sm filter-dropdown" style="min-width: 180px;">
                        <option value="">Todos os Usuários</option>
                        @if (ViewBag.Usuarios != null)
                        {
                            foreach (var user in ViewBag.Usuarios)
                            {
                                <!option value="@user.Id" @(ViewBag.UsuarioAtual == user.Id ? "selected" : "")>@user.Nome</!option>
                            }
                        }
                    </select>
                </div>

                <div class="col-auto">
                    <select name="filtroStatus" class="form-select form-select-sm filter-dropdown">
                        <option value="">Todos os Status</option>
                        <!option value="Paga" @(ViewBag.FiltroAtual == "Paga" ? "selected" : "")>Paga</!option>
                        <!option value="Em Atraso" @(ViewBag.FiltroAtual == "Em Atraso" ? "selected" : "")>Em Atraso</!option>
                        <!option value="Aguardando Recebimento" @(ViewBag.FiltroAtual == "Aguardando Recebimento" ? "selected" : "")>Aguardando Recebimento</!option>
                    </select>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-dark px-3 btn-filter-submit">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4 align-items-start">

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 text-nowrap">
                        <thead class="bg-table-header">
                            <tr>
                                <th scope="col" class="ps-4">Beneficiário</th>
                                <th scope="col">Operação / Banco</th>
                                <th scope="col">Usuário</th>
                                <th scope="col">Status</th>
                                <th scope="col">Data Pgto</th>
                                <th scope="col" class="text-end pe-4">Valor Comissão</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr class="financas-row">
                                        <td class="ps-4">
                                            <div class="fw-bold text-dark mb-0 text-truncate" style="max-width: 200px;">@item.Venda.Cliente?.Nome</div>
                                            <small class="text-muted font-monospace" style="font-size: 0.75rem;">@item.Venda.Cliente?.Cpf</small>
                                        </td>
                                        <td>
                                            <div class="small fw-medium text-secondary">@item.Venda.Promotora?.Nome</div>
                                            <span class="badge bg-light text-dark border-0 px-2 py-0.5" style="font-size: 0.7rem;">@item.Venda.Banco?.Nome</span>
                                        </td>                                        
                                        <td>
                                            @item.Venda.Usuario.Nome
                                        </td>
                                        <td>
                                            @if (item.StatusFinanceiro == "Paga")
                                            {
                                                <span class="status-dot status-paga">Paga</span>
                                            }
                                            else if (item.StatusFinanceiro == "Em Atraso")
                                            {
                                                <span class="status-dot status-atraso">Atraso</span>
                                            }
                                            else
                                            {
                                                <span class="status-dot status-aguardando">Aguardando</span>
                                            }
                                        </td>
                                        <td class="font-monospace text-secondary small">
                                            @item.Venda.DataPgtoComissao?.ToString("dd/MM/yyyy")
                                        </td>
                                        <td class="text-end pe-4 fw-bold font-monospace text-dark">
                                            @item.Venda.ValorComissao?.ToString("C2")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-receipt mb-2 d-block text-secondary" style="font-size: 1.8rem;"></i>
                                        Nenhum registro encontrado para este filtro.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom border-light-subtle">
                    <i class="bi bi-calculator text-dark fs-5"></i>
                    <h5 class="fw-bold text-dark mb-0">Acerto de Comissão</h5>
                </div>

                <form asp-controller="Comissao" asp-action="Relatorio" method="get" class="mb-4">
                    <input type="hidden" name="usuarioId" value="@ViewBag.UsuarioAtual" />
                    <input type="hidden" name="filtroStatus" value="@ViewBag.FiltroAtual" />

                    <div class="row g-2 mb-2">
                        <div class="col-7">
                            <label class="form-label text-muted small fw-medium mb-1">Mês de Referência</label>
                            <select name="mesFechamento" class="form-select form-select-sm filter-dropdown">
                                <!option value="1" @(mesFechamento == 1 ? "selected" : "")>Janeiro</!option>
                                <!option value="2" @(mesFechamento == 2 ? "selected" : "")>Fevereiro</!option>
                                <!option value="3" @(mesFechamento == 3 ? "selected" : "")>Março</!option>
                                <!option value="4" @(mesFechamento == 4 ? "selected" : "")>Abril</!option>
                                <!option value="5" @(mesFechamento == 5 ? "selected" : "")>Maio</!option>
                                <!option value="6" @(mesFechamento == 6 ? "selected" : "")>Junho</!option>
                                <!option value="7" @(mesFechamento == 7 ? "selected" : "")>Julho</!option>
                                <!option value="8" @(mesFechamento == 8 ? "selected" : "")>Agosto</!option>
                                <!option value="9" @(mesFechamento == 9 ? "selected" : "")>Setembro</!option>
                                <!option value="10" @(mesFechamento == 10 ? "selected" : "")>Outubro</!option>
                                <!option value="11" @(mesFechamento == 11 ? "selected" : "")>Novembro</!option>
                                <!option value="12" @(mesFechamento == 12 ? "selected" : "")>Dezembro</!option>
                            </select>
                        </div>
                        <div class="col-5">
                            <label class="form-label text-muted small fw-medium mb-1">Ano</label>
                            <select name="anoFechamento" class="form-select form-select-sm filter-dropdown">
                                @for (int i = DateTime.Today.Year - 2; i <= DateTime.Today.Year + 1; i++)
                                {
                                    <!option value="@i" @(anoFechamento == i ? "selected" : "")>@i</!option>
                                }
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sm btn-outline-dark w-100 rounded-3 py-1.5 fw-semibold mb-3">
                        <i class="bi bi-arrow-clockwise me-1"></i> Atualizar Mês
                    </button>
                </form>

                <div class="mb-4">
                    <label class="form-label text-dark small fw-bold mb-1">Porcentagem do Repasse</label>
                    <select id="selectPorcentagem" class="form-select form-select-sm filter-dropdown" style="border-color: #212529 !important;">
                        <option value="0" selected>0% da Comissão</option>
                        <option value="10">10% da Comissão</option>
                        <option value="20">20% da Comissão</option>
                        <option value="30">30% da Comissão</option>
                        <option value="40">40% da Comissão</option>
                        <option value="50">50% da Comissão</option>
                        <option value="60">60% da Comissão</option>
                        <option value="70">70% da Comissão</option>
                        <option value="80">80% da Comissão</option>
                        <option value="90">90% da Comissão</option>
                        <option value="100">100% da Comissão</option>


                    </select>
                </div>

                <div class="p-3 bg-light rounded-3 border border-light-subtle d-flex flex-column gap-3">
                    <div>
                        <small class="text-uppercase fw-bold text-muted d-block font-monospace mb-0" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                            Comissões recebidas
                        </small>
                        <h4 class="fw-bold text-dark font-monospace mb-0">@totalSalarioMes.ToString("C2")</h4>
                    </div>

                    <div class="border-top border-light-subtle pt-2">
                        <small class="text-uppercase fw-bold text-primary d-block font-monospace mb-0" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                            Repasse Devido (<span id="txtPorcentagemLabel">50%</span>) para <span class="text-dark">@nomeUsuarioSelecionado</span>
                        </small>
                        <h3 class="fw-bold text-success font-monospace mb-0" id="txtValorRepasse">R$ 0,00</h3>
                    </div>

                    <div class="d-flex justify-content-between align-items-center border-top border-light-subtle pt-2">
                        <span class="text-muted small">Qtd. Contratos:</span>
                        <span class="badge bg-dark text-white font-monospace rounded-pill">@quantidadePagaMes</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Apps" asp-action="Index" class="btn btn-link text-decoration-none text-secondary p-0 d-inline-flex align-items-center gap-2 btn-back-hover">
            <i class="bi bi-arrow-left-short fs-4"></i> <span class="fw-medium small">Voltar ao Painel</span>
        </a>
    </div>

</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .tracking-wider {
        letter-spacing: 0.8px;
    }

    .filter-dropdown {
        border-color: #dee2e6 !important;
        border-radius: 6px;
        color: #495057;
        font-size: 0.85rem !important;
        height: 34px;
        background-color: #ffffff;
    }

        .filter-dropdown:focus {
            border-color: #212529 !important;
            box-shadow: 0 0 0 0.2rem rgba(33, 37, 41, 0.04) !important;
        }

    .btn-filter-submit {
        height: 34px;
        font-size: 0.85rem;
        font-weight: 500;
        border-radius: 6px;
    }

    .bg-table-header {
        background-color: #fafafa;
        border-bottom: 1px solid #ededed;
    }

        .bg-table-header th {
            font-size: 0.72rem;
            font-weight: 700;
            text-uppercase: true;
            color: #6c757d;
            padding: 12px 10px;
            letter-spacing: 0.5px;
        }

    .financas-row {
        border-bottom: 1px solid #f6f6f6;
        transition: background-color 0.2s ease;
    }

        .financas-row:hover {
            background-color: #fafafa !important;
        }

    .status-dot {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #495057;
    }

        .status-dot::before {
            content: '';
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

    .status-paga::before {
        background-color: #2ec4b6;
    }

    .status-atraso::before {
        background-color: #e71d36;
    }

    .status-aguardando::before {
        background-color: #ff9f1c;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const totalRecebido = parseFloat("@totalSalarioMes.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)");
        const selectPorcentagem = document.getElementById("selectPorcentagem");
        const txtPorcentagemLabel = document.getElementById("txtPorcentagemLabel");
        const txtValorRepasse = document.getElementById("txtValorRepasse");

        function calcularRepasse() {
            const porcentagem = parseInt(selectPorcentagem.value) || 0;
            const valorCalculado = totalRecebido * (porcentagem / 100);

            txtPorcentagemLabel.innerText = porcentagem + "%";
            txtValorRepasse.innerText = valorCalculado.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
        }

        selectPorcentagem.addEventListener("change", calcularRepasse);
        calcularRepasse(); // Executa ao carregar a página
    });
</script>