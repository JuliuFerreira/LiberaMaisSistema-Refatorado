    #btnGerarRelatorio {
        transition: all 0.2s ease;
    }


        #btnGerarRelatorio:not(:disabled):hover {
            transform: translateY(-1px);
        }

</style>


<script>

    /* =========================================================
       ALERTAS
       ========================================================= */

    window.addEventListener('load', function () {

        setTimeout(function () {

            var alertas = [

                document.getElementById("alertaSucesso"),

                document.getElementById("alertaErro")

            ];


            alertas.forEach(function (alerta) {

                if (alerta) {

                    alerta.style.transition =
                        "opacity 0.5s ease";

                    alerta.style.opacity = "0";


                    setTimeout(function () {

                        alerta.style.display = "none";

                    }, 500);

                }

            });

        }, 3000);

    });



    /* =========================================================
       SELEÇÃO DE CONTRATOS
       ========================================================= */

    document.addEventListener("DOMContentLoaded", function () {

        const checkboxes =
            document.querySelectorAll(".repasse-checkbox");


        const quantidadeSelecionados =
            document.getElementById("quantidadeSelecionados");


        const btnGerarRelatorio =
            document.getElementById("btnGerarRelatorio");


        /* =====================================================
           ATUALIZA QUANTIDADE
           ===================================================== */

        function atualizarTotais() {

            let quantidade = 0;


            checkboxes.forEach(function (checkbox) {

                if (checkbox.checked) {

                    quantidade++;

                }

            });


            quantidadeSelecionados.textContent =
                quantidade;


            btnGerarRelatorio.disabled =
                quantidade === 0;

        }



        /* =====================================================
           ESCUTA CHECKBOXES
           ===================================================== */

        checkboxes.forEach(function (checkbox) {

            checkbox.addEventListener(
                "change",
                atualizarTotais
            );

        });



        /* =====================================================
           GERAR RELATÓRIO
           ===================================================== */

        btnGerarRelatorio.addEventListener("click", function () {

            const vendasSelecionadas = [];


            checkboxes.forEach(function (checkbox) {

                if (checkbox.checked) {

                    vendasSelecionadas.push(
                        checkbox.value
                    );

                }

            });


            if (vendasSelecionadas.length === 0) {

                return;

            }


            const form =
                document.createElement("form");


            form.method = "POST";

            form.action =
                "/Comissao/RelatorioDePagamento";


            vendasSelecionadas.forEach(function (id) {

                const input =
                    document.createElement("input");


                input.type = "hidden";

                input.name =
                    "vendasSelecionadas";

                input.value = id;


                form.appendChild(input);

            });


            document.body.appendChild(form);

            form.submit();

        });



        /* =====================================================
           INICIALIZA
           ===================================================== */

        atualizarTotais();

    });

</script>