@using LiberaMais.Models.Enums
@using LiberaMais.Helper

@inject ISessao Sessao

@{
    var usuarioLogado = Sessao.BuscarSessaoDoUsuario();
    bool IsAdmin = usuarioLogado?.Perfil == PerfilEnum.Admin;

    }
<html lang="pt-br">

<head>
    <meta charset="utf-8" />

    <title>@ViewData["Title"] - LiberaMais</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/Agendamentos.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Acionamentos.css" asp-append-version="true" />




    <style>

        :root {
            --sidebar-width: 260px;
            --primary-dark: #2c3e50;
        }


        /* SIDEBAR COMPONENT */

        .sidebar-component-wrapper {
            width: 100%;
            display: flex;
            justify-content: center;
            padding: 0 !important;
            margin: 0 !important;
        }

            .sidebar-component-wrapper ul,
            .sidebar-component-wrapper li,
            .sidebar-component-wrapper div,
            .sidebar-component-wrapper nav {
                list-style: none !important;
                padding: 0 !important;
                margin: 0 auto !important;
                float: none !important;
            }


        /* BODY */

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: #f4f7f6;
        }


        /* SIDEBAR */

        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--primary-dark);
            position: fixed;
            top: 0;
            left: 0;
            color: #fff;
            padding: 25px 20px;
            display: flex;
            flex-direction: column;
        }


            .sidebar .brand {
                font-weight: bold;
                font-size: 1.4rem;
                display: block;
                text-align: center;
                color: #fff;
            }


        /* MENU */

        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #adb5bd;
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.3s;
        }

            .menu-item:hover,
            .menu-item.active {
                background: #34495e;
                color: #fff;
            }

            .menu-item i {
                margin-right: 15px;
                font-size: 1.2rem;
            }


        /* CONTEÚDO */

        .main-content {
            margin-left: var(--sidebar-width);
            padding: 40px;
        }


        /* INDICADOR DO MENU */

        .menu-item[aria-expanded="false"] .menu-indicador::before {
            content: "+";
            font-size: 1.1rem;
        }

        .menu-item[aria-expanded="true"] .menu-indicador::before {
            content: "-";
            font-size: 1.1rem;
        }


        /* SUBMENU */

        .submenu-wrapper {
            transition: all 0.2s ease-in-out;
        }

        .submenu-item {
            padding: 0.4rem 0.75rem;
            border-radius: 6px;
            display: block;
            color: #adb5bd !important;
            transition: background-color 0.15s, color 0.15s;
        }

            .submenu-item:hover {
                background-color: rgba(255, 255, 255, 0.1);
                color: #ffffff !important;
            }


        /* ÁREA GLOBAL DE ALERTAS */

        #areaAlertaAgendamento {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 420px;
            max-width: calc(100vw - 40px);
            z-index: 9999;
        }


        /* ANIMAÇÃO DO ALERTA */

        .alerta-agendamento {
            animation: aparecerAlerta 0.4s ease-out;
        }

        @@keyframes aparecerAlerta {

            from {
                opacity: 0;
                transform: translateX(30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

    </style>

</head>


<body>


    <!-- ====================================== -->
    <!-- SIDEBAR -->
    <!-- ====================================== -->

    <aside class="sidebar">

        <div class="sidebar-top w-100 text-center">

            <a href="/"
               class="brand text-decoration-none mb-3 d-block">

                LIBERA<span class="text-warning">MAIS</span>

            </a>


            <nav class="sidebar-component-wrapper w-100">

                @await Component.InvokeAsync("Menu")

            </nav>

        </div>


        <div class="d-flex flex-column mt-4 w-100 px-1">

            <a asp-controller="Apps"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-house-door"></i>
                Painel

            </a>


            <a asp-controller="Clientes"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-people"></i>
                Clientes

            </a>


            <a asp-controller="Agendamento"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-calendar3"></i>
                Agenda

            </a>


            <a asp-controller="Venda"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-currency-dollar"></i>
                Vendas

            </a>

            <a asp-controller="Calculadora"
               target="_blank"
               rel="noopener noreferrer"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-calculator"></i>
                
                Calculadora

            </a>


            <a asp-controller="Promotora"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-building"></i>
                Promotoras

            </a>


            <a asp-controller="ClienteBeneficio"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-lock-fill"></i>
                Senha Portal Cliente

            </a>


            <a asp-controller="Util"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-link-45deg"></i>
                Links úteis

            </a>


            <a asp-controller="Acionamento"
               asp-action="Index"
               class="menu-item">

                <i class="bi bi-card-text"></i>
                Prospecção

            </a>

            @if (IsAdmin)
            {
                <a asp-controller="Comissao"
                   asp-action="Relatorio"
                   class="menu-item">

                    <i class="bi bi-coin"></i>
                    Comissões

                </a>

                <a asp-controller="Financa"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-wallet2"></i>
                    Finança

                </a>

                <a class="menu-item d-flex justify-content-between align-items-center"
                   data-bs-toggle="collapse"
                   href="#submenuSetup"
                   role="button"
                   aria-expanded="false"
                   aria-controls="submenuSetup">

                    <span>

                        <i class="bi bi-gear-fill"></i>
                        Configurações

                    </span>

                    <span class="menu-indicador fw-bold"></span>

                </a>
            }

            


            


            <!-- CONFIGURAÇÕES -->

            


            <div class="collapse submenu-wrapper"
                 id="submenuSetup">

                <div class="d-flex flex-column ps-4 row-gap-1 py-1">


                    <a asp-controller="Usuario"
                       asp-action="Index"
                       class="submenu-item small text-decoration-none text-muted">

                        <i class="bi bi-person-gear"></i>
                        Usuários

                    </a>


                    <a asp-controller="Banco"
                       asp-action="Index"
                       class="submenu-item small text-decoration-none text-muted">

                        <i class="bi bi-bank"></i>
                        Bancos

                    </a>


                    <a asp-controller="Orgao"
                       asp-action="Index"
                       class="submenu-item small text-decoration-none text-muted">

                        <i class="bi bi-building"></i>
                        Orgãos

                    </a>


                    <a asp-controller="Beneficio"
                       asp-action="Index"
                       class="submenu-item small text-decoration-none text-muted">

                        <i class="bi bi-card-checklist"></i>
                        Beneficios

                    </a>

                    <a asp-controller="TaxaCoeficiente"
                       asp-action="Index"
                       class="submenu-item small text-decoration-none text-muted">

                        <i class="bi bi-file-spreadsheet"></i>

                        Taxas

                    </a>


                </div>

            </div>

        </div>


        <div class="sidebar-bottom"
             style="height: 40px;">
        </div>

    </aside>



    <!-- ====================================== -->
    <!-- CONTEÚDO -->
    <!-- ====================================== -->

    <main class="main-content">

        @RenderBody()

    </main>



    <!-- ====================================== -->
    <!-- ÁREA GLOBAL DE ALERTAS -->
    <!-- ====================================== -->

    <div id="areaAlertaAgendamento"></div>



    <!-- ====================================== -->
    <!-- SCRIPTS -->
    <!-- ====================================== -->

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>



    <!-- ====================================== -->
    <!-- SISTEMA GLOBAL DE AGENDAMENTOS -->
    <!-- ====================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            console.log("Sistema global de agendamentos iniciado.");

            // Verifica imediatamente ao abrir qualquer página
            verificarAgendamentos();

            // Verifica a cada 30 segundos
            setInterval(verificarAgendamentos, 30000);

        });


        function verificarAgendamentos() {

            console.log("Verificando agendamentos...");


            // =====================================================
            // AGENDAMENTOS DE PROSPECÇÃO / ACIONAMENTO
            // =====================================================

            fetch('/Acionamento/Agendamentos')

                .then(response => {

                    if (!response.ok) {

                        throw new Error(
                            "Erro ao consultar agendamentos de prospecção."
                        );

                    }

                    return response.json();

                })

                .then(agendamentos => {

                    console.log(
                        "Agendamentos de prospecção:",
                        agendamentos
                    );

                    processarAgendamentos(
                        agendamentos,
                        "acionamento"
                    );

                })

                .catch(error => {

                    console.error(
                        "Erro ao verificar agendamentos de prospecção:",
                        error
                    );

                });



            // =====================================================
            // AGENDAMENTOS DE CLIENTES
            // =====================================================

            fetch('/Agendamento/Agendamentos')

                .then(response => {

                    if (!response.ok) {

                        throw new Error(
                            "Erro ao consultar agendamentos de clientes."
                        );

                    }

                    return response.json();

                })

                .then(agendamentos => {

                    console.log(
                        "Agendamentos de clientes:",
                        agendamentos
                    );

                    processarAgendamentos(
                        agendamentos,
                        "cliente"
                    );

                })

                .catch(error => {

                    console.error(
                        "Erro ao verificar agendamentos de clientes:",
                        error
                    );

                });

        }



        // =====================================================
        // PROCESSA OS DOIS TIPOS DE AGENDAMENTO
        // =====================================================

        function processarAgendamentos(
            agendamentos,
            tipo
        ) {

            const agora = new Date();


            agendamentos.forEach(function (agendamento) {

                if (!agendamento.dataAgendamento) {

                    return;

                }


                const dataAgendamento =
                    new Date(
                        agendamento.dataAgendamento
                    );


                /*
                 * Só mostra quando o horário
                 * do agendamento já chegou.
                 */

                if (dataAgendamento <= agora) {

                    mostrarAlertaAgendamento(
                        agendamento,
                        tipo
                    );

                }

            });

        }



        // =====================================================
        // MOSTRA O ALERTA
        // =====================================================

        function mostrarAlertaAgendamento(
            agendamento,
            tipo
        ) {

            const area =
                document.getElementById(
                    "areaAlertaAgendamento"
                );


            if (!area) {

                return;

            }


            const data =
                new Date(
                    agendamento.dataAgendamento
                );


            const dataFormatada =
                data.toLocaleDateString(
                    "pt-BR"
                )
                +
                " às "
                +
                data.toLocaleTimeString(
                    "pt-BR",
                    {
                        hour: "2-digit",
                        minute: "2-digit"
                    }
                );


            /*
             * Cada tipo possui um ID diferente.
             *
             * Isso evita que um agendamento de
             * Acionamento e um Agendamento de Cliente
             * entrem em conflito.
             */

            const idAlerta =
                "alerta_" +
                tipo +
                "_" +
                agendamento.id;


            /*
             * Evita duplicar o mesmo alerta.
             */

            if (
                document.getElementById(
                    idAlerta
                )
            ) {

                return;

            }


            const alerta =
                document.createElement("div");


            alerta.id =
                idAlerta;


            alerta.className =
                "alert alert-warning shadow-lg border-0 rounded-4 mb-3 alerta-agendamento";


            alerta.style.borderLeft =
                "5px solid #ffc107";



            // =================================================
            // DEFINE O DESTINO DO BOTÃO
            // =================================================

            let link;

            let titulo;

            let textoBotao;


            if (tipo === "acionamento") {

                link =
                    `/Historico/Index?acionamentoId=${agendamento.acionamentoId}`;

                titulo =
                    "Agendamento de Prospecção";

                textoBotao =
                    "Ver Histórico";

            }
            else {

                link =
                    `/Agendamento/Index`;

                titulo =
                    "Agendamento de Cliente";

                textoBotao =
                    "Ver Agendamentos";

            }



            // =================================================
            // HTML DO ALERTA
            // =================================================

            alerta.innerHTML = `

                <div class="d-flex align-items-start">


                    <div class="me-3">

                        <div style="
                            width: 45px;
                            height: 45px;
                            border-radius: 50%;
                            background: #ffe69c;
                            color: #856404;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 1.2rem;
                        ">

                            <i class="bi bi-bell-fill"></i>

                        </div>

                    </div>


                    <div class="flex-grow-1">


                        <div class="fw-bold text-dark mb-1">

                            ${titulo}

                        </div>


                        <div class="small text-dark">

                            É hora de entrar em contato com

                            <strong>
                                ${agendamento.nome}
                            </strong>.

                        </div>


                        <div class="text-muted small mt-1 mb-3">

                            <i class="bi bi-calendar-event me-1"></i>

                            ${dataFormatada}

                        </div>


                        <a href="${link}"
                           class="btn btn-dark btn-sm rounded-3 px-3">

                            <i class="bi bi-arrow-right me-1"></i>

                            ${textoBotao}

                        </a>


                    </div>


                    <button type="button"
                            class="btn-close ms-2"
                            aria-label="Fechar"
                            onclick="this.closest('.alert').remove();">

                    </button>


                </div>

            `;


            area.appendChild(alerta);

        }

    </script>


    <script src="~/js/Acionamentos.js" asp-append-version="true"></script>
    <script src="~/js/Agendamentos.js" asp-append-version="true"></script>



    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>