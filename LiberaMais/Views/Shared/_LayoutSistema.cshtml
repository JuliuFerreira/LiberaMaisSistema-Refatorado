<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - LiberaMais</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --sidebar-width: 260px;
            --primary-dark: #2c3e50;
        }

        /* Garante que o container do componente ocupe 100% da largura sem sobras */
        .sidebar-component-wrapper {
            width: 100%;
            display: flex;
            justify-content: center; /* Força o alinhamento horizontal ao centro */
            padding: 0 !important;
            margin: 0 !important;
        }

            /* ZERA ABSOLUTAMENTE tudo o que o View Component gera de tabelas, listas ou divs internas */
            .sidebar-component-wrapper ul,
            .sidebar-component-wrapper li,
            .sidebar-component-wrapper div,
            .sidebar-component-wrapper nav {
                list-style: none !important;
                padding: 0 !important;
                margin: 0 auto !important; /* Reseta margens e centraliza o bloco */
                float: none !important; /* Previne desalinhamentos antigos */
            }

        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: #f4f7f6;
        }

        /* SIDEBAR AJUSTADA COMO FLEXBOX VERTICAL */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--primary-dark);
            position: fixed;
            top: 0;
            left: 0;
            color: #fff;
            padding: 25px 20px;
            display: flex; /* Habilita o Flexbox */
            flex-direction: column; /* Empilha os elementos verticalmente (Corrigido) */
        }

            .sidebar .brand {
                font-weight: bold;
                font-size: 1.4rem;
                display: block;
                text-align: center;
                color: #fff;
            }

        /* MENU LINKS */
        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #adb5bd;
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 5px;
            transition: 0.3s;
        }

            .menu-item:hover, .menu-item.active {
                background: #34495e;
                color: #fff;
            }

            .menu-item i {
                margin-right: 15px;
                font-size: 1.2rem;
            }

        /* CONTEÚDO */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 40px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-top w-100 text-center">
            <a href="/" class="brand text-decoration-none mb-3 d-block">LIBERA<span class="text-warning">MAIS</span></a>

            <nav class="sidebar-component-wrapper w-100">
                @await Component.InvokeAsync("Menu")
            </nav>
        </div>

        <div class="d-flex flex-column mt-4 w-100 px-1">
            <a asp-controller="Apps" asp-action="Index" class="menu-item"><i class="bi bi-house-door"></i> Painel</a>
            <a asp-controller="Clientes" asp-action="Index" class="menu-item"><i class="bi bi-people"></i> Clientes</a>
            <a asp-controller="Venda" asp-action="Index" class="menu-item"><i class="bi bi-currency-dollar"></i> Vendas</a>
            <a asp-controller="Promotora" asp-action="Index" class="menu-item"><i class="bi bi-building"></i> Promotoras</a>
            <a asp-controller="Comissao" asp-action="Relatorio" class="menu-item"><i class="bi bi-coin"></i> Comissões</a>
            <a asp-controller="Financa" asp-action="Index" class="menu-item"><i class="bi bi-wallet2"></i> Finança</a>
            <a asp-controller="ClienteBeneficio" asp-action="Index" class="menu-item"><i class="bi bi-lock-fill"></i> Senha Portal Cliente</a>
            <a asp-controller="Util" asp-action="Index" class="menu-item"><i class="bi bi-link-45deg"></i> Links úteis</a>
            <a asp-controller="Setup" asp-action="Index" class="menu-item"><i class="bi bi-gear-fill"></i> Configurações</a>
        </div>

        <div class="sidebar-bottom" style="height: 40px;"></div>
    </aside>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>