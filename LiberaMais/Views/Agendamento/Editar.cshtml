@using LiberaMais.Models.Enums
@model Agendamento

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Editar Agendamento";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">

        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">
                Editar
            </h2>

            <small class="text-muted">
                Altere os dados do agendamento
            </small>
        </div>

    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso"
             class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">

            <i class="bi bi-check-circle-fill me-1"></i>

            @TempData["MensagemSucesso"]

        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro"
             class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">

            <i class="bi bi-exclamation-triangle-fill me-1"></i>

            @TempData["MensagemErro"]

        </div>
    }

    <div class="row">

        <div class="col-12">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-body p-4">

                    <form asp-controller="Agendamento"
                          asp-action="Editar"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />


                        <div class="row g-4">

                            <div class="col-md-4">

                                <label class="form-label small fw-bold text-muted">
                                    DATA DE CADASTRO
                                </label>

                                <input type="text"
                                       class="form-control rounded-3 py-2"
                                       value="@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")"
                                       readonly />

                                <input type="hidden"
                                       asp-for="DataCadastro" />

                            </div>

                            @* <div class="col-md-8">

                                <label class="form-label small fw-bold text-muted">
                                    BUSCAR CLIENTE
                                </label>

                                <div class="input-group">

                                    <input type="text"
                                           id="termoCliente"
                                           class="form-control rounded-start-3 py-2"
                                           placeholder="Digite o nome ou CPF do cliente..."/>

                                    <button type="button"
                                            id="btnBuscarCliente"
                                            class="btn btn-dark px-4">

                                        <i class="bi bi-search me-1"></i>

                                        Buscar

                                    </button>

                                </div>

                            </div> *@

                            <div class="col-12">

                                <div id="resultadoClientes"
                                     class="list-group">
                                </div>

                            </div>

                            <input type="hidden"
                                   asp-for="ClienteId"
                                   id="ClienteId" />

                            <div class="col-md-4">

                                <label class="form-label small fw-bold text-muted">
                                    NOME
                                </label>

                                <input type="text"
                                       id="ClienteNome"
                                       class="form-control rounded-3 py-2"
                                       value="@Model.Cliente?.Nome"
                                       readonly />

                            </div>

                            <div class="col-md-4">

                                <label class="form-label small fw-bold text-muted">
                                    CPF
                                </label>

                                <input type="text"
                                       id="ClienteCpf"
                                       class="form-control rounded-3 py-2"
                                       value="@Model.Cliente?.Cpf"
                                       readonly />

                            </div>

                            <div class="col-md-4">

                                <label class="form-label small fw-bold text-muted">
                                    TELEFONE
                                </label>

                                <input type="text"
                                       id="ClienteFone"
                                       class="form-control rounded-3 py-2"
                                       value="@Model.Cliente?.Fone"
                                       readonly />

                            </div>

                            <div class="col-md-4">

                                <label class="form-label small fw-bold text-muted">
                                    USUÁRIO
                                </label>

                                <select asp-for="UsuarioId"
                                        class="form-select rounded-3 py-2">

                                    <option value="">
                                        Selecione um usuário...
                                    </option>

                                    @if (ViewBag.Usuarios != null)
                                    {
                                        foreach (var user in ViewBag.Usuarios)
                                        {
                                            <option value="@user.Id">
                                                @user.Nome
                                            </option>
                                        }
                                    }

                                </select>

                                <span asp-validation-for="UsuarioId"
                                      class="text-danger small d-block mt-1">
                                </span>

                            </div>

                            <div class="col-md-4">

                                <label asp-for="DataAgendamento"
                                       class="form-label small fw-bold text-muted">

                                    DATA DE AGENDAMENTO

                                </label>

                                <input asp-for="DataAgendamento"
                                       type="datetime-local"
                                       class="form-control rounded-3 py-2"
                                       value="@Model.DataAgendamento.ToString("yyyy-MM-ddTHH:mm")"
                                       step="60" />

                                <span asp-validation-for="DataAgendamento"
                                      class="text-danger small">
                                </span>

                            </div>

                            <div class="col-md-12">

                                <label asp-for="Informacoes"
                                       class="form-label small fw-bold text-muted">

                                    INFORMAÇÕES

                                </label>

                                <input asp-for="Informacoes"
                                       class="form-control rounded-3 py-2" />

                                <span asp-validation-for="Informacoes"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 rounded-3">

                                Voltar

                            </a>

                            <button type="submit"
                                    class="btn btn-dark px-4 rounded-3 shadow-sm">

                                <i class="bi bi-check-lg me-1"></i>

                                Salvar Alterações

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
