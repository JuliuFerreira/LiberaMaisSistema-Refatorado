@model IEnumerable<Agendamento>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Agendamentos";

    string buscaAtual = ViewBag.BuscaAtual ?? "";
    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    int? usuarioAtual = ViewBag.UsuarioAtual;
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">

        <div>

            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="titulo-icone">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <h2 class="fw-bold text-dark mb-0 titulo-pagina">
                    Agendamentos
                </h2>

            </div>

            <small class="text-muted">
                Clientes que possuem retorno ou atendimento agendado.
            </small>

        </div>


        <a asp-action="Criar"
           class="btn btn-dark d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">

            <i class="bi bi-plus-lg"></i>

            <span class="fw-semibold small">
                Novo Agendamento
            </span>

        </a>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-3">

            <form asp-controller="Agendamento"
                  asp-action="Index"
                  method="get"
                  class="row g-2 align-items-center">

                <div class="col-12 col-lg">

                    <div class="input-group">

                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <input type="text"
                               name="busca"
                               value="@buscaAtual"
                               class="form-control border-start-0"
                               placeholder="Buscar por nome, CPF ou telefone..." />

                    </div>

                </div>

                @if (isAdmin)
                {
                    <div class="col-12 col-md-auto">

                        <select name="usuarioId"
                                class="form-select filtro-usuario">

                            <option value="">
                                Todos os usuários
                            </option>

                            @if (ViewBag.Usuarios != null)
                            {
                                foreach (var usuario in ViewBag.Usuarios)
                                {
                                    <option value="@usuario.Id"
                                            selected="@(usuarioAtual == usuario.Id)">
                                        @usuario.Nome
                                    </option>
                                }
                            }

                        </select>

                    </div>
                }

                <div class="col-12 col-md-auto">

                    <button type="submit"
                            class="btn btn-dark px-4 w-100">

                        <i class="bi bi-search me-1"></i>
                        Buscar

                    </button>

                </div>

                @if (!string.IsNullOrWhiteSpace(buscaAtual) || usuarioAtual.HasValue)
                {
                    <div class="col-12 col-md-auto">

                        <a asp-action="Index"
                           class="btn btn-light border px-3 w-100">

                            <i class="bi bi-x-lg me-1"></i>
                            Limpar

                        </a>

                    </div>
                }

            </form>

        </div>

    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso"
             class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">

            <i class="bi bi-check-circle-fill me-1"></i>
            @TempData["MensagemSucesso"]

        </div>
    }


    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro"
             class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">

            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @TempData["MensagemErro"]

        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>

            <span class="fw-semibold text-dark">
                Próximos atendimentos
            </span>

            <span class="badge bg-light text-dark border ms-2">
                @totalRegistros
            </span>

        </div>

        <small class="text-muted">
            Página @paginaAtual de @totalPaginas
        </small>

    </div>

    <div class="card card-table shadow-sm border-0 mb-3">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-custom align-middle mb-0">

                    <thead>

                        <tr>

                            <th class="ps-4 coluna-data">
                                Cadastro
                            </th>

                            <th>
                                Cliente
                            </th>

                            <th>
                                CPF
                            </th>

                            <th>
                                Usuário
                            </th>

                            <th class="coluna-agendamento">
                                Retorno
                            </th>

                            <th>
                                Telefone
                            </th>

                            <th class="coluna-info">
                                Informações
                            </th>

                            <th class="text-center pe-4 coluna-acoes">
                                Ações
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {

                            foreach (var ag in Model)
                            {

                                var agora = DateTime.Now;

                                var diferenca = ag.DataAgendamento - agora;

                                string classeData = "";

                                if (ag.DataAgendamento < agora)
                                {
                                    classeData = "agendamento-atrasado";
                                }
                                else if (ag.DataAgendamento.Date == agora.Date)
                                {
                                    classeData = "agendamento-hoje";
                                }
                                else if (diferenca.TotalHours <= 24)
                                {
                                    classeData = "agendamento-proximo";
                                }


                                <tr>

                                    <td class="ps-4">

                                        <div class="data-cadastro">

                                            <span class="data-dia">
                                                @ag.DataCadastro.ToString("dd/MM/yyyy")
                                            </span>

                                            <small>
                                                @ag.DataCadastro.ToString("HH:mm")
                                            </small>

                                        </div>

                                    </td>

                                    <td>

                                        <div class="cliente-info">

                                            <div class="cliente-avatar">
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <div>

                                                <div class="cliente-nome">
                                                    @ag.Cliente.Nome
                                                </div>

                                                <small class="text-muted">
                                                    Cliente
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="text-muted cpf-text">
                                            @ag.Cliente.Cpf
                                        </span>

                                    </td>

                                    <td>

                                        <span class="usuario-badge">

                                            <i class="bi bi-person-circle"></i>

                                            @ag.Usuario?.Nome

                                        </span>

                                    </td>

                                    <td>

                                        <div class="data-agendamento @classeData">

                                            <div class="data-agendamento-icone">

                                                <i class="bi bi-calendar-event"></i>

                                            </div>

                                            <div>

                                                <div class="data-agendamento-data">

                                                    @ag.DataAgendamento.ToString("dd/MM/yyyy")

                                                </div>

                                                <div class="data-agendamento-hora">

                                                    @ag.DataAgendamento.ToString("HH:mm")

                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="telefone-text">

                                            <i class="bi bi-telephone me-1 text-muted"></i>

                                            @ag.Cliente.Fone

                                        </span>

                                    </td>

                                    <td class="coluna-info">

                                        @if (!string.IsNullOrWhiteSpace(ag.Informacoes))
                                        {
                                            <span class="informacoes-text"
                                                  title="@ag.Informacoes">

                                                @ag.Informacoes

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                —
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center pe-4">

                                        <div class="acoes">

                                            <a asp-controller="Agendamento"
                                               asp-action="Editar"
                                               asp-route-id="@ag.Id"
                                               class="btn-acao btn-editar"
                                               title="Editar / Reagendar">

                                                <i class="bi bi-pencil-square"></i>

                                            </a>

                                            <button type="button"
                                                    class="btn-acao btn-excluir"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalExcluir_@ag.Id"
                                                    title="Finalizar Agendamento">

                                                <i class="bi bi-check-lg"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>

                                <div class="modal fade"
                                     id="modalExcluir_@ag.Id"
                                     tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">

                                        <div class="modal-content border-0 shadow rounded-4">


                                            <div class="modal-header border-0">

                                                <div>

                                                    <h5 class="modal-title fw-bold mb-1">
                                                        Finalizar agendamento
                                                    </h5>

                                                    <small class="text-muted">
                                                        Confirme se este retorno já foi realizado.
                                                    </small>

                                                </div>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Close">
                                                </button>

                                            </div>


                                            <div class="modal-body pt-2">

                                                <div class="confirmacao-cliente">

                                                    <div class="cliente-avatar grande">
                                                        <i class="bi bi-person"></i>
                                                    </div>

                                                    <div>

                                                        <div class="fw-bold">
                                                            @ag.Cliente.Nome
                                                        </div>

                                                        <small class="text-muted">
                                                            @ag.Cliente.Fone
                                                        </small>

                                                    </div>

                                                </div>


                                                <div class="alert alert-warning border-0 rounded-3 small mt-3 mb-0">

                                                    <i class="bi bi-exclamation-triangle me-1"></i>

                                                    Ao confirmar, este agendamento será removido da lista.

                                                </div>

                                            </div>


                                            <div class="modal-footer border-0">

                                                <button type="button"
                                                        class="btn btn-light border"
                                                        data-bs-dismiss="modal">

                                                    Cancelar

                                                </button>


                                                <form asp-controller="Agendamento"
                                                      asp-action="Apagar"
                                                      method="post"
                                                      class="d-inline">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@ag.Id" />

                                                    <button type="submit"
                                                            class="btn btn-success px-4">

                                                        <i class="bi bi-check-lg me-1"></i>

                                                        Finalizar

                                                    </button>

                                                </form>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <div class="estado-vazio">

                                        <div class="icone-vazio">

                                            <i class="bi bi-calendar-x"></i>

                                        </div>

                                        <h6 class="fw-semibold mt-3 mb-1">
                                            Nenhum agendamento encontrado
                                        </h6>

                                        <span class="small text-muted">
                                            Não existem agendamentos para exibição.
                                        </span>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

                <div class="total-registros">

                    <span>
                        Total:
                        <strong>@totalRegistros</strong>
                        agendamento(s)
                    </span>

                </div>

            </div>

        </div>

    </div>

    @if (ViewBag.TotalPaginas > 1)
    {

        var usuarioRota = ViewBag.UsuarioAtual;

        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border border-light-subtle mb-4">

            <div class="text-muted small">

                Página
                <strong>@ViewBag.PaginaAtual</strong>
                de
                <strong>@ViewBag.TotalPaginas</strong>

            </div>


            <div class="d-flex gap-2">

                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual - 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   asp-route-usuarioId="@usuarioRota"
                   class="btn btn-sm btn-outline-dark rounded-3 px-3 @(ViewBag.PaginaAtual == 1 ? "disabled" : "")">

                    <i class="bi bi-chevron-left"></i>
                    Anterior

                </a>


                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual + 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   asp-route-usuarioId="@usuarioRota"
                   class="btn btn-sm btn-dark rounded-3 px-3 @(ViewBag.PaginaAtual == ViewBag.TotalPaginas ? "disabled" : "")">

                    Próximo
                    <i class="bi bi-chevron-right"></i>

                </a>

            </div>

        </div>

    }

    <div class="mt-4">

        <a asp-controller="Apps"
           asp-action="Index"
           class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1">

            <i class="bi bi-arrow-left"></i>

            Voltar

        </a>

    </div>

</div>



