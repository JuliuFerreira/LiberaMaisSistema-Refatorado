@using LiberaMais.Models.Enums
@model IEnumerable<Acionamento>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Acionamentos";

    string buscaAtual = ViewBag.BuscaAtual ?? "";
    int paginaAtual = ViewBag.PaginaAtual ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;

    int? usuarioAtual = ViewBag.UsuarioAtual;
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div class="container-fluid py-4 inner-system-page">

    <!-- CABEÇALHO -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">

        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">
                Contatos
            </h2>

            <small class="text-muted">
                Lista de Prospecção.
            </small>
        </div>

        <a asp-action="Criar"
           class="btn btn-dark d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">

            <i class="bi bi-plus-lg"></i>

            <span class="fw-semibold small">
                Adicionar
            </span>

        </a>

    </div>

    <form asp-controller="Acionamento"
          asp-action="Index"
          method="get"
          class="d-flex flex-wrap gap-2 mb-4">

        <div>
            <input type="text"
                   name="busca"
                   value="@buscaAtual"
                   class="form-control form-control-sm"
                   placeholder="Nome, CPF ou telefone..."
                   style="width: 280px;" />
        </div>


        @if (isAdmin)
        {
            <div>
                <select name="usuarioId"
                        class="form-select form-select-sm"
                        style="width: 200px;">

                    <option value="">
                        Todos os Usuários
                    </option>

                    @if (ViewBag.Usuarios != null)
                    {
                        foreach (var usuario in ViewBag.Usuarios)
                        {
                            <option value="@usuario.Id"
                                    selected="@(usuarioAtual == usuario.Id)">
                                @usuario.Nome
                            </option>
                        }
                    }

                </select>
            </div>
        }


        <button type="submit"
                class="btn btn-dark btn-sm px-3">

            <i class="bi bi-search me-1"></i>

            Buscar

        </button>

    </form>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso"
             class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">

            <i class="bi bi-check-circle-fill me-1"></i>

            @TempData["MensagemSucesso"]

        </div>
    }


    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro"
             class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">

            <i class="bi bi-exclamation-triangle-fill me-1"></i>

            @TempData["MensagemErro"]

        </div>
    }

    <div class="card card-table shadow-sm border-0 mb-3">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-custom align-middle mb-0">

                    <thead>

                        <tr>

                            <th class="ps-4 text-center">
                                Cliente
                            </th>

                            <th>
                                Data de Cadastro
                            </th>

                            <th>
                                CPF
                            </th>

                            <th>
                                Nome
                            </th>

                            <th>
                                Usuário
                            </th>

                            <th>
                                Telefone
                            </th>

                            <th>
                                Agendamento
                            </th>

                            <th>
                                Último Status
                            </th>

                            <th class="text-center pe-4">
                                Ações
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {

                            foreach (var ac in Model)
                            {

                                var ultimoHistorico = ac.Historicos?
                                .OrderByDescending(h => h.Data)
                                .FirstOrDefault();


                                <tr>

                                    <td class="text-center">

                                        <a asp-controller="Clientes"
                                           asp-action="CriarDeAcionamento"
                                           asp-route-acionamentoId="@ac.Id"
                                           class="btn btn-sm btn-outline-success border-0 rounded-3"
                                           title="Tornar Cliente">

                                            <i class="bi bi-person-check-fill fs-5"></i>

                                        </a>

                                    </td>

                                    <td>

                                        <span class="fw-semibold text-dark">

                                            @ac.DataCadastro?.ToString("dd/MM/yyyy")

                                        </span>

                                    </td>

                                    <td>

                                        <span class="text-dark">

                                            @ac.Cpf

                                        </span>

                                    </td>

                                    <td>

                                        <span class="fw-bold text-dark">

                                            @ac.Nome

                                        </span>

                                    </td>

                                    <td>

                                        <span class="text-dark">

                                            @ac.Usuario?.Nome

                                        </span>

                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(ultimoHistorico?.Telefone))
                                        {
                                            <span class="text-dark">

                                                <i class="bi bi-telephone me-1 text-muted"></i>

                                                @ultimoHistorico.Telefone

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">

                                                Não informado

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (ultimoHistorico?.DataAgendamento != null)
                                        {
                                            <span class="badge badge-agendamento">

                                                <i class="bi bi-calendar-event me-1"></i>

                                                @ultimoHistorico.DataAgendamento.Value.ToString("dd/MM/yyyy HH:mm")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-sem-agendamento">

                                                <i class="bi bi-calendar-check me-1"></i>

                                                Nada agendado

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (ultimoHistorico != null)
                                        {
                                            <span class="badge badge-status">

                                                @ultimoHistorico.StatusEnum.GetDisplayName()

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-sem-historico">

                                                Sem Histórico

                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <div class="d-flex justify-content-center align-items-center gap-1">


                                            <a asp-controller="Historico"
                                               asp-action="Index"
                                               asp-route-acionamentoId="@ac.Id"
                                               class="btn btn-sm btn-outline-primary border-0 rounded-3"
                                               title="Ver Histórico">

                                                <i class="bi bi-chat-square-text fs-5"></i>

                                            </a>

                                            <a asp-controller="Acionamento"
                                               asp-action="Editar"
                                               asp-route-id="@ac.Id"
                                               class="btn btn-sm btn-outline-warning border-0 rounded-3"
                                               title="Editar">

                                                <i class="bi bi-pencil-square fs-5"></i>

                                            </a>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger border-0 rounded-3"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalExcluir_@ac.Id"
                                                    title="Excluir">

                                                <i class="bi bi-trash fs-5"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>


                                <div class="modal fade"
                                     id="modalExcluir_@ac.Id"
                                     tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">

                                        <div class="modal-content border-0 shadow">


                                            <div class="modal-header">

                                                <h5 class="modal-title fw-bold">
                                                    Confirmar Exclusão
                                                </h5>

                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Close">
                                                </button>

                                            </div>


                                            <div class="modal-body">

                                                Deseja realmente remover o Lead

                                                <strong>
                                                    @ac.Nome
                                                </strong>?

                                                <div class="text-muted small mt-2">

                                                    Essa ação não poderá ser desfeita.

                                                </div>

                                            </div>


                                            <div class="modal-footer">

                                                <button type="button"
                                                        class="btn btn-outline-secondary"
                                                        data-bs-dismiss="modal">

                                                    Cancelar

                                                </button>


                                                <form asp-controller="Acionamento"
                                                      asp-action="Apagar"
                                                      method="post"
                                                      class="d-inline">

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@ac.Id" />


                                                    <button type="submit"
                                                            class="btn btn-danger">

                                                        <i class="bi bi-trash me-1"></i>

                                                        Confirmar Exclusão

                                                    </button>

                                                </form>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            }

                        }
                        else
                        {

                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-person-lines-fill fs-1 d-block mb-3"></i>

                                        <h6 class="fw-semibold">
                                            Nenhum acionamento encontrado
                                        </h6>

                                        <span class="small">
                                            Não existem leads cadastrados para exibição.
                                        </span>

                                    </div>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>


                <div class="ms-4 my-3 text-secondary"
                     style="font-size: 0.85rem;">

                    <span>

                        Total:

                        <strong class="text-dark">
                            @ViewBag.TotalRegistros
                        </strong>

                        clientes cadastrados

                    </span>

                </div>

            </div>

        </div>

    </div>

    @if (ViewBag.TotalPaginas > 1)
    {

        var usuarioRota = ViewBag.UsuarioAtual;

        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border border-light-subtle mb-4">

            <div class="d-flex flex-column flex-sm-row gap-sm-3 text-muted small">

                <span>

                    Página

                    <strong>
                        @ViewBag.PaginaAtual
                    </strong>

                    de

                    <strong>
                        @ViewBag.TotalPaginas
                    </strong>

                </span>

            </div>


            <div class="btn-group gap-1">

                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual - 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   asp-route-usuarioId="@usuarioRota"
                   class="btn btn-sm btn-outline-dark rounded-2 px-3 fw-medium @(ViewBag.PaginaAtual == 1 ? "disabled" : "")">

                    <i class="bi bi-chevron-left me-1"></i>

                    Anterior

                </a>


                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual + 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   asp-route-usuarioId="@usuarioRota"
                   class="btn btn-sm btn-dark rounded-2 px-3 fw-medium @(ViewBag.PaginaAtual == ViewBag.TotalPaginas ? "disabled" : "")">

                    Próximo

                    <i class="bi bi-chevron-right ms-1"></i>

                </a>

            </div>

        </div>
    }


    <div class="mt-4">

        <a asp-controller="Apps"
           asp-action="Index"
           class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1">

            <i class="bi bi-arrow-left"></i>

            Voltar

        </a>

    </div>

</div>
