@model IEnumerable<ClienteBeneficio>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Benefícios por Cliente";
}

<div class="container-fluid py-4 inner-system-page">

    @* Topo da Página padronizado *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1 tracking-tight" style="font-size: 1.5rem;">Lista de Benefícios por Cliente</h2>
            <small class="text-muted">Consulte e gerencie os benefícios, órgãos vinculados e credenciais dos clientes</small>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        </div>
    }

    @* BARRA DE BUSCA INTEGRADA NO PADRÃO *@
    <div class="row mb-3">
        <div class="col-md-5 col-lg-4">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <div class="input-group input-group-sm shadow-sm rounded-3 overflow-hidden border">
                    <span class="input-group-text bg-white border-0 text-muted small">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="busca" value="@ViewBag.BuscaAtual"
                           class="form-control border-0 small ps-1"
                           placeholder="Buscar por nome ou CPF..." />
                </div>
                <button type="submit" class="btn btn-dark btn-sm px-3 fw-semibold rounded-3 shadow-sm">Buscar</button>

                @if (!string.IsNullOrWhiteSpace(ViewBag.BuscaAtual as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-3 d-inline-flex align-items-center justify-content-center">
                        Limpar
                    </a>
                }
            </form>
        </div>
    </div>

    @* Card da Tabela *@
    <div class="card card-custom shadow-sm border-0 rounded-4 mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark-custom text-uppercase">
                    <tr>
                        <th class="ps-4">Cliente</th>
                        <th>CPF</th>
                        <th>Órgão</th>
                        <th>Acesso ao portal</th>
                        <th class="pe-4"><i class="bi bi-lock me-1"></i> Senha do Portal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    @item.Cliente?.Nome
                                </td>
                                <td class="text-secondary">@item.Cliente?.Cpf</td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1.5 rounded-2">
                                        @item.Beneficio?.Orgaos?.Nome
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Beneficio?.Orgaos?.Url))
                                    {
                                        <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                                            <a href="@item.Beneficio.Orgaos.Url" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 py-1 px-2.5 text-dark shadow-sm rounded-2 fw-semibold" style="font-size: 0.85rem;">
                                                <i class="bi bi-box-arrow-up-right text-primary"></i> <span>Acessar ao Portal</span>
                                            </a>
                                            <button type="button" class="btn btn-link p-0 text-muted btn-copy btn-copy-style shadow-none"
                                                    onclick="copiarTexto(event, '@item.Beneficio.Orgaos.Url', this)" title="Copiar Link">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">---</span>
                                    }
                                </td>
                                <td class="text-muted text-truncate font-monospace" style="max-width: 250px;">
                                    @item.SenhaOrgao
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-folder-x d-block fs-2 mb-2 text-secondary"></i>
                                Nenhum benefício encontrado para esta listagem.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* SEU PADRÃO DE PAGINAÇÃO APLICADO EXATAMENTE AQUI *@
    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border border-light-subtle mb-4">
            @* Lado Esquerdo: Página Atual *@
            <div class="d-flex flex-column flex-sm-row gap-sm-3 text-muted small">
                <span>
                    Página <strong>@ViewBag.PaginaAtual</strong> de <strong>@ViewBag.TotalPaginas</strong>
                </span>
            </div>

            @* Lado Direito: Botões de Navegação *@
            <div class="btn-group gap-1">
                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual - 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   class="btn btn-sm btn-outline-dark rounded-2 px-3 py-1.5 fw-medium @(ViewBag.PaginaAtual == 1 ? "disabled" : "")">
                    <i class="bi bi-chevron-left me-1"></i> Anterior
                </a>

                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual + 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   class="btn btn-sm btn-dark rounded-2 px-3 py-1.5 fw-medium @(ViewBag.PaginaAtual == ViewBag.TotalPaginas ? "disabled" : "")">
                    Próximo <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    }

    @* Link de Voltar no Padrão do seu Sistema *@
    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-semibold small p-0 btn-back-hover"
           asp-controller="Apps" asp-action="Index">
            <i class="bi bi-arrow-left"></i> Voltar ao painel geral
        </a>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            setTimeout(function () {
                $("#alertaSucesso").fadeOut("slow");
                $("#alertaErro").fadeOut("slow");
            }, 3000);
        });

        function copiarTexto(event, texto, elemento) {
            event.preventDefault();
            navigator.clipboard.writeText(texto).then(() => {
                let icone = $(elemento).find('i');
                $(elemento).removeClass('text-muted').addClass('text-success');
                icone.removeClass('bi-clipboard').addClass('bi-check-lg');

                setTimeout(function () {
                    $(elemento).removeClass('text-success').addClass('text-muted');
                    icone.removeClass('bi-check-lg').addClass('bi-clipboard');
                }, 2000);
            }).catch(err => {
                console.error('Erro ao copiar: ', err);
            });
        }
    </script>
}

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .card-custom {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.06);
        background-color: #ffffff;
    }

    .table-dark-custom {
        background-color: #212529;
        color: #f8f9fa;
        font-size: 0.74rem;
        letter-spacing: 0.5px;
    }

        .table-dark-custom th {
            padding-top: 1rem;
            padding-bottom: 1rem;
            font-weight: 700;
            border: none;
        }

    .table tbody tr {
        transition: background-color 0.15s ease-in-out;
        font-size: 0.92rem;
    }

        .table tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.015);
        }

    .table td {
        padding-top: 0.85rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid rgba(0,0,0,0.05);
    }

    .link-portal-custom {
        color: #0d6efd;
        font-size: 0.88rem;
        transition: color 0.15s ease-in-out;
    }

        .link-portal-custom:hover {
            color: #0a58ca;
            text-decoration: underline !important;
        }

    .btn-back-hover {
        transition: color 0.15s ease-in-out;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
        }
</style>