@model ClienteBeneficio

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Cadastrar Benefício do Cliente";
}

<div class="row justify-content-center">

    <div class="card shadow border-0 rounded-4 col-10 mt-5">

        @if (TempData["MensagemSucesso"] != null)
        {
            <div id="alertaSucesso" class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div id="alertaErro" class="alert alert-danger">
                @TempData["MensagemErro"]
            </div>
        }


        <div class="card-header bg-warning text-white">

            <h4 class="mb-0">
                Editar Benefício do Cliente
            </h4>

        </div>

        <div class="card-body p-4">

            <form asp-action="Editar" method="post">
                <input asp-for="ClienteId" type="hidden" />
                <input asp-for="Id" type="hidden" />

                <div class="row">
                    <div class="col-md-6 mb-3">

                        <div class="alert alert-info">
                            Cliente:
                            <strong>@Model.Cliente.Nome</strong>
                        </div>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-3">

                        <label class="form-label">

                            Órgão

                        </label>

                        <input class="form-control"
                               value="@Model.Beneficio.Orgaos.Nome"
                               readonly />

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">

                            Benefício

                        </label>

                        <input class="form-control"
                               value="@Model.Beneficio.Descricao"
                               readonly />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">

                            Número do Benefício

                        </label>

                        <input asp-for="NumeroBeneficio"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">

                            Senha do Órgão

                        </label>

                        <input asp-for="SenhaOrgao"
                               class="form-control" />

                    </div>

                </div>

                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <button type="submit"
                            class="btn btn-success">

                        Salvar

                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="history.back()">

                        <i class="bi bi-arrow-return-left"></i>
                        Voltar

                    </button>

                </div>


            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $("#OrgaoId").change(function () {

            var orgaoId = $(this).val();

            $("#BeneficioId").empty();

            $("#BeneficioId").append(
                '<option value="">Carregando...</option>'
            );

            $.get('/ClienteBeneficio/BuscarBeneficiosPorOrgao',
                { orgaoId: orgaoId },

                function (dados) {

                    $("#BeneficioId").empty();

                    $("#BeneficioId").append(
                        '<option value="">Selecione</option>'
                    );

                    $.each(dados, function (i, beneficio) {

                        $("#BeneficioId").append(
                            `<option value="${beneficio.id}">
                                ${beneficio.codigo} - ${beneficio.descricao}
                            </option>`
                        );

                    });

                });

        });

    </script>

}

<script>
    setTimeout(function () {

        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");

    }, 3000);
</script>