@model ClienteBeneficio

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Cadastrar Benefício do Cliente";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Cadastrar Benefício</h2>
            <small class="text-muted">Vincule um novo benefício e órgão ao cadastro do cliente</small>
        </div>

    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-12">

            @if (TempData["MensagemSucesso"] != null)
            {
                <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
                    <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
                </div>
            }

            @if (TempData["MensagemErro"] != null)
            {
                <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
                </div>
            }

            <div class="card card-custom shadow-sm border-0 mb-4">

                <div class="px-4 pt-4 pb-2 m-0 bg-light border-bottom d-flex align-items-center gap-3">
                    <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px;">
                        <i class="bi bi-person fs-5"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block text-uppercase fw-bold tracking-wider" style="font-size: 0.68rem; letter-spacing: 0.5px;">Cliente Selecionado</small>
                        <span class="text-dark fw-bold fs-5">@ViewBag.ClienteSelecionado?.Nome</span>
                    </div>
                </div>

                <div class="card-body px-4 pt-4 pb-4">
                    <form asp-action="Criar" method="post">
                        <input asp-for="ClienteId" type="hidden" />

                        <div class="row g-3">

                            <div class="col-12 col-md-3">
                                <label class="text-muted d-block info-label mb-1">Órgão</label>
                                <select id="OrgaoId" class="form-select rounded-3">
                                    <option value="">Selecione</option>
                                    @if (ViewBag.orgao != null)
                                    {
                                        foreach (var orgao in ViewBag.orgao)
                                        {
                                            <option value="@orgao.Id">@orgao.Nome</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-4">
                                <label class="text-muted d-block info-label mb-1">Benefício</label>
                                <select asp-for="BeneficioId" id="BeneficioId" class="form-select rounded-3">
                                    <option value="">Selecione um órgão primeiro</option>
                                </select>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="text-muted d-block info-label mb-1">Número do Benefício (NB)</label>
                                <input asp-for="NumeroBeneficio" class="form-control rounded-3" placeholder="Insira o NB" />
                            </div>

                            <div class="col-12 col-md-2">
                                <label class="text-muted d-block info-label mb-1">Senha do Órgão</label>
                                <input asp-for="SenhaOrgao" class="form-control rounded-3" placeholder="Senha de acesso" />
                            </div>

                        </div>

                        <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-3 border-top">
                            <button type="button" onclick="history.back()" class="btn btn-light border px-4 py-2 rounded-3 text-secondary fw-semibold small">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-dark px-4 py-2 rounded-3 fw-semibold small shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Salvar Benefício
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Dispara quando o usuário troca o Órgão no Select
            $("#OrgaoId").change(function () {
                var orgaoId = $(this).val();

                // Limpa e reseta o campo de Benefício
                $("#BeneficioId").empty();

                if (!orgaoId) {
                    $("#BeneficioId").append('<option value="">Selecione um órgão primeiro</option>');
                    return;
                }

                $("#BeneficioId").append('<option value="">Carregando...</option>');

                // Define a URL base exata para o seu método BuscarBeneficiosPorOrgao
                var urlBusca = '@Url.Action("BuscarBeneficiosPorOrgao")';

                // Faz a requisição AJAX enviando o orgaoId esperado pelo seu C#
                $.get(urlBusca, { orgaoId: orgaoId }, function (dados) {

                    $("#BeneficioId").empty();
                    $("#BeneficioId").append('<option value="">Selecione</option>');

                    // Itera sobre a lista retornada pela controller
                    $.each(dados, function (i, beneficio) {

                        // Garante mapeamento seguro se as chaves JSON vierem em camelCase ou PascalCase
                        var id = beneficio.id !== undefined ? beneficio.id : beneficio.Id;
                        var codigo = beneficio.codigo !== undefined ? beneficio.codigo : beneficio.Codigo;
                        var descricao = beneficio.descricao !== undefined ? beneficio.descricao : beneficio.Descricao;

                        $("#BeneficioId").append(
                            `<option value="${id}">${codigo} - ${descricao}</option>`
                        );
                    });

                }).fail(function() {
                    $("#BeneficioId").empty().append('<option value="">Erro ao carregar benefícios</option>');
                });
            });

            // Remove mensagens de feedback automaticamente após 3 segundos
            setTimeout(function () {
                $("#alertaSucesso").fadeOut("slow");
                $("#alertaErro").fadeOut("slow");
            }, 3000);
        });
    </script>
}

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-custom {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.06);
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .form-control, .form-select {
        border: 1px solid #dee2e6;
        padding: 0.55rem 0.75rem;
        font-size: 0.92rem;
        background-color: #fff;
    }

        .form-control:focus, .form-select:focus {
            border-color: #2c3e50;
            box-shadow: 0 0 0 0.2rem rgba(44, 62, 80, 0.15);
        }
</style>