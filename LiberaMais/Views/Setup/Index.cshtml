@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Painel Principal";
}

<div class="container-fluid mt-4">

    <!-- TOPO DO PAINEL -->
    <div class="row mb-4 pt-2 align-items-center">
        <div class="col-md-8">
            <h2 class="fw-bold text-secondary mb-1" style="letter-spacing: -0.5px;">
                Configurações do Sistema
            </h2>
            <p class="text-muted mb-0 small">
                Cadastros, parâmetros administrativos e controle de acesso
            </p>
        </div>
    </div>

    <!-- GRID DE CARDS COM ALTURA AJUSTADA -->
    <div class="row g-3">

        <!-- USUÁRIOS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Usuario" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-warning-subtle text-warning mb-2">
                            <i class="bi bi-person-gear"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Usuários</h6>
                        <small class="text-muted card-desc-text">Controle de acessos</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- BANCOS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Banco" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-info-subtle text-info mb-2">
                            <i class="bi bi-bank"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Bancos</h6>
                        <small class="text-muted card-desc-text">Cadastro e controle</small>
                    </div>
                </div>
            </a>
        </div>

        @* <!-- LOGINS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="PromotoraBanco" asp-action="ListarTodosLogins" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-danger-subtle text-danger mb-2">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Logins</h6>
                        <small class="text-muted card-desc-text">Controle bancário</small>
                    </div>
                </div>
            </a>
        </div> *@

        <!-- ÓRGÃOS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Orgao" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-primary-subtle text-primary mb-2">
                            <i class="bi bi-building"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Órgãos</h6>
                        <small class="text-muted card-desc-text">Cadastro de órgãos</small>
                    </div>
                </div>
            </a>
        </div>

        <!-- BENEFÍCIOS -->
        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="Beneficio" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-success-subtle text-success mb-2">
                            <i class="bi bi-card-checklist"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Benefícios</h6>
                        <small class="text-muted card-desc-text">Cadastro de benefícios</small>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
            <a asp-controller="TaxaCoeficiente" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm card-modern-button">
                    <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center text-center">
                        <div class="icon-box-modern bg-success-subtle text-success mb-2">
                            <i class="bi bi-card-checklist"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1 card-title-text">Taxas</h6>
                        <small class="text-muted card-desc-text">Cadastros de taxas</small>
                    </div>
                </div>
            </a>
        </div>


    </div>

    <!-- RODAPÉ DE AÇÕES -->
    <div class="mt-4">
        <a asp-controller="Apps" asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Voltar ao painel
        </a>
    </div>

</div>

<style>
    /* ESTILIZAÇÃO E ALTURA DO CARD PADRONIZADA (130px) */
    .card-modern-button {
        height: 130px;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        cursor: pointer;
        border-radius: 14px !important;
        background-color: #ffffff;
    }

        .card-modern-button:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.07) !important;
        }

    /* CONTAINER DO ÍCONE CENTRALIZADO */
    .icon-box-modern {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 1.25rem;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .card-modern-button:hover .icon-box-modern {
        transform: scale(1.08);
    }

    /* AJUSTE TEXTUAL */
    .card-title-text {
        font-size: 0.95rem;
        letter-spacing: -0.1px;
    }

    .card-desc-text {
        font-size: 0.78rem;
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* CORES SUB-TOM BOOTSTRAP */
    .bg-primary-subtle {
        background-color: #e3f2fd;
    }

    .bg-success-subtle {
        background-color: #e8f5e9;
    }

    .bg-warning-subtle {
        background-color: #fffde7;
    }

    .bg-info-subtle {
        background-color: #e0f7fa;
    }

    .bg-danger-subtle {
        background-color: #ffebee;
    }

    .bg-secondary-subtle {
        background-color: #f5f5f5;
    }

    /* ESTILO BOTÃO VOLTAR */
    .btn-back-modern {
        transition: all 0.2s ease;
        background-color: #ffffff;
    }

        .btn-back-modern:hover {
            background-color: #f8f9fa;
            color: #495057 !important;
            transform: translateX(-2px);
        }
</style>