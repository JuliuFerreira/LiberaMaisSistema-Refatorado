@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Painel Principal";
}

<div class="container-fluid mt-4">

    <div class="row mb-4 mt-4 align-items-center">

        <div class="col-md-8">

            <h2 class="fw-bold text-secondary mb-0">
                Configurações do Sistema
            </h2>

            <small class="text-muted">
                Cadastros e parâmetros administrativos
            </small>

        </div>

    </div>

    <div class="row g-4">

        <!-- USUÁRIOS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Usuario"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-person-gear fs-1 text-warning"></i>
                        </div>

                        <h4 class="fw-bold text-dark">
                            Usuários
                        </h4>

                        <p class="text-muted mb-0">
                            Controle de usuários do sistema
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- BANCOS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Banco"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-bank fs-1 text-info"></i>
                        </div>

                        <h4 class="fw-bold text-dark">
                            Bancos
                        </h4>

                        <p class="text-muted mb-0">
                            Cadastro e controle de bancos
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- LOGINS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="PromotoraBanco"
               asp-action="ListarTodosLogins"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-key-fill fs-1 text-danger"></i>
                        </div>

                        <h4 class="fw-bold text-dark">
                            Logins
                        </h4>

                        <p class="text-muted mb-0">
                            Controle de logins bancários
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- ÓRGÃOS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Orgao"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-building fs-1 text-primary"></i>
                        </div>

                        <h4 class="fw-bold text-dark">
                            Órgãos
                        </h4>

                        <p class="text-muted mb-0">
                            Cadastro e controle de órgãos
                        </p>

                    </div>

                </div>

            </a>

        </div>

        <!-- BENEFÍCIOS -->
        <div class="col-lg-3 col-md-6">

            <a asp-controller="Beneficio"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card border-0 shadow-sm h-100 card-hover">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-card-checklist fs-1 text-success"></i>
                        </div>

                        <h4 class="fw-bold text-dark">
                            Benefícios
                        </h4>

                        <p class="text-muted mb-0">
                            Cadastro de benefícios por órgão
                        </p>

                    </div>

                </div>

            </a>

        </div>

    </div>

    <div class="mt-4">

        <a class="btn btn-outline-secondary"
           asp-controller="Apps"
           asp-action="Index">

            <i class="bi bi-arrow-return-left"></i>

            Voltar

        </a>

    </div>

</div>

<style>

    .card-hover {
        transition: all .25s ease;
        cursor: pointer;
    }

        .card-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 24px rgba(0,0,0,.12) !important;
        }

    .card {
        background-color: #ffffff;
        min-height: 190px;
        border-radius: 16px !important;
    }

    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .card-body i {
            transition: .25s ease;
        }

    .card-hover:hover i {
        transform: scale(1.08);
    }

    .card h4 {
        font-size: 1.5rem;
        margin-bottom: 10px;
    }

    .card p {
        font-size: .95rem;
    }

</style>
