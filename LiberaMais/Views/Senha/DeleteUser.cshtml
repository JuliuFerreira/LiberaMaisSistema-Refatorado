@{
    Layout = "_LayoutSistema";
}

    

<div class="container-flex" style="height: auto; width: auto; border: 2px solid black; padding: 20px; border-radius:10px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <h1 style="text-align:center; margin-bottom: 30px; margin-top: 30px">
        Excluir usuário
    </h1>
    
        <div style="text-align: left; width: 100%;">
            <h5>Para excluir o usuário, clique em no botão "Excluir" abaixo:</h5>
            <div style="margin-top: 30px; display: flex; gap: 10px;">
            <button style="border-radius: 10px; font-size: 18px; width: 100px" role="button" class="btn btn-outline-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                        <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                    </svg>
                    Excluir
                </button>
            <button onclick="history.go(-1)" style="border-radius: 10px; font-size: 18px; width: 100px" role="button" class="btn btn-outline-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-return-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5" />
                    </svg>
                    Voltar
                </button>
            </div>
        </div>

</div>

    

    
