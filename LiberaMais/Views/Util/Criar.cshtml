@model Util

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Adicionar Link";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Adicionar Link</h2>
            <small class="text-muted">Cadastre um novo atalho ou link útil na plataforma</small>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="card card-table shadow-sm border-0 mb-3">
        <div class="card-body p-4">
            <form id="promotoraForm" asp-controller="Util" asp-action="Criar" method="post">

                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label asp-for="Nome" class="form-label fw-semibold text-dark small">Nome</label>
                        <input asp-for="Nome" class="form-control form-control-custom" maxlength="100" placeholder="Digite o nome do link" required />
                        <span asp-validation-for="Nome" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Url" class="form-label fw-semibold text-dark small">URL de Acesso</label>
                        <input asp-for="Url" class="form-control form-control-custom font-monospace" maxlength="255" placeholder="exemplo.com.br" required />
                        <span asp-validation-for="Url" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="Descricao" class="form-label fw-semibold text-dark small">Descrição (Opcional)</label>
                        <input asp-for="Descricao" class="form-control form-control-custom" maxlength="100" placeholder="Digite a descrição do link" />
                        <span asp-validation-for="Descricao" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <hr class="my-4 opacity-50" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3 py-2 fw-medium rounded-2 small">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-sm btn-dark px-4 py-2 fw-semibold rounded-2 small shadow-sm">
                        Salvar Link
                    </button>
                </div>

            </form>
        </div>
    </div>

    <div>
        <a asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1 small btn-back-hover">
            <i class="bi bi-arrow-left"></i> Voltar para a listagem
        </a>
    </div>

</div>

<script>
    window.addEventListener('load', function() {
        setTimeout(function() {
            var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
            alertas.forEach(function(alerta) {
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(function() { alerta.style.display = "none"; }, 500);
                }
            });
        }, 3000);
    });
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.05);
        background-color: #ffffff;
    }

    .form-control-custom {
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 0.9rem;
        border: 1px solid #dee2e6;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control-custom:focus {
            border-color: #212529;
            box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.1);
            outline: 0;
        }

    .btn-back-hover {
        transition: color 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
        }
</style>