@using LiberaMais.Models.Enums
@model IEnumerable<Util>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Acessos e Links Úteis";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Acessos e Links Úteis</h2>
            <small class="text-muted">Gerencie atalhos, plataformas externas e links importantes para a equipe</small>
        </div>

        <a asp-action="Criar" class="btn btn-dark d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">
            <i class="bi bi-plus-lg"></i> <span class="fw-semibold small">Adicionar Link</span>
        </a>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-5 col-lg-4">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <div class="input-group input-group-sm shadow-sm rounded-3 overflow-hidden border">
                    <span class="input-group-text bg-white border-0 text-muted small">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="nome" value="@ViewBag.NomeAtual"
                           class="form-control border-0 small ps-1"
                           placeholder="Buscar por Nome..." />
                </div>
                <button type="submit" class="btn btn-dark btn-sm px-3 fw-semibold rounded-3 shadow-sm">Buscar</button>

                @if (!string.IsNullOrWhiteSpace(ViewBag.NomeAtual as string))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-3 d-inline-flex align-items-center justify-content-center">
                        Limpar
                    </a>
                }
            </form>
        </div>
    </div>


    <div class="card card-table shadow-sm border-0 mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Nome</th>
                            <th>Login</th>
                            <th>Senha</th>
                            <th>URL de Acesso</th>
                            <th>Descrição</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var util in Model)
                            {
                                <tr class="linha-clicavel" onclick="navegarParaEditar(event, '@Url.Action("Editar", new { id = util.Id })')">
                                    <td class="ps-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark text-copy-target">@util.Nome</span>

                                        </div>
                                    </td>
                                    <td class="ps-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark text-copy-target">@util.Login</span>

                                        </div>
                                    </td>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark text-copy-target">@util.Senha</span>

                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                                            <a href="@util.Url" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 py-1 px-2.5 text-dark shadow-sm rounded-2 fw-semibold" style="font-size: 0.85rem;">
                                                <i class="bi bi-box-arrow-up-right text-primary"></i> <span>Acessar</span>
                                            </a>
                                            <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                    onclick="copiarTexto(event, '@util.Url', this)" title="Copiar Link">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="text-muted text-truncate" style="max-width: 350px;">
                                        @(string.IsNullOrWhiteSpace(util.Descricao) ? "---" : util.Descricao)
                                    </td>
                                    <td class="text-center pe-4" onclick="event.stopPropagation();">
                                        <button class="btn btn-sm btn-outline-danger border-0" data-bs-toggle="modal" data-bs-target="#modalExcluir_@util.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@util.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title">Confirmar Exclusão</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Deseja realmente remover o link <strong>@util.Nome</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="Apagar" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@util.Id" />
                                                    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Nenhum link útil encontrado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    @if (ViewBag.TotalPaginas > 1)
    {
        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border border-light-subtle mb-4">
            @* Lado Esquerdo: Página Atual *@
            <div class="d-flex flex-column flex-sm-row gap-sm-3 text-muted small">
                <span>
                    Página <strong>@ViewBag.PaginaAtual</strong> de <strong>@ViewBag.TotalPaginas</strong>
                </span>
            </div>

            @* Lado Direito: Botões de Navegação *@
            <div class="btn-group gap-1">
                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual - 1)"
                   asp-route-nome="@ViewBag.NomeAtual"
                   class="btn btn-sm btn-outline-dark rounded-2 px-3 py-1.5 fw-medium @(ViewBag.PaginaAtual == 1 ? "disabled" : "")">
                    <i class="bi bi-chevron-left me-1"></i> Anterior
                </a>

                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual + 1)"
                   asp-route-nome="@ViewBag.NomeAtual"
                   class="btn btn-sm btn-dark rounded-2 px-3 py-1.5 fw-medium @(ViewBag.PaginaAtual == ViewBag.TotalPaginas ? "disabled" : "")">
                    Próximo <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    }


    <div>
        <a asp-controller="Apps" asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Voltar ao painel
        </a>
    </div>
</div>

<script>
    function navegarParaEditar(event, url) {
        const selecao = window.getSelection().toString();
        if (selecao.length > 0) {
            return;
        }
        if (event.target.closest('.btn-copy') || event.target.closest('.modal') || event.target.closest('a')) {
            return;
        }
        window.location.href = url;
    }

    function copiarTexto(event, texto, elemento) {
        event.stopPropagation();

        navigator.clipboard.writeText(texto).then(() => {
            const icone = elemento.querySelector('i');
            icone.className = "bi bi-check-lg text-success";

            setTimeout(() => {
                icone.className = "bi bi-clipboard text-muted";
            }, 1500);
        });
    }

    window.addEventListener('load', function() {
        setTimeout(function() {
            var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
            alertas.forEach(function(alerta) {
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(function() { alerta.style.display = "none"; }, 500);
                }
            });
        }, 3000);
    });
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .table-custom th {
        font-size: 0.82rem;
        color: #5c636a;
        padding: 14px 10px;
        text-transform: uppercase;
    }

    .table-custom td {
        padding: 14px 10px;
        font-size: 0.92rem;
    }

    .linha-clicavel {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .linha-clicavel:hover {
            background-color: rgba(0, 0, 0, 0.02) !important;
        }

    .btn-copy {
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.1s ease;
    }

    .linha-clicavel:hover .btn-copy {
        opacity: 1;
    }

    .btn-copy:active {
        transform: scale(0.85);
    }
</style>