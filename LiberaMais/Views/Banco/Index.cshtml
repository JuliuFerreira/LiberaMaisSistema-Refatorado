@using LiberaMais.Models.Enums
@model IEnumerable<Banco>

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Bancos";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 text-uppercase tracking-wide" style="font-size: 1.6rem;">
                Bancos
            </h2>
            <small class="text-muted">Gerencie as instituições bancárias integradas e atalhos de acesso</small>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 btn-adicionar shadow-sm"
               asp-action="Criar">
                <i class="bi bi-plus-lg" style="font-size: 1rem;"></i>
                <span class="fw-semibold small">Adicionar Banco</span>
            </a>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2 small">
            <i class="bi bi-check-circle-fill fs-6"></i> <span>@TempData["MensagemSucesso"]</span>
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2 small">
            <i class="bi bi-exclamation-triangle-fill fs-6"></i> <span>@TempData["MensagemErro"]</span>
        </div>
    }

    <div class="card card-table shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0" style="width: 100%">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Nome</th>
                            <th scope="col">URL de Acesso</th>
                            <th scope="col" class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var ban in Model)
                            {
                                var editarUrl = Url.Action("Editar", new { id = ban.Id });

                                <tr onclick="location.href='@editarUrl'" style="cursor: pointer;" title="Clique para editar">
                                    <td class="ps-4 fw-bold text-dark">
                                        @ban.Nome
                                    </td>

                                    <td onclick="event.stopPropagation();">
                                        <a href="https://@ban.Url" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 py-1.5 px-3 text-dark shadow-sm rounded-3 btn-link-acessar" style="font-size: 0.85rem;">
                                            <i class="bi bi-box-arrow-up-right text-primary"></i> <span class="fw-semibold">Acessar Link</span>
                                        </a>
                                    </td>

                                    <td class="pe-4" onclick="event.stopPropagation();">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-outline-danger btn-action-sm d-flex align-items-center justify-content-center"
                                                    data-bs-toggle="modal" data-bs-target="#modalExcluir_@ban.Id" title="Excluir Banco">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@ban.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered" style="max-width: 380px;">
                                        <div class="modal-content modal-custom shadow-lg border-0">
                                            <div class="modal-body text-center p-4">
                                                <div class="modal-icon-container mb-3 text-danger">
                                                    <i class="bi bi-trash3-fill fs-3"></i>
                                                </div>

                                                <h5 class="fw-bold text-dark mb-2">Excluir Banco?</h5>
                                                <p class="text-muted small mb-4 px-2">
                                                    Deseja realmente remover o banco <strong class="text-dark">@ban.Nome</strong> do sistema? Esta ação não poderá ser desfeita.
                                                </p>

                                                <div class="d-flex flex-column gap-2 w-100">
                                                    <form asp-action="Apagar" method="post" class="m-0 p-0 w-100">
                                                        <input type="hidden" name="id" value="@ban.Id" />
                                                        <button type="submit" class="btn btn-danger w-100 py-2 fw-medium btn-modal-confirm">
                                                            Confirmar Exclusão
                                                        </button>
                                                    </form>
                                                    <button type="button" class="btn btn-light w-100 py-2 fw-medium btn-modal-cancel border" data-bs-dismiss="modal">
                                                        Cancelar
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="bi bi-bank mb-2 d-block text-secondary" style="font-size: 2.2rem;"></i>
                                    Nenhum banco encontrado no sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-medium p-0 btn-back-hover"
           asp-controller="Setup" asp-action="Index">
            <i class="bi bi-arrow-left-short" style="font-size: 1.4rem;"></i> Voltar ao painel
        </a>
    </div>

</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom thead {
            background-color: #f8f9fa;
            border-bottom: 2px solid #efefef;
        }

        .table-custom th {
            font-size: 0.82rem;
            font-weight: 700;
            text-uppercase: true;
            color: #5c636a;
            padding: 14px 10px;
            letter-spacing: 0.5px;
        }

        .table-custom tbody tr {
            border-bottom: 1px solid #f1f3f5;
            transition: background-color 0.15s ease;
        }

            .table-custom tbody tr:hover {
                background-color: #f8f9fa !important;
            }

        .table-custom tbody td {
            padding: 14px 10px;
            font-size: 0.92rem;
            color: #495057;
        }

    .btn-link-acessar {
        transition: all 0.2s ease;
        background-color: #ffffff;
        border-color: #dee2e6 !important;
        border-radius: 8px !important;
    }

        .btn-link-acessar:hover {
            background-color: #f8f9fa;
            border-color: #c5c9d0 !important;
            transform: translateY(-1px);
        }

    .btn-action-sm {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .btn-adicionar {
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }

    /* ESTILIZAÇÃO DA MODAL PREMIUM MINIMALISTA */
    .modal-custom {
        border-radius: 16px !important;
        overflow: hidden;
    }

    .modal-icon-container {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        background-color: #ffebee;
        border-radius: 50%;
    }

    .btn-modal-confirm {
        font-size: 0.9rem !important;
        border-radius: 8px !important;
        background-color: #dc3545 !important;
        border: none !important;
    }

    .btn-modal-cancel {
        font-size: 0.9rem !important;
        border-radius: 8px !important;
        background-color: #f8f9fa !important;
        color: #6c757d !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        setTimeout(function () {
            const alertSucesso = document.getElementById('alertaSucesso');
            const alertErro = document.getElementById('alertaErro');

            if (alertSucesso) {
                alertSucesso.style.transition = "opacity 0.5s ease";
                alertSucesso.style.opacity = "0";
                setTimeout(() => alertSucesso.remove(), 500);
            }
            if (alertErro) {
                alertErro.style.transition = "opacity 0.5s ease";
                alertErro.style.opacity = "0";
                setTimeout(() => alertErro.remove(), 500);
            }
        }, 3000);
    });
</script>