@using LiberaMais.Models.Enums
@model IEnumerable<Banco>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Bancos";
}

<div class="container-fluid py-4 inner-system-page">

    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Bancos</h2>
            <small class="text-muted"><strong>@ViewBag.QtdBanco </strong> Bancos Cadastrados.</small>
        </div>

        <a asp-action="Criar" class="btn btn-dark d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">
            <i class="bi bi-plus-lg"></i> <span class="fw-semibold small">Adicionar Banco</span>
        </a>
    </div>

@if (TempData["MensagemSucesso"] != null)
{
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
}
@if (TempData["MensagemErro"] != null)
{
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
}

    <!-- Tabela -->
    <div class="card card-table shadow-sm border-0 mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Código / Nome</th>
                            <th>Acesso a Banco</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var banco in Model)
                            {
                                <tr class="linha-clicavel" onclick="navegarParaEditar(event, '@Url.Action("Editar", new { id = banco.Id })')">
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark">@banco.Nome</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                                            <a href="@banco.Url" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 py-1 px-2.5 text-dark shadow-sm rounded-2 fw-semibold" style="font-size: 0.85rem;">
                                                <i class="bi bi-box-arrow-up-right text-primary"></i> <span>Acessar Banco</span>
                                            </a>
                                            <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                    onclick="copiarTexto(event, '@banco.Url', this)" title="Copiar Link">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="text-center pe-4" onclick="event.stopPropagation();">
                                        <button class="btn btn-sm btn-outline-danger border-0" data-bs-toggle="modal" data-bs-target="#modalExcluir_@banco.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@banco.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title">Confirmar Exclusão</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Deseja realmente remover o registro <strong>@banco.Nome</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="Apagar" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@banco.Id" />
                                                    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Nenhum registro encontrado.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        </d>

        <div class="mt-4">
            <a asp-controller="Setup" asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i> Voltar a configuração
            </a>
        </div>
    </div>

    <script>
        window.addEventListener('load', function() {
            setTimeout(function() {
                var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
                alertas.forEach(function(alerta) {
                    if (alerta) {
                        alerta.style.transition = "opacity 0.5s ease";
                        alerta.style.opacity = "0";
                        setTimeout(function() { alerta.style.display = "none"; }, 500);
                    }
                });
            }, 3000);
        });

        function navegarParaEditar(event, url) {
            // Evita navegar se o usuário estiver apenas selecionando texto
            const selecao = window.getSelection().toString();
            if (selecao.length > 0) {
                return;
            }
            // Evita navegar se clicar em modais ou botões internos
            if (event.target.closest('.modal') || event.target.closest('button') || event.target.closest('a')) {
                return;
            }
            window.location.href = url;
        }

    </script>

    <style>
        .inner-system-page {
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        .card-table {
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .table-custom th {
            font-size: 0.82rem;
            color: #5c636a;
            padding: 14px 10px;
            text-transform: uppercase;
        }

        .table-custom td {
            padding: 14px 10px;
            font-size: 0.92rem;
        }

        .btn-outline-secondary {
            color: #6c757d;
        }

            .btn-outline-secondary:hover {
                background-color: #f1f3f5;
                color: #212529;
            }

        .linha-clicavel {
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

            .linha-clicavel:hover {
                background-color: rgba(0, 0, 0, 0.02) !important;
            }
    </style>
