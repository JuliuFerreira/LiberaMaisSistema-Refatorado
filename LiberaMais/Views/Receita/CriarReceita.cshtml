@model Receita
@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Cadastrar Receita";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="mb-4 border-bottom pb-3">
        <h2 class="fw-bold text-dark mb-1 text-uppercase tracking-wide" style="font-size: 1.6rem;">
            Nova Receita
        </h2>
        <small class="text-muted">Preencha os campos abaixo para registrar a nova receita no sistema.</small>
    </div>

    @if (TempData["mensagemErro"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2 small">
            <i class="bi bi-exclamation-triangle-fill fs-6"></i> <span>@TempData["mensagemErro"]</span>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4" style="background-color: #ffffff; border: 1px solid rgba(0, 0, 0, 0.05) !important;">
        <div class="card-body p-4">

            <form asp-controller="Receita" asp-action="CriarReceita" method="post">

                <input type="hidden" asp-for="FinancaId" />
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-3 form-group mb-3">
                        <label for="data" class="form-label fw-semibold text-secondary small">Data da Receita</label>
                        <input type="date" asp-for="DataReceita" class="form-control form-control-custom" id="data" required>
                        <span asp-validation-for="DataReceita" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 form-group mb-3">
                        <label for="descricao" class="form-label fw-semibold text-secondary small">Descrição</label>
                        <input type="text" asp-for="Descricao" class="form-control form-control-custom" id="descricao" placeholder="Ex: REPASSE MENSAL" required>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3 form-group mb-3">
                        <label for="valor" class="form-label fw-semibold text-secondary small">Valor (R$)</label>
                        <input type="number" asp-for="ValorRecebido" name="ValorRecebido" step="0.01" min="0" placeholder="0.00" class="form-control form-control-custom" id="valor" required />
                        <span asp-validation-for="ValorRecebido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-3 form-group mb-3">
                        <label for="operacao" class="form-label fw-semibold text-secondary small">Promotora</label>
                        <select id="operacao" asp-for="PromotoraId" asp-items="(SelectList)ViewBag.Promotoras" class="form-select form-control-custom" required>
                            <option value="">Selecione uma opção...</option>
                        </select>
                        <span asp-validation-for="PromotoraId" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3 form-group mb-3">
                        <label for="usuario" class="form-label fw-semibold text-secondary small">Conta</label>
                        <select id="usuario" asp-for="Usuario" asp-items="@Html.GetEnumSelectList<LiberaMais.Models.Enums.UsuarioEnum>()" class="form-select form-control-custom" required>
                            <option value="">Selecione uma opção...</option>
                        </select>
                        <span asp-validation-for="Usuario" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a class="btn btn-light border px-4 fw-medium" style="border-radius: 8px; font-size: 0.9rem;"
                       asp-controller="Receita" asp-action="Index" asp-route-idFinanca="@Model.FinancaId">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-dark px-4 fw-medium shadow-sm d-flex align-items-center gap-2" style="border-radius: 8px; font-size: 0.9rem;">
                        <i class="bi bi-floppy2-fill"></i> Gravar
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var inputData = document.getElementById('data');
        if (inputData && !inputData.value) {
            var today = new Date();
            var formattedDate = today.getFullYear() + '-' + ('0' + (today.getMonth() + 1)).slice(-2) + '-' + ('0' + today.getDate()).slice(-2);
            inputData.value = formattedDate;
        }

        var inputDescricao = document.getElementById('descricao');
        if (inputDescricao) {
            inputDescricao.addEventListener('input', function () {
                this.value = this.value.toUpperCase();
            });
        }

        var inputValor = document.getElementById('valor');
        if (inputValor) {
            inputValor.addEventListener('focus', function () {
                if (this.value === '0') {
                    this.value = '';
                }
            });
        }
    });
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .form-control-custom {
        border-radius: 8px !important;
        border: 1px solid #ced4da;
        padding: 10px 14px;
        font-size: 0.92rem;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

        .form-control-custom:focus {
            border-color: #212529;
            box-shadow: 0 0 0 0.25rem rgba(33, 37, 41, 0.1);
        }
</style>