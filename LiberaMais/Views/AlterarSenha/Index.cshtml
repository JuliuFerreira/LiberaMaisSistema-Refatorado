@using LiberaMais.Models.Enums

@model AlterarSenha

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Alterar Senha";
}

<div class="card shadow border-0 rounded-4 mt-4">
    <!-- HEADER NO PADRÃO PADRONIZADO DO SISTEMA -->
    <div class="card-header bg-dark text-white py-3">
        <h4 class="mb-0 text-center text-md-start">Alterar Senha</h4>
    </div>

    <div class="card-body p-4">
        <form id="trocarSenhaForm" asp-controller="AlterarSenha" asp-action="Alterar" method="post">

            <div class="row g-4">
                <!-- SENHA ATUAL -->
                <div class="col-md-4">
                    <label for="senhaAtual" class="form-label fw-semibold text-secondary">Senha Atual</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-shield-lock-fill"></i></span>
                        <input type="password" asp-for="SenhaAtual" class="form-control border-start-0 ps-0" id="senhaAtual" placeholder="Digite a sua senha atual">
                    </div>
                    <div class="text-danger small mt-1">
                        @Html.ValidationMessageFor(x => x.SenhaAtual)
                    </div>
                </div>

                <!-- NOVA SENHA -->
                <div class="col-md-4">
                    <label for="novaSenha" class="form-label fw-semibold text-secondary">Nova Senha</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key-fill"></i></span>
                        <input type="password" asp-for="NovaSenha" class="form-control border-start-0 ps-0" id="novaSenha" placeholder="Digite a nova senha">
                    </div>
                    <div class="text-danger small mt-1">
                        @Html.ValidationMessageFor(x => x.NovaSenha)
                    </div>
                </div>

                <!-- CONFIRMAR NOVA SENHA -->
                <div class="col-md-4">
                    <label for="confirmarSenha" class="form-label fw-semibold text-secondary">Confirmar Nova Senha</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key-fill"></i></span>
                        <input type="password" asp-for="ConfirmarNovaSenha" class="form-control border-start-0 ps-0" id="confirmarSenha" placeholder="Confirme a nova senha">
                    </div>
                    <div class="text-danger small mt-1">
                        @Html.ValidationMessageFor(x => x.ConfirmarNovaSenha)
                    </div>
                </div>
            </div>

            <!-- RODAPÉ DE AÇÕES DO FORMULÁRIO -->
            <div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2 justify-content-end">
                <a class="btn btn-outline-secondary rounded-3 px-4" asp-controller="Venda" asp-action="Index">
                    <i class="bi bi-x-circle-fill me-1"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-success rounded-3 px-4">
                    <i class="bi bi-floppy2-fill me-1"></i> Salvar Alteração
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("form#trocarSenhaForm").submit(function (event) {
                event.preventDefault(); // Impede o envio do formulário padrão

                var form = $(this);
                $.ajax({
                    type: form.attr('method'),
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function (response) {
                        if (response.success) {
                            // Mostra o diálogo de sucesso com SweetAlert2
                            Swal.fire({
                                title: 'Nova senha cadastrada com sucesso!',
                                text: 'Redirecionando...',
                                icon: 'success',
                                timer: 3000,
                                showConfirmButton: false,
                                position: 'top-center',
                                toast: true,
                                customClass: {
                                    container: 'swal2-toast-custom'
                                }
                            }).then(() => {
                                window.location.href = "@Url.Action("Venda", "Venda")";
                            });
                        } else {
                            Swal.fire({
                                title: 'Erro',
                                text: response.message,
                                icon: 'error',
                                timer: 3000,
                                showConfirmButton: false,
                                position: 'top-center',
                                toast: true,
                                customClass: {
                                    container: 'swal2-toast-custom'
                                }
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Erro',
                            text: 'Ops, ocorreu um erro. Tente novamente.',
                            icon: 'error',
                            timer: 3000,
                            showConfirmButton: false,
                            position: 'top-center',
                            toast: true,
                            customClass: {
                                container: 'swal2-toast-custom'
                            }
                        });
                    }
                });
            });
        });
    </script>
}