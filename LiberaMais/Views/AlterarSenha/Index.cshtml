@using LiberaMais.Models.Enums

@model AlterarSenha

@{
    Layout = "LayoutSistema";
}

<body>
    

    <form style="border: solid 1px black; padding:10px; border-radius: 10px" id="trocarSenhaForm" asp-controller="AlterarSenha" asp-action="Alterar" method="post" class="row g-3">
        

        <h2 style="text-align:center; margin-top: 50px; margin-bottom: 50px">ALTERAR SENHA</h2>


        <div class="col-md-4">
            <label for="senhaAtual" class="form-label">Senha atual</label>
            <input type="password" asp-for="SenhaAtual" class="form-control" id="senhaAtual" placeholder="Digite a sua senha atual">
            @Html.ValidationMessageFor(x => x.SenhaAtual)
        </div>

        <div class="col-md-4">
            <label for="novaSenha" class="form-label">Nova senha</label>
            <input type="password" asp-for="NovaSenha" class="form-control" id="novaSenha" placeholder="Digite a nova senha">
            @Html.ValidationMessageFor(x => x.NovaSenha)
        </div>

        <div class="col-md-4">
            <label for="confirmarSenha" class="form-label">Confirmar nova senha</label>
            <input type="password" asp-for="ConfirmarNovaSenha" class="form-control" id="confirmarSenha" placeholder="Confirme a nova senha">
            @Html.ValidationMessageFor(x => x.ConfirmarNovaSenha)
        </div>


        <div class="col-12">
            <button type="submit" class="btn btn-outline-success" onclick="return validarForm();">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-floppy2-fill" viewBox="0 0 16 16">
                    <path d="M12 2h-2v3h2z" />
                    <path d="M1.5 0A1.5 1.5 0 0 0 0 1.5v13A1.5 1.5 0 0 0 1.5 16h13a1.5 1.5 0 0 0 1.5-1.5V2.914a1.5 1.5 0 0 0-.44-1.06L14.147.439A1.5 1.5 0 0 0 13.086 0zM4 6a1 1 0 0 1-1-1V1h10v4a1 1 0 0 1-1 1zM3 9h10a1 1 0 0 1 1 1v5H2v-5a1 1 0 0 1 1-1" />
                </svg>
                Alterar
            </button>

            <a type="button" class="btn btn-outline-danger" asp-controller="Venda" asp-action="Venda">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293z" />
                </svg>
                Cancelar
            </a>
        </div>
    </form>

</body>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("form#trocarSenhaForm").submit(function (event) {
                event.preventDefault(); // Impede o envio do formulário padrão

                var form = $(this);
                $.ajax({
                    type: form.attr('method'),
                    url: form.attr('action'),
                    data: form.serialize(),
                    success: function (response) {
                        if (response.success) {
                            // Mostra o diálogo de sucesso com SweetAlert2
                            Swal.fire({
                                title: 'Nova senha cadastrada com sucesso!',
                                text: 'Redirecionando...',
                                icon: 'success',
                                timer: 3000, // 3 segundos
                                showConfirmButton: false,
                                position: 'top-center', // Alerta aparece na parte superior central
                                toast: true, // Exibe como um toast (pequeno, não modal)
                                customClass: {
                                    container: 'swal2-toast-custom' // Aplica a classe customizada ao toast
                                }
                            }).then(() => {
                                // Redireciona para a view Clientes após 3 segundos
                                window.location.href = "@Url.Action("Venda", "Venda")";
                            });
                        } else {
                            Swal.fire({
                                title: 'Erro',
                                text: response.message,
                                icon: 'error',
                                timer: 3000, // 3 segundos
                                showConfirmButton: false,
                                position: 'top-center', // Alerta aparece na parte superior central
                                toast: true, // Exibe como um toast (pequeno, não modal)
                                customClass: {
                                    container: 'swal2-toast-custom' // Aplica a classe customizada ao toast
                                }
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: 'Erro',
                            text: 'Ops, ocorreu um erro. Tente novamente.',
                            icon: 'error',
                            timer: 3000, // 3 segundos
                            showConfirmButton: false,
                            position: 'top-center', // Alerta aparece na parte superior central
                            toast: true, // Exibe como um toast (pequeno, não modal)
                            customClass: {
                                container: 'swal2-toast-custom' // Aplica a classe customizada ao toast
                            }
                        });
                    }
                });
            });
        });
    </script>
}