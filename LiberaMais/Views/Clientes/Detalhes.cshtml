@model ClienteEnderecoViewModel

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Detalhes do Cliente";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Detalhes do Cliente</h2>
            <small class="text-muted">Visualize os dados cadastrais, endereço e histórico de benefícios do cliente</small>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Venda" asp-action="Criar" asp-route-clienteId="@Model.Cliente.Id"
               class="btn btn-success d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">
                <i class="bi bi-cart-plus"></i> <span class="fw-semibold small">Nova Venda</span>
            </a>

            <a asp-action="Editar" asp-route-id="@Model.Cliente.Id"
               class="btn btn-dark d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">
                <i class="bi bi-pencil-square"></i> <span class="fw-semibold small">Editar Cadastro</span>
            </a>
        </div>
    </div>
    
    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="card card-custom shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <span class="text-dark fw-bold fs-5">
                <i class="bi bi-person text-secondary me-2"></i> Dados Pessoais
            </span>
        </div>
        <div class="card-body px-4 pt-3 pb-4">
            <div class="row g-3">
                <div class="col-6 col-md-3 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">Nome Completo</small>
                    <div class="text-dark fw-bold">@Model.Cliente.Nome</div>
                </div>

                <div class="col-6 col-md-3 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">CPF</small>
                    <div class="text-dark fw-medium">@Model.Cliente.Cpf</div>
                </div>

                <div class="col-6 col-md-3 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">Telefone</small>
                    <div class="text-dark fw-medium">@Model.Cliente.Fone</div>
                </div>

                <div class="col-6 col-md-3 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">Data de Nascimento</small>
                    <div class="text-dark fw-medium">
                        @Model.Cliente.DataNascimento?.ToString("dd/MM/yyyy")
                    </div>
                </div>

                <div class="col-12 col-md-4 mt-3">
                    <small class="text-muted d-block info-label mb-1">E-mail</small>
                    <div class="text-dark fw-medium">@Model.Cliente.Email</div>
                </div>

                <div class="col-12 col-md-8 mt-3">
                    <small class="text-muted d-block info-label mb-1">Observações internas</small>
                    <div class="text-secondary bg-light rounded-3 p-3 small font-monospace border border-light">
                        @(string.IsNullOrWhiteSpace(Model.Cliente.Observacoes) ? "Nenhuma observação registrada." : Model.Cliente.Observacoes)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-custom shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <span class="text-dark fw-bold fs-5">
                <i class="bi bi-geo-alt text-secondary me-2"></i> Endereço Residencial
            </span>
        </div>
        <div class="card-body px-4 pt-3 pb-4">
            <div class="row g-3">
                <div class="col-6 col-md-2 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">CEP</small>
                    <div class="text-dark fw-medium">@Model.Endereco?.Cep</div>
                </div>

                <div class="col-12 col-md-5 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">Logradouro (Rua/Av)</small>
                    <div class="text-dark fw-medium">@Model.Endereco?.Rua</div>
                </div>

                <div class="col-6 col-md-2 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">Número</small>
                    <div class="text-dark fw-medium">@Model.Endereco?.Numero</div>
                </div>

                <div class="col-6 col-md-3 info-divider pb-2">
                    <small class="text-muted d-block info-label mb-1">Bairro</small>
                    <div class="text-dark fw-medium">@Model.Endereco?.Bairro</div>
                </div>

                <div class="col-6 col-md-4 mt-3">
                    <small class="text-muted d-block info-label mb-1">Cidade</small>
                    <div class="text-dark fw-medium">@Model.Endereco?.Cidade</div>
                </div>

                <div class="col-6 col-md-2 mt-3">
                    <small class="text-muted d-block info-label mb-1">UF / Estado</small>
                    <div class="text-dark fw-medium">@Model.Endereco?.Estado</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-custom shadow-sm border-0 mb-4">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-3 d-flex justify-content-between align-items-center">
            <span class="text-dark fw-bold fs-5">
                <i class="bi bi-credit-card text-secondary me-2"></i> Benefícios Ativos
            </span>
            <a asp-controller="ClienteBeneficio" asp-action="Criar" asp-route-clienteId="@Model.Cliente.Id"
               class="btn btn-dark btn-sm rounded-3 px-3 fw-semibold small d-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Adicionar Benefício
            </a>
        </div>

        <div class="card-body p-0">
            @if (Model.Cliente.ClienteBeneficios != null && Model.Cliente.ClienteBeneficios.Any())
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Órgão</th>
                                <th class="ps-4">Acesso ao Portal</th>
                                <th>Benefício</th>
                                <th>NB (Número)</th>
                                <th>Senha do Órgão</th>
                                <th class="text-center pe-4">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Cliente.ClienteBeneficios)
                            {
                                <tr class="linha-clicavel" onclick="navegarParaEditar(event, '@Url.Action("Editar", "ClienteBeneficio", new { id = item.Id })')">
                                    <td class="ps-4 text-secondary fw-semibold">@item.Beneficio?.Orgaos?.Nome</td>

                                    <td onclick="event.stopPropagation();">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (item.Beneficio?.Orgaos != null && !string.IsNullOrEmpty(item.Beneficio.Orgaos.Url))
                                            {
                                                <a href="@item.Beneficio.Orgaos.Url" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 py-1 px-2.5 text-dark shadow-sm rounded-2 fw-semibold" style="font-size: 0.85rem;">
                                                    <i class="bi bi-box-arrow-up-right text-primary"></i> <span>Acessar Portal</span>
                                                </a>
                                                <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                        onclick="copiarTexto(event, '@item.Beneficio.Orgaos.Url', this)" title="Copiar Link">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic">-</span>
                                            }
                                        </div>
                                    </td>

                                    <td class="fw-bold text-dark">@item.Beneficio?.Descricao</td>
                                    <td class="font-monospace">@item.NumeroBeneficio</td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(item.SenhaOrgao))
                                            {
                                                <span class="badge bg-light text-dark border px-2 py-1 font-monospace" style="font-size: 0.8rem;">
                                                    @item.SenhaOrgao
                                                </span>
                                                <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                        onclick="copiarTexto(event, '@item.SenhaOrgao', this)" title="Copiar Senha">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-muted small italic">-</span>
                                            }
                                        </div>
                                    </td>

                                    <td class="text-center pe-4" onclick="event.stopPropagation();">
                                        <button class="btn btn-sm btn-outline-danger border-0 px-2 py-1" data-bs-toggle="modal" data-bs-target="#modalExcluir_@item.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@item.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold">Confirmar Exclusão</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body py-3">
                                                Deseja realmente remover o benefício <strong>@item.Beneficio?.Descricao</strong> vinculado a este cliente?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-controller="ClienteBeneficio" asp-action="Apagar" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5 mx-4 mb-4 bg-light rounded-3 border border-dashed">
                    <i class="bi bi-credit-card-2-back display-6 d-block mb-2 opacity-50"></i>
                    <p class="mb-0 small fw-medium">Este cliente ainda não possui benefícios cadastrados.</p>
                </div>
            }
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Clientes" asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1 btn-back-hover">
            <i class="bi bi-arrow-left"></i> Voltar a clientes
        </a>
    </div>
</div>

<script>
    // Função para evitar que o clique no botão ou seleção de texto ativem o clique na linha
    function navegarParaEditar(event, url) {
        const selecao = window.getSelection().toString();
        if (selecao.length > 0) {
            return;
        }
        if (event.target.closest('.btn-copy') || event.target.closest('.modal')) {
            return;
        }
        window.location.href = url;
    }

    // Função para copiar a senha
    function copiarTexto(event, texto, elemento) {
        event.stopPropagation(); // Impede que o clique na linha seja disparado

        if (!texto) return;

        navigator.clipboard.writeText(texto).then(() => {
            const icone = elemento.querySelector('i');
            icone.className = "bi bi-check-lg text-success";

            setTimeout(() => {
                icone.className = "bi bi-clipboard text-muted";
            }, 1500);
        }).catch(err => {
            console.error('Erro ao copiar: ', err);
        });
    }

    window.addEventListener('load', function() {
        setTimeout(function() {
            var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
            alertas.forEach(function(alerta) {
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(function() { alerta.style.display = "none"; }, 500);
                }
            });
        }, 3000);
    });
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-custom {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .table-custom th {
        font-size: 0.82rem;
        color: #5c636a;
        padding: 14px 10px;
        text-transform: uppercase;
        font-weight: 600;
    }

    .table-custom td {
        padding: 14px 10px;
        font-size: 0.92rem;
    }

    .linha-clicavel {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .linha-clicavel:hover {
            background-color: #f8f9fa !important;
        }

    /* Botão de cópia discreto que acende ao passar o mouse */
    .btn-copy {
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.1s ease;
        text-decoration: none !important;
    }

    .linha-clicavel:hover .btn-copy {
        opacity: 1;
    }

    .btn-copy:active {
        transform: scale(0.85);
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .info-divider {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }
</style>