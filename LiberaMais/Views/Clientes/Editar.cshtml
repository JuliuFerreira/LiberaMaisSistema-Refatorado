@model ClienteEnderecoViewModel

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Editar Cliente";
}

<div class="row justify-content-center">

    <h2 class="mt-5">Cadastrar Cliente</h2>

    @if (TempData["mensagemSucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["mensagemSucesso"]
        </div>
    }

    @if (TempData["mensagemErro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["mensagemErro"]
        </div>
    }

    <form asp-action="Editar" method="post">
       
        <input type="hidden" asp-for="Cliente.Id" />
        <input type="hidden" asp-for="Endereco.Id" />
        <input type="hidden" asp-for="Endereco.ClienteId" />

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">
                Dados do Cliente
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="row">
                        @if (ViewBag.IsAdmin)
                        {
                            <div class="col-md-4 mb-3">

                                <label>Usuário</label>

                                <select asp-for="Cliente.UsuarioId"
                                        class="form-select"
                                        asp-items='@(new SelectList(ViewBag.Usuarios, "Id", "Nome"))'>

                                    <option value="">Selecione</option>

                                </select>

                                <span asp-validation-for="Cliente.UsuarioId"
                                      class="text-danger"></span>

                            </div>
                        }
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Nome</label>

                        <input asp-for="Cliente.Nome"
                               class="form-control" />

                        <span asp-validation-for="Cliente.Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>CPF</label>

                        <input asp-for="Cliente.Cpf"
                               class="form-control" readonly/>

                        <span asp-validation-for="Cliente.Cpf"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Telefone</label>

                        <input asp-for="Cliente.Fone"
                               class="form-control" />

                        <span asp-validation-for="Cliente.Fone"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label>Data Nascimento</label>

                        <input asp-for="Cliente.DataNascimento"
                               type="date"
                               class="form-control" readonly />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Email</label>

                        <input asp-for="Cliente.Email"
                               class="form-control" />
                    </div>

                </div>

                <div class="mb-3">
                    <label>Observações</label>

                    <textarea asp-for="Cliente.Observacoes"
                              class="form-control"></textarea>
                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-secondary text-white">
                Endereço
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label>CEP</label>

                        <input asp-for="Endereco.Cep"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Rua</label>

                        <input asp-for="Endereco.Rua"
                               class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Número</label>

                        <input asp-for="Endereco.Numero"
                               class="form-control" />
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label>Bairro</label>

                        <input asp-for="Endereco.Bairro"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Cidade</label>

                        <input asp-for="Endereco.Cidade"
                               class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Estado</label>

                        <input asp-for="Endereco.Estado"
                               class="form-control" />
                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-success">
                Salvar
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}