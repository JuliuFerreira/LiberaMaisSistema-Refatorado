@model ClienteEnderecoViewModel

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Editar Cliente";
}

<div class="row justify-content-center">

    <div class="justify-content-center align-items-center mb-4 mt-4 mt-5">

        <div class="card-header text-white rounded-top-4"
             style="background-color:orange;">

            <h3 class="text-center mb-0">
                Editar Cliente
            </h3>

        </div>

    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger">
            @TempData["MensagemErro"]
        </div>
    }


    <form asp-action="Editar" method="post">
       
        <input type="hidden" asp-for="Cliente.Id" />
        <input type="hidden" asp-for="Endereco.Id" />
        <input type="hidden" asp-for="Endereco.ClienteId" />

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-info text-white">
                Dados do Cliente
            </div>

            <div class="card-body">

                <div class="row">
                                    

                    <div class="row">
                        @if (ViewBag.IsAdmin)
                        {
                            <div class="col-md-4 mb-3">

                                <label>Usuário</label>

                                <select asp-for="Cliente.UsuarioId"
                                        class="form-select"
                                        asp-items='@(new SelectList(ViewBag.Usuarios, "Id", "Nome", Model.Cliente.UsuarioId))'>
                                </select>
                                <span asp-validation-for="Cliente.UsuarioId"
                                      class="text-danger"></span>

                            </div>
                        }
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Nome</label>

                        <input asp-for="Cliente.Nome"
                               class="form-control" />

                        <span asp-validation-for="Cliente.Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>CPF</label>

                        <input asp-for="Cliente.Cpf"
                               class="form-control" readonly/>

                        <span asp-validation-for="Cliente.Cpf"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Telefone</label>

                        <input asp-for="Cliente.Fone"
                               class="form-control"
                               id="telefone" />

                        <span asp-validation-for="Cliente.Fone"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label>Data Nascimento</label>

                        <input asp-for="Cliente.DataNascimento"
                               type="date"
                               class="form-control" readonly />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Email</label>

                        <input asp-for="Cliente.Email"
                               class="form-control" />
                    </div>

                </div>

                <div class="mb-3">
                    <label>Observações</label>

                    <textarea asp-for="Cliente.Observacoes"
                              class="form-control"></textarea>
                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-secondary text-white">
                Endereço
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label>CEP</label>

                        <input asp-for="Endereco.Cep"
                               class="form-control"
                               id="cep"/>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Rua</label>

                        <input asp-for="Endereco.Rua"
                               class="form-control"
                               id="rua"/>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Número</label>

                        <input asp-for="Endereco.Numero"
                               class="form-control" />
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label>Bairro</label>

                        <input asp-for="Endereco.Bairro"
                               class="form-control"
                               id="bairro"/>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Cidade</label>

                        <input asp-for="Endereco.Cidade"
                               class="form-control"
                               id="cidade"/>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Estado</label>

                        <input asp-for="Endereco.Estado"
                               class="form-control"
                               id="estado"/>
                    </div>

                </div>

            </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">

            <button type="submit"
                    class="btn btn-success">
                Salvar
            </button>

            <a asp-action="Detalhes"
               asp-route-id="@Model.Cliente.Id"
               class="btn btn-secondary">
                <i class="bi bi-arrow-return-left"></i>
                Voltar
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<script>

    setTimeout(function () {

        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");

    }, 3000);

</script>

