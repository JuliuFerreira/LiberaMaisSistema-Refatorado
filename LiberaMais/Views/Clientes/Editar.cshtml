@model ClienteEnderecoViewModel

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Editar Cliente";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Editar Cliente</h2>
            <small class="text-muted">Altere as informações cadastrais e de endereço do cliente</small>
        </div>

    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
    }

    <form asp-action="Editar" method="post">

        <input type="hidden" asp-for="Cliente.Id" />
        <input type="hidden" asp-for="Endereco.Id" />
        <input type="hidden" asp-for="Endereco.ClienteId" />

        <div class="card card-custom shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <span class="text-dark fw-bold fs-5">
                    <i class="bi bi-person text-secondary me-2"></i> Dados do Cliente
                </span>
            </div>

            <div class="card-body px-4 pt-3 pb-4">
                <div class="row g-3">

                    @if (ViewBag.IsAdmin)
                    {
                        <div class="col-12 info-divider pb-2 mb-2">
                            <label class="text-muted d-block info-label mb-1">Usuário / Responsável</label>
                            <select asp-for="Cliente.UsuarioId" class="form-select rounded-3" style="max-width: 350px;"
                                    asp-items='@(new SelectList(ViewBag.Usuarios, "Id", "Nome", Model.Cliente.UsuarioId))'>
                            </select>
                            <span asp-validation-for="Cliente.UsuarioId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    }

                    <div class="col-12 col-md-6">
                        <label class="text-muted d-block info-label mb-1">Nome Completo</label>
                        <input asp-for="Cliente.Nome" class="form-control rounded-3" />
                        <span asp-validation-for="Cliente.Nome" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="text-muted d-block info-label mb-1">CPF (Somente Leitura)</label>
                        <input asp-for="Cliente.Cpf" class="form-control rounded-3 bg-light text-muted" readonly />
                        <span asp-validation-for="Cliente.Cpf" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="text-muted d-block info-label mb-1">Telefone</label>
                        <input asp-for="Cliente.Fone" class="form-control rounded-3" id="telefone" oninput="mascaraTelefone(this)" maxlength="15" />
                        <span asp-validation-for="Cliente.Fone" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-6 col-md-4 mt-3">
                        <label class="text-muted d-block info-label mb-1">Data de Nascimento (Somente Leitura)</label>
                        <input asp-for="Cliente.DataNascimento" type="date" class="form-control rounded-3 bg-light text-muted" readonly />
                    </div>

                    <div class="col-6 col-md-8 mt-3">
                        <label class="text-muted d-block info-label mb-1">E-mail</label>
                        <input asp-for="Cliente.Email" class="form-control rounded-3" />
                    </div>

                    <div class="col-12 mt-3">
                        <label class="text-muted d-block info-label mb-1">Observações Internas</label>
                        <textarea asp-for="Cliente.Observacoes" class="form-control rounded-3 font-monospace small" rows="4"></textarea>
                    </div>

                </div>
            </div>
        </div>

        <div class="card card-custom shadow-sm border-0 mb-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <span class="text-dark fw-bold fs-5">
                    <i class="bi bi-geo-alt text-secondary me-2"></i> Endereço Residencial
                </span>
            </div>

            <div class="card-body px-4 pt-3 pb-4">
                <div class="row g-3">

                    <div class="col-6 col-md-2">
                        <label class="text-muted d-block info-label mb-1">CEP</label>
                        <div class="position-relative">
                            <input asp-for="Endereco.Cep" class="form-control rounded-3" id="cep" oninput="mascaraCEP(this)" maxlength="9" />
                            <div id="cepSpinner" class="spinner-border spinner-border-sm text-secondary position-absolute d-none" style="top: 13px; right: 12px;" role="status"></div>
                        </div>
                        <span asp-validation-for="Endereco.Cep" class="text-danger small d-block mt-1" id="cepErro"></span>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="text-muted d-block info-label mb-1">Logradouro (Rua/Av)</label>
                        <input asp-for="Endereco.Rua" class="form-control rounded-3" id="rua" />
                        <span asp-validation-for="Endereco.Rua" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="text-muted d-block info-label mb-1">Número</label>
                        <input asp-for="Endereco.Numero" class="form-control rounded-3" id="numero" />
                        <span asp-validation-for="Endereco.Numero" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-md-5">
                        <label class="text-muted d-block info-label mb-1">Complemento</label>
                        <input asp-for="Endereco.Complemento" class="form-control rounded-3" id="complemento" placeholder="casa 1, ap 01..." />
                        <span asp-validation-for="Endereco.Complemento" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="col-6 col-md-4 mt-3">
                        <label class="text-muted d-block info-label mb-1">Bairro</label>
                        <input asp-for="Endereco.Bairro" class="form-control rounded-3" id="bairro" />
                        <span asp-validation-for="Endereco.Bairro" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-6 col-md-5 mt-3">
                        <label class="text-muted d-block info-label mb-1">Cidade</label>
                        <input asp-for="Endereco.Cidade" class="form-control rounded-3" id="cidade" />
                        <span asp-validation-for="Endereco.Cidade" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-6 col-md-3 mt-3">
                        <label class="text-muted d-block info-label mb-1">UF / Estado</label>
                        <input asp-for="Endereco.Estado" class="form-control rounded-3 text-uppercase" maxlength="2" id="estado" />
                        <span asp-validation-for="Endereco.Estado" class="text-danger small mt-1 d-block"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pb-5">
            <a asp-action="Detalhes" asp-route-id="@Model.Cliente.Id" class="btn btn-light border px-4 py-2 rounded-3 text-secondary fw-semibold small">
                Cancelar
            </a>
            <button type="submit" class="btn btn-dark px-4 py-2 rounded-3 fw-semibold small shadow-sm">
                <i class="bi bi-check-lg me-1"></i> Salvar Alterações
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function mascaraTelefone(input) {
            let v = input.value.replace(/\D/g, "");
            v = v.replace(/^(\d{2})(\d)/g, "($1) $2");
            v = v.replace(/(\dwp?)(\d{4})$/, "$1-$2");
            v = v.replace(/(\d)(\d{4})$/, "$1-$2");
            input.value = v;
        }

        function mascaraCEP(input) {
            let v = input.value.replace(/\D/g, "");
            v = v.replace(/^(\d{5})(\d)/, "$1-$2");
            input.value = v;
        }

        $(document).ready(function () {
            // Formata o telefone e CEP logo que a página carrega os dados do banco
            var telInput = document.getElementById("telefone");
            var cepInput = document.getElementById("cep");
            if(telInput && telInput.value) mascaraTelefone(telInput);
            if(cepInput && cepInput.value) mascaraCEP(cepInput);

            // Remove mensagens de feedback automaticamente após 3 segundos
            setTimeout(function () {
                var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
                alertas.forEach(function(alerta) {
                    if (alerta) {
                        alerta.style.transition = "opacity 0.5s ease";
                        alerta.style.opacity = "0";
                        setTimeout(function() { alerta.style.display = "none"; }, 500);
                    }
                });
            }, 3000);

            // --- SCRIPT DE PREENCHIMENTO AUTOMÁTICO DE CEP ---
            function limpaFormularioCep() {
                $("#rua").val("");
                $("#bairro").val("");
                $("#cidade").val("");
                $("#estado").val("");
                $("#cepErro").text("");
            }

            $("#cep").blur(function () {
                var cep = $(this).val().replace(/\D/g, '');

                if (cep !== "") {
                    var validaCep = /^[0-9]{8}$/;

                    if (validaCep.test(cep)) {
                        $("#cepSpinner").removeClass("d-none");
                        $("#cepErro").text("");

                        $.getJSON("https://viacep.com.br/ws/" + cep + "/json/?callback=?", function (dados) {
                            $("#cepSpinner").addClass("d-none");

                            if (!("erro" in dados)) {
                                $("#rua").val(dados.logradouro);
                                $("#bairro").val(dados.bairro);
                                $("#cidade").val(dados.localidade);
                                $("#estado").val(dados.uf);
                                $("#numero").focus();
                            } else {
                                limpaFormularioCep();
                                $("#cepErro").text("CEP não encontrado.");
                            }
                        }).fail(function() {
                            $("#cepSpinner").addClass("d-none");
                            $("#cepErro").text("Erro ao buscar o CEP. Tente digitar manualmente.");
                        });
                    } else {
                        limpaFormularioCep();
                        $("#cepErro").text("Formato de CEP inválido.");
                    }
                } else {
                    limpaFormularioCep();
                }
            });
        });
    </script>
}

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-custom {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .info-divider {
        border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .form-control, .form-select {
        border: 1px solid #dee2e6;
        padding: 0.55rem 0.75rem;
        font-size: 0.92rem;
        background-color: #fff;
    }

        .form-control:focus, .form-select:focus {
            border-color: #2c3e50;
            box-shadow: 0 0 0 0.2rem rgba(44, 62, 80, 0.15);
        }
</style>