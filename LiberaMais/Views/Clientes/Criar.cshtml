    @model ClienteEnderecoViewModel

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Cadastrar Cliente";    
}

<div class="row justify-content-center">

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger">
            @TempData["MensagemErro"]
        </div>
    }

    <div class="justify-content-center align-items-center mb-4 mt-4 mt-5">

        <div class="card-header text-white rounded-top-4"
             style="background-color:green;">

            <h3 class="text-center mb-0">
                Cadastrar Cliente
            </h3>

        </div>

    </div>
       

    <form asp-action="Criar" method="post">

        <div class="card shadow-sm mb-4">
                        
            <div class="card-header bg-success text-white">
                Dados do Cliente
            </div>


            <div class="card-body">

                <div class="row">
                    <div class="row">
                        <div class="col-md-2">

                            <label class="form-label fw-bold">
                                Usuário
                            </label>

                            <select asp-for="Cliente.UsuarioId"
                                    class="form-select">

                                <option value="">
                                    Selecione
                                </option>

                                @foreach (var user in ViewBag.Usuarios)
                                {
                                    <option value="@user.Id">
                                        @user.Nome
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="Cliente.UsuarioId"
                                  class="text-danger">
                            </span>

                        </div>
                    </div>
                                       
                    <div class="col-md-6 mb-3">
                        <label>Nome</label>

                        <input asp-for="Cliente.Nome"
                               class="form-control"
                               maxlength="200"
                               placeholder="Nome do cliente" />

                        <span asp-validation-for="Cliente.Nome"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>CPF</label>

                        <input asp-for="Cliente.Cpf"
                               class="form-control"
                               minlength="14"
                               maxlength="14"
                               placeholder="CPF do clietne"
                               id="cpf" />

                        <span asp-validation-for="Cliente.Cpf"
                              class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label>Telefone</label>

                        <input asp-for="Cliente.Fone"
                               class="form-control"
                               maxlength="20"
                               placeholder="Insira o telefone/WhatsApp"
                               id="telefone"
                               />

                        <span asp-validation-for="Cliente.Fone"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label>Data Nascimento</label>

                        <input asp-for="Cliente.DataNascimento"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Cliente.DataNascimento"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Email</label>

                        <input asp-for="Cliente.Email"
                               class="form-control"
                               placeholder="Digite um Email" />
                        <span asp-validation-for="Cliente.Email"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="mb-3">
                    <label>Observações</label>

                    <textarea asp-for="Cliente.Observacoes"
                              class="form-control"></textarea>
                </div>

            </div>

        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-secondary text-white">
                Endereço
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-3 mb-3">
                        <label>CEP</label>

                        <input asp-for="Endereco.Cep"
                               class="form-control"
                               id="cep" 
                               placeholder="Digite o CEP do cliente" />
                        <span asp-validation-for="Endereco.Cep"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Rua</label>

                        <input asp-for="Endereco.Rua"
                               class="form-control"
                               placeholder="Digite a Rua"
                               id="rua"/>
                        <span asp-validation-for="Endereco.Rua"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3 mb-3">
                        <label>Número</label>

                        <input asp-for="Endereco.Numero"
                               class="form-control"
                               placeholder="Digite o número da casa"
                               id="numero"/>
                        <span asp-validation-for="Endereco.Numero"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label>Bairro</label>

                        <input asp-for="Endereco.Bairro"
                               class="form-control"
                               placeholder="Digite o Bairro"
                               id="bairro"/>
                        <span asp-validation-for="Endereco.Bairro"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label>Cidade</label>

                        <input asp-for="Endereco.Cidade"
                               class="form-control"
                               placeholder="Digite a Cidade"
                               id="cidade"/>
                        <span asp-validation-for="Endereco.Cidade"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-2 mb-3">
                        <label>Estado</label>

                        <input asp-for="Endereco.Estado"
                               class="form-control"
                               maxlength="2"
                               placeholder="Digite o Estado (Apenas singla)"
                               id="estado"/>
                        <span asp-validation-for="Endereco.Estado"
                              class="text-danger"></span>
                    </div>

                </div>

            </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">

            <button type="submit"
                    class="btn btn-success">
                Salvar
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
}


<script>

    setTimeout(function () {

        $("#alertaSucesso").fadeOut("slow");
    $("#alertaErro").fadeOut("slow");

    }, 3000);

</script>

