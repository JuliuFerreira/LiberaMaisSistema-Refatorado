@model ClienteEnderecoViewModel

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Cadastrar Cliente";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Cadastrar Cliente</h2>
            <small class="text-muted">Insira os dados cadastrais e o endereço residencial do novo cliente</small>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-12">

            @if (TempData["MensagemSucesso"] != null)
            {
                <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
                    <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
                </div>
            }

            @if (TempData["MensagemErro"] != null)
            {
                <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
                    <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
                </div>
            }

            <form asp-action="Criar" method="post">

                <div class="card card-custom shadow-sm border-0 mb-4">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <span class="text-dark fw-bold fs-5">
                            <i class="bi bi-person text-secondary me-2"></i> Dados Pessoais
                        </span>
                    </div>

                    <div class="card-body px-4 pt-3 pb-4">
                        <div class="row g-3">

                            <div class="col-12 col-md-3">
                                <label class="text-muted d-block info-label mb-1">Atribuir ao Usuário</label>
                                <select asp-for="Cliente.UsuarioId" class="form-select rounded-3">
                                    <option value="">Selecione um usuário...</option>
                                    @if (ViewBag.Usuarios != null)
                                    {
                                        foreach (var user in ViewBag.Usuarios)
                                        {
                                            <option value="@user.Id">@user.Nome</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="Cliente.UsuarioId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-5">
                                <label class="text-muted d-block info-label mb-1">Nome Completo</label>
                                <input asp-for="Cliente.Nome" class="form-control rounded-3" maxlength="200" placeholder="Nome completo do cliente" />
                                <span asp-validation-for="Cliente.Nome" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-2">
                                <label class="text-muted d-block info-label mb-1">CPF</label>
                                <input asp-for="Cliente.Cpf" class="form-control rounded-3" minlength="14" maxlength="14" placeholder="000.000.000-00" id="cpf" oninput="mascaraCPF(this)" />
                                <span asp-validation-for="Cliente.Cpf" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-2">
                                <label class="text-muted d-block info-label mb-1">Telefone / WhatsApp</label>
                                <input asp-for="Cliente.Fone" class="form-control rounded-3" maxlength="15" placeholder="(00) 00000-0000" id="telefone" oninput="mascaraTelefone(this)" />
                                <span asp-validation-for="Cliente.Fone" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-4 mt-2">
                                <label class="text-muted d-block info-label mb-1">Data de Nascimento</label>
                                <input asp-for="Cliente.DataNascimento" type="date" class="form-control rounded-3" />
                                <span asp-validation-for="Cliente.DataNascimento" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-8 mt-2">
                                <label class="text-muted d-block info-label mb-1">Endereço de E-mail</label>
                                <input asp-for="Cliente.Email" type="email" class="form-control rounded-3" placeholder="exemplo@email.com" />
                                <span asp-validation-for="Cliente.Email" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 mt-2">
                                <label class="text-muted d-block info-label mb-1">Observações Internas</label>
                                <textarea asp-for="Cliente.Observacoes" class="form-control rounded-3" rows="3" placeholder="Instruções ou observações particulares deste cliente..."></textarea>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="card card-custom shadow-sm border-0 mb-4">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                        <span class="text-dark fw-bold fs-5">
                            <i class="bi bi-geo-alt text-secondary me-2"></i> Endereço Residencial
                        </span>
                    </div>

                    <div class="card-body px-4 pt-3 pb-4">
                        <div class="row g-3">

                            <div class="col-12 col-md-2">
                                <label class="text-muted d-block info-label mb-1">CEP</label>
                                <div class="position-relative">
                                    <input asp-for="Endereco.Cep" class="form-control rounded-3" id="cep" maxlength="9" placeholder="00000-000" oninput="mascaraCEP(this)" />
                                    <div id="cepSpinner" class="spinner-border spinner-border-sm text-secondary position-absolute d-none" style="top: 13px; right: 12px;" role="status"></div>
                                </div>
                                <span asp-validation-for="Endereco.Cep" class="text-danger small d-block mt-1" id="cepErro"></span>
                            </div>

                            <div class="col-12 col-md-3">
                                <label class="text-muted d-block info-label mb-1">Logradouro (Rua / Avenida)</label>
                                <input asp-for="Endereco.Rua" class="form-control rounded-3" id="rua" placeholder="Rua, Avenida, Travessa..." />
                                <span asp-validation-for="Endereco.Rua" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-2">
                                <label class="text-muted d-block info-label mb-1">Número</label>
                                <input asp-for="Endereco.Numero" class="form-control rounded-3" id="numero" placeholder="Nº ou Km" />
                                <span asp-validation-for="Endereco.Numero" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-5">
                                <label class="text-muted d-block info-label mb-1">Complemento</label>
                                <input asp-for="Endereco.Complemento" class="form-control rounded-3" id="complemento" placeholder="casa 1, ap 01..." />
                                <span asp-validation-for="Endereco.Complemento" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-5 mt-2">
                                <label class="text-muted d-block info-label mb-1">Bairro</label>
                                <input asp-for="Endereco.Bairro" class="form-control rounded-3" id="bairro" placeholder="Nome do bairro" />
                                <span asp-validation-for="Endereco.Bairro" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-5 mt-2">
                                <label class="text-muted d-block info-label mb-1">Cidade</label>
                                <input asp-for="Endereco.Cidade" class="form-control rounded-3" id="cidade" placeholder="Nome da cidade" />
                                <span asp-validation-for="Endereco.Cidade" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 col-md-2 mt-2">
                                <label class="text-muted d-block info-label mb-1">UF / Estado</label>
                                <input asp-for="Endereco.Estado" class="form-control rounded-3 text-uppercase" maxlength="2" id="estado" placeholder="Ex: SP" />
                                <span asp-validation-for="Endereco.Estado" class="text-danger small d-block mt-1"></span>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end align-items-center gap-2 mt-4 pt-2">
                    <a asp-action="Index" class="btn btn-light border px-4 py-2 rounded-3 text-secondary fw-semibold small text-decoration-none">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-dark px-4 py-2 rounded-3 fw-semibold small shadow-sm">
                        <i class="bi bi-check-lg me-1"></i> Salvar Cadastro
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        function mascaraCPF(input) {
            let v = input.value.replace(/\D/g, ""); // Remove tudo o que não for número
            v = v.replace(/(\d{3})(\d)/, "$1.$2");  // Adiciona o primeiro ponto
            v = v.replace(/(\d{3})(\d)/, "$1.$2");  // Adiciona o segundo ponto
            v = v.replace(/(\d{3})(\d{1,2})$/, "$1-$2"); // Adiciona o traço
            input.value = v;
        }

        function mascaraTelefone(input) {
            let v = input.value.replace(/\D/g, "");
            v = v.replace(/^(\d{2})(\d)/g, "($1) $2"); // Adiciona o parêntese do DDD
            v = v.replace(/(\d)(\d{4})$/, "$1-$2");    // Adiciona o traço dinâmico para fixo ou celular
            input.value = v;
        }

        function mascaraCEP(input) {
            let v = input.value.replace(/\D/g, "");
            v = v.replace(/^(\d{5})(\d)/, "$1-$2"); // Adiciona o traço do CEP
            input.value = v;
        }

        $(document).ready(function () {
            // Remove mensagens de feedback automaticamente após 3 segundos
            setTimeout(function () {
                $("#alertaSucesso").fadeOut("slow");
                $("#alertaErro").fadeOut("slow");
            }, 3000);

            // --- SCRIPT DE PREENCHIMENTO AUTOMÁTICO DE CEP ---
            function limpaFormularioCep() {
                $("#rua").val("");
                $("#bairro").val("");
                $("#cidade").val("");
                $("#estado").val("");
                $("#cepErro").text("");
            }

            $("#cep").blur(function () {
                var cep = $(this).val().replace(/\D/g, '');

                if (cep !== "") {
                    var validaCep = /^[0-9]{8}$/;

                    if (validaCep.test(cep)) {
                        $("#cepSpinner").removeClass("d-none");
                        $("#cepErro").text("");

                        $.getJSON("https://viacep.com.br/ws/" + cep + "/json/?callback=?", function (dados) {
                            $("#cepSpinner").addClass("d-none");

                            if (!("erro" in dados)) {
                                $("#rua").val(dados.logradouro);
                                $("#bairro").val(dados.bairro);
                                $("#cidade").val(dados.localidade);
                                $("#estado").val(dados.uf);
                                $("#numero").focus();
                            } else {
                                limpaFormularioCep();
                                $("#cepErro").text("CEP não encontrado.");
                            }
                        }).fail(function() {
                            $("#cepSpinner").addClass("d-none");
                            $("#cepErro").text("Erro ao buscar o CEP. Tente digitar manualmente.");
                        });
                    } else {
                        limpaFormularioCep();
                        $("#cepErro").text("Formato de CEP inválido.");
                    }
                } else {
                    limpaFormularioCep();
                }
            });
        });
    </script>
}

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-custom {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.06);
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
    }

    .form-control, .form-select {
        border: 1px solid #dee2e6;
        padding: 0.55rem 0.75rem;
        font-size: 0.92rem;
        background-color: #fff;
    }

        .form-control:focus, .form-select:focus {
            border-color: #2c3e50;
            box-shadow: 0 0 0 0.2rem rgba(44, 62, 80, 0.15);
        }
</style>