        </div>
        <div class="col-2">
            <label style="font-weight: bold" for="cep" class="form-label">CEP</label>
            <input type="number" asp-for="Cep" class="form-control" id="cep" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-md-2">
            <label style="font-weight: bold" for="logradouro" class="form-label">Rua:</label>
            <input type="text" asp-for="Logradouro" class="form-control" id="logradouro" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-1">
            <label style="font-weight: bold" for="nCasa" class="form-label">Nº</label>
            <input type="text" asp-for="Ncasa" class="form-control" id="ncasa" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-2">
            <label style="font-weight: bold" for="complemento" class="form-label">Complemento</label>
            <input type="text" asp-for="Complemento" class="form-control" id="complemento" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-md-2">
            <label style="font-weight: bold" for="bairro" class="form-label">Bairro:</label>
            <input type="text" asp-for="Bairro" class="form-control" id="bairro" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-md-2">
            <label style="font-weight: bold" for="cidade" class="form-label">Cidade:</label>
            <input type="text" asp-for="Cidade" class="form-control" id="cidade" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-md-1">
            <label style="font-weight: bold" for="estado" class="form-label">Estado:</label>
            <input type="text" asp-for="Estado" class="form-control" id="estado" style="border:none; background:none; padding-left: 0" disabled>
        </div>


        <div style="margin-top: 30px; color: black; border-bottom: solid 1px black">
            <h5 style="padding: 5px; margin-top: 5px; margin-bottom: 5px; font-weight: bold">Contato</h5>
        </div>

        <div class="col-3">
            <label style="font-weight: bold" for="tel" class="form-label">Telefone/WhatsApp</label>
            <input type="tel" asp-for="Tel1" class="form-control telefone" id="tel" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-3">
            <label style="font-weight: bold" for="tel2" class="form-label">Telefone/WhatsApp²</label>
            <input type="tel" asp-for="Tel2" class="form-control telefone" id="tel2" style="border:none; background:none; padding-left: 0" disabled>
        </div>


        <div style="font-weight: bold" class="col-6">
            <label for="email" class="form-label">E-mail</label>
            <input type="email" asp-for="Email" class="form-control" id="email" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div style="font-weight: bold" class="col-12">
            <label for="observacoes" class="form-label">Observações</label>
            <input type="observacoes" asp-for="observacoes" class="form-control" id="observacoes" rows="3" style="border:none; background:none; padding-left: 0" disabled>
        </div>




