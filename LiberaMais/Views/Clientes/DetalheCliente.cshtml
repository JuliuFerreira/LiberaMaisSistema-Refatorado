        </div>
        <div class="col-md-2">
            <label style="font-weight: bold" for="cpf" class="form-label">CPF</label>
            <input type="text" asp-for="Cpf" class="form-control" id="cpf" maxlength="14" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-md-4">
            <label style="font-weight: bold" for="nome" class="form-label">Nome</label>
            <input type="text" asp-for="Nome" class="form-control" id="nome" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-3">
            <label style="font-weight: bold" for="nascimento" class="form-label">Data de nascimento</label>
            <input type="date" asp-for="DataNascimento" class="form-control" id="nascimento" onchange="calcularIdadeAutomatica()" style="border:none; background:none; padding-left: 0" disabled>
        </div>

        <div class="col-md-3">
