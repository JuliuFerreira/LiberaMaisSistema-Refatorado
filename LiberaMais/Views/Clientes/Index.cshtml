@model List<Cliente>

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Clientes";

    var isAdmin = ViewBag.IsAdmin as bool? ?? false;

}

<div class="container-fluid mt-4">

    <div class="card shadow-sm mt-5 rounded-4">

        <div class="card-header bg-primary text-white">
            <h3 class="text-center mb-0">
                Clientes
            </h3>

        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger">
            @TempData["MensagemErro"]
        </div>
    }



    <div class="table-responsive">

        <div class="mb-3 mt-3">

            <a asp-action="Criar"
               class="btn btn-success rounded-4 shadow-sm px-4 mb-3 ">

                <i class="bi bi-plus-circle-fill"></i>
                Adicionar Cliente

            </a>
        </div>

        <table class="table table-striped table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Telefone</th>
                    <th>Cidade</th>
                    <th>Idade</th>
                    <th>Usuário</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var cliente in Model)
                    {
                        int idade = 0;

                        if (cliente.DataNascimento.HasValue)
                        {
                            idade = DateTime.Today.Year
                            - cliente.DataNascimento.Value.Year;

                            if (cliente.DataNascimento.Value.Date > DateTime.Today.AddYears(-idade))
                            {
                                idade--;
                            }
                        }

                        <tr>
                            <td>@cliente.Nome</td>
                            <td>@cliente.Cpf</td>
                            <td>@cliente.Fone</td>
                            <td>@cliente.Endereco?.Cidade</td>
                            <td>@idade anos</td>
                            <td>@cliente.Usuario?.Nome</td>
                            <td class="text-center">
                                <a asp-action="Detalhes"
                                   asp-route-id="@cliente.Id"
                                   class="btn btn-primary btn-sm">
                                    Detalhes
                                </a>

                                @*  <a asp-action="Editar"
                                   asp-route-id="@cliente.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>*@
                                <button class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalExcluir_@cliente.Id">

                                    Excluir

                                </button>
                            </td>




                        </tr>
                        <div class="modal fade"
                             id="modalExcluir_@cliente.Id"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content rounded-4 border-0 shadow">

                                    <div class="modal-header bg-danger text-white">

                                        <h5 class="modal-title">
                                            Excluir cliente
                                        </h5>

                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body text-center p-4">

                                        <p class="fs-5 mb-0">

                                            Deseja excluir

                                            <strong class="text-primary">
                                                @cliente.Nome
                                            </strong>?

                                        </p>

                                    </div>

                                    <div class="modal-footer border-0">

                                        <button type="button"
                                                class="btn btn-secondary rounded-3"
                                                data-bs-dismiss="modal">

                                            Cancelar

                                        </button>

                                        <form asp-action="Apagar" method="post">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@cliente.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger rounded-3">

                                                Excluir

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            Nenhum cliente encontrado.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
    <div>

        <a class="btn btn-outline-secondary rounded-4 px-4"
           asp-controller="Apps"
           asp-action="Index">

            <i class="bi bi-arrow-return-left"></i>
            Voltar

        </a>

    </div>

</div>

<script>

    setTimeout(function () {

        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");

    }, 3000);

</script>

