@model List<Cliente>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1" style="font-size: 1.6rem;">Clientes</h2>
            <small class="text-muted">Gerencie a base de clientes cadastrados no LiberaMais</small>
        </div>

        <a asp-action="Criar" class="btn btn-dark d-flex align-items-center gap-2 shadow-sm px-3 py-2 rounded-3">
            <i class="bi bi-plus-lg"></i> <span class="fw-semibold small">Adicionar Cliente</span>
        </a>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
        </div>
    }

    <form method="get" asp-action="Index" class="row g-2 mb-4 align-items-end">
        <div class="col-12 col-md-4">
            <label class="text-muted small fw-semibold d-block mb-1">Buscar por termo:</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="busca" class="form-control border-start-0 ps-0"
                       placeholder="Buscar por Nome ou CPF..." value="@ViewBag.BuscaAtual" />
                <button type="submit" class="btn btn-dark">Buscar</button>
            </div>
        </div>

        @if (ViewBag.IsAdmin == true)
        {
            <div class="col-12 col-md-3">
                <label class="text-muted small fw-semibold d-block mb-1">Filtrar por Responsável:</label>
                <select name="usuarioId" class="form-select form-select-sm filter-dropdown" style="min-width: 180px;" onchange="this.form.submit()">
                    <!option value="" @(Context.Request.Query["usuarioId"].ToString() == "" && Context.Request.Query.ContainsKey("usuarioId") ? "selected" : "")>Todos os Usuários</!option>
                    @if (ViewBag.Usuarios != null)
                    {
                        foreach (var user in ViewBag.Usuarios)
                        {
                            <!option value="@user.Id" @(ViewBag.UsuarioAtual == user.Id ? "selected" : "")>@user.Nome</!option>
                        }
                    }
                </select>
            </div>
        }
    </form>

    <div class="card card-table shadow-sm border-0 mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Nome</th>
                            <th>CPF</th>
                            <th>Telefone</th>
                            <th>Idade</th>
                            <th>Usuário</th>
                            <th class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var cliente in Model)
                            {
                                int idade = 0;
                                if (cliente.DataNascimento.HasValue)
                                {
                                    idade = DateTime.Today.Year - cliente.DataNascimento.Value.Year;
                                    if (cliente.DataNascimento.Value.Date > DateTime.Today.AddYears(-idade)) { idade--; }
                                }

                                <tr class="linha-clicavel" onclick="navegarParaDetalhes(event, '@Url.Action("Detalhes", new { id = cliente.Id })')">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark text-copy-target">@cliente.Nome</span>
                                            <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                    onclick="copiarTexto(event, '@cliente.Nome', this)" title="Copiar Nome">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="font-monospace text-copy-target" style="font-size: 0.9rem;">@cliente.Cpf</span>
                                            <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                    onclick="copiarTexto(event, '@cliente.Cpf', this)" title="Copiar CPF">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>@cliente.Fone</td>
                                    <td>@idade anos</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1 font-monospace" style="font-size: 0.8rem;">
                                            @(cliente.Usuario != null ? cliente.Usuario.Nome : "Não informado")
                                        </span>
                                    </td>
                                    <td class="text-center pe-4" onclick="event.stopPropagation();">
                                        <button class="btn btn-sm btn-outline-danger border-0" data-bs-toggle="modal" data-bs-target="#modalExcluir_@cliente.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@cliente.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title">Confirmar Exclusão</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                Deseja realmente remover o cadastro de <strong>@cliente.Nome</strong>?
                                            </div>
                                            <div class="modal-footer border-0">
                                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="Apagar" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@cliente.Id" />
                                                    <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">Nenhum cliente encontrado.</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="ms-4 my-2 text-secondary" style="font-size: 0.85rem;">
                    <span>
                        Total: <strong class="text-dark">@ViewBag.TotalRegistros</strong> clientes cadastrados
                    </span>
                </div>
            </div>
        </div>
    </div>
    @if (ViewBag.TotalPaginas > 1)
    {
        // Identifica se deve mandar o ID atual ou 0 (representando "Todos")
        var usuarioRota = ViewBag.UsuarioAtual ?? 0;

        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border border-light-subtle mb-4">
            @* Lado Esquerdo: Página Atual + Total de Clientes Cadastrados *@
            <div class="d-flex flex-column flex-sm-row gap-sm-3 text-muted small">
                <span>
                    Página <strong>@ViewBag.PaginaAtual</strong> de <strong>@ViewBag.TotalPaginas</strong>
                </span>
            </div>

            @* Lado Direito: Botões de Navegação *@
            <div class="btn-group gap-1">
                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual - 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   asp-route-usuarioId="@usuarioRota"
                   class="btn btn-sm btn-outline-dark rounded-2 px-3 py-1.5 fw-medium @(ViewBag.PaginaAtual == 1 ? "disabled" : "")">
                    <i class="bi bi-chevron-left me-1"></i> Anterior
                </a>

                <a asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaAtual + 1)"
                   asp-route-busca="@ViewBag.BuscaAtual"
                   asp-route-usuarioId="@usuarioRota"
                   class="btn btn-sm btn-dark rounded-2 px-3 py-1.5 fw-medium @(ViewBag.PaginaAtual == ViewBag.TotalPaginas ? "disabled" : "")">
                    Próximo <i class="bi bi-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    }


    <div>
        <a asp-controller="Apps" asp-action="Index" class="text-decoration-none text-muted fw-medium d-flex align-items-center gap-1">
            <i class="bi bi-arrow-left"></i> Voltar ao painel
        </a>
    </div>
</div>

<script>
    function navegarParaDetalhes(event, url) {
        const selecao = window.getSelection().toString();
        if (selecao.length > 0) {
            return;
        }
        if (event.target.closest('.btn-copy') || event.target.closest('.modal')) {
            return;
        }
        window.location.href = url;
    }

    function copiarTexto(event, texto, elemento) {
        event.stopPropagation();

        navigator.clipboard.writeText(texto).then(() => {
            const icone = elemento.querySelector('i');
            icone.className = "bi bi-check-lg text-success";

            setTimeout(() => {
                icone.className = "bi bi-clipboard text-muted";
            }, 1500);
        });
    }

    window.addEventListener('load', function() {
        setTimeout(function() {
            var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
            alertas.forEach(function(alerta) {
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(function() { alerta.style.display = "none"; }, 500);
                }
            });
        }, 3000);
    });
</script>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .table-custom th {
        font-size: 0.82rem;
        color: #5c636a;
        padding: 14px 10px;
        text-transform: uppercase;
    }

    .table-custom td {
        padding: 14px 10px;
        font-size: 0.92rem;
    }

    .linha-clicavel {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

        .linha-clicavel:hover {
            background-color: rgba(0, 0, 0, 0.02) !important;
        }

    .btn-copy {
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.1s ease;
    }

    .linha-clicavel:hover .btn-copy {
        opacity: 1;
    }

    .btn-copy:active {
        transform: scale(0.85);
    }
</style>