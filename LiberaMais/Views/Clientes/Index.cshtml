@model List<Cliente>

@{
    Layout = "LayoutSistema";
    ViewData["Title"] = "Clientes";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1 text-uppercase tracking-wide" style="font-size: 1.6rem;">
                Listagem de Clientes
            </h2>
            <small class="text-muted">Gerencie a base de clientes cadastrados no LiberaMais</small>
        </div>

        <div>
            <a asp-action="Criar" class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 btn-adicionar shadow-sm">
                <i class="bi bi-plus-circle-fill" style="font-size: 1rem;"></i>
                <span class="fw-semibold small">Adicionar Cliente</span>
            </a>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success shadow-sm rounded-3 mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger shadow-sm rounded-3 mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="card card-table shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0" style="width: 100%">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Nome</th>
                            <th scope="col">CPF</th>
                            <th scope="col">Telefone</th>
                            <th scope="col">Cidade</th>
                            <th scope="col">Idade</th>
                            <th scope="col">Usuário</th>
                            <th scope="col" class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var cliente in Model)
                            {
                                int idade = 0;
                                if (cliente.DataNascimento.HasValue)
                                {
                                    idade = DateTime.Today.Year - cliente.DataNascimento.Value.Year;
                                    if (cliente.DataNascimento.Value.Date > DateTime.Today.AddYears(-idade))
                                    {
                                        idade--;
                                    }
                                }

                                var detalhesUrl = Url.Action("Detalhes", new { id = cliente.Id });

                                <tr onclick="location.href='@detalhesUrl'" style="cursor: pointer;" title="Clique para ver detalhes">
                                    <td class="ps-4 fw-bold text-dark">@cliente.Nome</td>
                                    <td>@cliente.Cpf</td>
                                    <td>@cliente.Fone</td>
                                    <td>@cliente.Endereco?.Cidade</td>
                                    <td>@idade anos</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1 font-monospace" style="font-size: 0.8rem;">
                                            @cliente.Usuario?.Nome
                                        </span>
                                    </td>
                                    <td class="text-center pe-4" onclick="event.stopPropagation();">
                                        <button class="btn btn-outline-danger btn-action-sm d-inline-flex align-items-center justify-content-center"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalExcluir_@cliente.Id"
                                                title="Excluir Cliente">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@cliente.Id" tabindex="-1" aria-hidden="true" onclick="event.stopPropagation();">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content rounded-4 border-0 shadow-lg">
                                            <div class="modal-body text-center p-4 pt-5">
                                                <div class="text-danger mb-3">
                                                    <i class="bi bi-exclamation-circle" style="font-size: 2.5rem;"></i>
                                                </div>
                                                <h5 class="fw-bold text-dark mb-2">Excluir Cliente?</h5>
                                                <p class="text-muted small mb-0">
                                                    Deseja realmente remover o cadastro de <strong class="text-dark">@cliente.Nome</strong> do sistema? Esta ação não pode ser desfeita.
                                                </p>
                                            </div>
                                            <div class="modal-footer border-0 d-flex flex-column w-100 gap-1 p-4 pt-0">
                                                <form asp-action="Apagar" method="post" class="w-100 m-0">
                                                    <input type="hidden" name="id" value="@cliente.Id" />
                                                    <button type="submit" class="btn btn-danger w-100 rounded-3 py-2 fw-medium">Confirmar Exclusão</button>
                                                </form>
                                                <button type="button" class="btn btn-light border w-100 rounded-3 py-2 text-secondary fw-medium" data-bs-dismiss="modal">Cancelar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-people mb-2 d-block text-secondary" style="font-size: 2rem;"></i>
                                    Nenhum cliente encontrado no sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-medium p-0 btn-back-hover"
           asp-controller="Apps" asp-action="Index">
            <i class="bi bi-arrow-left-short" style="font-size: 1.4rem;"></i> Voltar ao painel
        </a>
    </div>

</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .card-table {
        border-radius: 14px;
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
    }

        .table-custom thead {
            background-color: #f8f9fa;
            border-bottom: 2px solid #efefef;
        }

        .table-custom th {
            font-size: 0.82rem;
            font-weight: 700;
            color: #5c636a;
            padding: 14px 10px;
            letter-spacing: 0.5px;
        }

        .table-custom tbody tr {
            border-bottom: 1px solid #f1f3f5;
            transition: background-color 0.15s ease;
        }

            .table-custom tbody tr:hover {
                background-color: #f8f9fa !important;
            }

        .table-custom tbody td {
            padding: 12px 10px;
            font-size: 0.92rem;
            color: #495057;
        }

    .btn-action-sm {
        width: 32px;
        height: 32px;
        padding: 0;
        border-radius: 6px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .btn-adicionar {
        border-radius: 10px;
        transition: all 0.2s ease;
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

        .btn-back-hover:hover {
            color: #212529 !important;
            transform: translateX(-2px);
        }
</style>

<script>
    setTimeout(function () {
        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");
    }, 3000);
</script>