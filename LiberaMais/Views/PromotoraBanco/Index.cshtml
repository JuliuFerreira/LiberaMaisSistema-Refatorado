@model IEnumerable<PromotoraBanco>

@{
    Layout = "LayoutSistema";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;    
}

<div class="container-fluid mt-4">

    <div class="card shadow-sm mt-5 rounded-4">

        <div class="card-header bg-primary text-white">
            <h3 class="text-center mb-0">
                Logins cadastrados <h style="color:lightgreen">@ViewBag.NomePromotora</h>
            </h3>
        </div>   
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger">
            @TempData["MensagemErro"]
        </div>
    }

    <div class="table-responsive">

        <div class="mt-3 mb-3">
            <a asp-controller="PromotoraBanco"
               asp-action="Criar"
               asp-route-promotoraId="@ViewBag.PromotoraId"
               class="btn btn-success">

                Adicionar Login

            </a>
        </div>


        <table class="table table-striped table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Banco</th>
                    <th>Login</th>
                    <th>Senha</th>
                    <th>Acesso ao sistema</th>
                    <th class="text-center">Ações</th>
                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Banco.Nome
                            </td>

                            <td>
                                @item.Login
                            </td>

                            <td>
                                @item.Senha
                            </td>

                            <td>
                                <a href="https://@item.Banco.Url"
                                   target="_blank"
                                   class="text-decoration-none">

                                    @item.Banco.Url

                                </a>
                            </td>

                            <td class="text-center">
                                <a asp-action="Editar"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <button class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalExcluir_@item.Id">

                                    Excluir

                                </button>

                            </td>
                        </tr>
                        <!-- MODAL -->
                        <div class="modal fade"
                             id="modalExcluir_@item.Id"
                             tabindex="-1"
                             aria-hidden="true">

                            <div class="modal-dialog modal-dialog-centered">

                                <div class="modal-content rounded-4 border-0 shadow">

                                    <div class="modal-header bg-danger text-white">

                                        <h5 class="modal-title">

                                            Excluir Login

                                        </h5>

                                        <button type="button"
                                                class="btn-close btn-close-white"
                                                data-bs-dismiss="modal">
                                        </button>

                                    </div>

                                    <div class="modal-body text-center p-4">

                                        <h5 class="text-danger mb-3">
                                            Atenção!
                                        </h5>

                                        <p class="fs-5">

                                            Deseja realmente excluir o login

                                            <strong class="text-primary">
                                                @item.Login
                                            </strong>?

                                        </p>

                                    </div>

                                    <div class="modal-footer border-0">

                                        <button type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal">

                                            Cancelar

                                        </button>

                                        <form asp-action="Apagar" method="post">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger">

                                                Excluir

                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>

                        </div>

                    }
                }
                else
                {
                    <tr>

                        <td colspan="5" class="text-center text-muted">
                            Nenhum login encontrado para esta promotora.
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
    <div>

        <a class="btn btn-outline-secondary rounded-4 px-4"
           asp-controller="Promotora"
           asp-action="Index">

            <i class="bi bi-arrow-return-left"></i>
            Voltar

        </a>

    </div>

</div>


<script>
    setTimeout(function () {

        $("#alertaSucesso").fadeOut("slow");
        $("#alertaErro").fadeOut("slow");

    }, 3000);
</script>
