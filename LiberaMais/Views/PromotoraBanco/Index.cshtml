@model IEnumerable<PromotoraBanco>

@{
    Layout = "_LayoutSistema";
    ViewData["Title"] = "Logins Cadastrados";
    var isAdmin = ViewBag.IsAdmin as bool? ?? false;
}

<div class="container-fluid py-4 inner-system-page">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-light-subtle">
        <div>
            <h3 class="fw-bold text-dark mb-1 tracking-tight">
                Logins — <span class="text-muted fw-normal">@ViewBag.NomePromotora</span>
            </h3>
            <p class="text-muted small mb-0">Gerencie as credenciais e acessos de bancos vinculados a esta promotora.</p>
        </div>

        <div>
            <a asp-controller="PromotoraBanco" asp-action="Criar" asp-route-promotoraId="@ViewBag.PromotoraId"
               class="btn btn-dark d-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3">
                <i class="bi bi-plus-lg"></i>
                <span class="fw-semibold small">Adicionar Login</span>
            </a>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div id="alertaSucesso" class="alert alert-success border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["MensagemSucesso"]
        </div>
    }
    @if (TempData["MensagemErro"] != null)
    {
        <div id="alertaErro" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 small">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["MensagemErro"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0" style="width: 100%">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Banco</th>
                            <th scope="col">Login</th>
                            <th scope="col">Senha</th>
                            <th scope="col">Usuário Responsável</th>
                            <th scope="col">Acesso ao Sistema</th>
                            <th scope="col" class="text-center pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var editarUrl = Url.Action("Editar", new { id = item.Id });

                                <tr class="linha-tabela-clicavel" data-href="@editarUrl" style="cursor: pointer;" title="Clique para editar">
                                    <td class="ps-4 fw-bold text-dark">@item.Banco?.Nome</td>

                                    <td>
                                        <div class="d-flex align-items-center justify-content-between gap-3 ignorar-clique wrapper-copiar" style="max-width: 200px;">
                                            <span class="badge bg-light text-dark border px-2 py-1 font-monospace alvo-copia" style="font-size: 0.8rem;">@item.Login</span>
                                            <button type="button" class="btn p-0 border-0 text-muted btn-copiar-clip" title="Copiar Login">
                                                <i class="bi bi-copy" style="font-size: 0.75rem;"></i>
                                            </button>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center justify-content-between gap-3 ignorar-clique wrapper-copiar" style="max-width: 200px;">
                                            <span class="badge bg-light text-dark border px-2 py-1 font-monospace alvo-copia" style="font-size: 0.8rem;">@item.Senha</span>
                                            <button type="button" class="btn p-0 border-0 text-muted btn-copiar-clip" title="Copiar Senha">
                                                <i class="bi bi-copy" style="font-size: 0.75rem;"></i>
                                            </button>
                                        </div>
                                    </td>

                                    <td>@item.Usuario?.Nome</td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation();">
                                            <a href="@item.Banco.Url" target="_blank" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-2 py-1 px-2.5 text-dark shadow-sm rounded-2 fw-semibold" style="font-size: 0.85rem;">
                                                <i class="bi bi-box-arrow-up-right text-primary"></i> <span>Acessar Banco</span>
                                            </a>
                                            <button type="button" class="btn btn-link p-0 text-muted btn-copy shadow-none"
                                                    onclick="copiarTexto(event, '@item.Banco.Url', this)" title="Copiar Link">
                                                <i class="bi bi-clipboard"></i>
                                            </button>
                                        </div>
                                    </td>                                        


                                    <td class="text-center pe-4 ignorar-clique">
                                        <div class="d-flex align-items-center justify-content-center gap-2">
                                            <a href="#" class="text-danger link-icone-acao px-1" data-bs-toggle="modal" data-bs-target="#modalExcluir_@item.Id" title="Excluir">
                                                <i class="bi bi-trash" style="font-size: 0.85rem;"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                <div class="modal fade" id="modalExcluir_@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow rounded-4">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold text-dark fs-5">Confirmar Exclusão</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body py-3 text-start">
                                                Deseja realmente remover o login <strong>@item.Login</strong> do banco <strong>@item.Banco?.Nome</strong>?
                                                <p class="text-muted mb-0 mt-1 small" style="font-size: 0.8rem;">Esta ação removerá permanentemente as credenciais de acesso do sistema.</p>
                                            </div>
                                            <div class="modal-footer border-0 d-flex justify-content-end gap-2 pt-0 pb-4 pe-4">
                                                <button type="button" class="btn btn-light border px-3 py-2 rounded-3 small fw-medium text-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-action="Apagar" method="post" class="d-inline m-0">
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-danger border-0 px-3 py-2 rounded-3 small fw-semibold" style="background-color: #dc3545;">Confirmar Exclusão</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-shield-lock mb-2 d-block text-secondary opacity-50" style="font-size: 2rem;"></i>
                                    Nenhum login encontrado para esta promotora.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a class="btn btn-link text-decoration-none text-secondary d-inline-flex align-items-center gap-2 fw-medium p-0 btn-back-hover"
           asp-controller="Promotora" asp-action="Index">
            <i class="bi bi-arrow-left-short fs-4"></i> <span class="small">Voltar às promotoras</span>
        </a>
    </div>

</div>

<style>
    .inner-system-page {
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .table-custom thead {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .table-custom th {
        font-size: 0.75rem;
        font-weight: 700;
        color: #6c757d;
        padding: 14px 10px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table-custom tbody tr {
        border-bottom: 1px solid #f1f3f5;
        transition: background-color 0.15s ease;
    }

    .table-custom tbody tr:hover {
        background-color: #f8f9fa !important;
    }

    /* Regras de Cópia (Afastadas com Efeito Hover) */
    .btn-copiar-clip {
        opacity: 0;
        transition: opacity 0.15s ease, color 0.15s ease;
    }

    .wrapper-copiar:hover .btn-copiar-clip {
        opacity: 1;
    }

    .btn-copiar-clip:hover {
        color: #212529 !important;
    }

    /* Ícones de Ação Padronizados */
    .link-icone-acao {
        text-decoration: none;
        transition: transform 0.15s ease, opacity 0.15s ease;
        display: inline-flex;
        align-items: center;
    }

    .link-icone-acao:hover {
        transform: scale(1.15);
        opacity: 0.85;
    }

    .btn-back-hover {
        transition: color 0.2s ease, transform 0.2s ease;
    }

    .btn-back-hover:hover {
        color: #212529 !important;
        transform: translateX(-2px);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {

            // 1. Redirecionamento da linha evitando seleção de texto ou sub-botões
            $(".linha-tabela-clicavel").click(function (e) {
                var selecaoTexto = window.getSelection().toString();

                if (!$(e.target).closest('.ignorar-clique').length && !selecaoTexto) {
                    window.location.href = $(this).data("href");
                }
            });

            // 2. Sistema unificado de cópia para clipboard
            $(".btn-copiar-clip").click(function () {
                var btn = $(this);
                var icone = btn.find("i");
                var textoParaCopiar = btn.siblings(".alvo-copia").text().trim();

                navigator.clipboard.writeText(textoParaCopiar).then(function() {
                    icone.removeClass("bi-copy").addClass("bi-check-lg text-success");

                    setTimeout(function() {
                        icone.removeClass("bi-check-lg text-success").addClass("bi-copy");
                    }, 1500);
                });
            });

            // 3. Efeito suave no desaparecimento dos Alertas
            setTimeout(function () {
                var alertas = [document.getElementById("alertaSucesso"), document.getElementById("alertaErro")];
                alertas.forEach(function(alerta) {
                    if (alerta) {
                        alerta.style.transition = "opacity 0.5s ease";
                        alerta.style.opacity = "0";
                        setTimeout(function() { alerta.style.display = "none"; }, 500);
                    }
                });
            }, 3000);
        });
    </script>
}