@model PromotoraBanco

@{
    Layout = "LayoutSistema";
}

<div class="row justify-content-center">

    <div class="card shadow border-0 rounded-4 col-10 mt-5">

        <div class="card-header text-white rounded-top-4"
             style="background-color:orange;">

            <h3 class="text-center mb-0">
                Editar   login
            </h3>

        </div>

        @if (TempData["MensagemSucesso"] != null)
        {
            <div id="alertaSucesso" class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div id="alertaErro" class="alert alert-danger">
                @TempData["MensagemErro"]
            </div>
        }


        <div class="card-body p-4">

            <form asp-controller="PromotoraBanco"
                  asp-action="Editar"
                  method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="PromotoraId" />
                <input type="hidden" asp-for="BancoId" />


                <div class="row g-3">

                    <div class="col-md-3">


                        <label class="form-label">
                            Promotora
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@ViewBag.NomePromotora"
                               disabled />
                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Banco
                        </label>

                        <select asp-for="BancoId"
                                class="form-select" disabled>

                            <option value="">
                                Selecione
                            </option>

                            @foreach (var banco in ViewBag.Banco)
                            {
                                <option value="@banco.Id">
                                    @banco.Nome
                                </option>
                            }

                        </select>
                        <span asp-validation-for="BancoId"
                              class="text-danger">
                        </span>


                    </div>

                    <div class="col-md-3">
                        <label for="login" class="form-label">Usuário</label>
                        <input type="text" asp-for="Login" class="form-control" id="usuario">
                        <span asp-validation-for="Login"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">
                        <label for="login" class="form-label">Senha</label>
                        <input type="text" asp-for="Senha" class="form-control" id="senha">
                        <span asp-validation-for="Senha"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            Salvar

                        </button>

                        <a asp-controller="PromotoraBanco"
                           asp-action="Index"
                           asp-route-promotoraId="@ViewBag.PromotoraId"
                           class="btn btn-secondary">
                            Cancelar

                        </a>

                    </div>
                </div>


            </form>
        </div>
    </div>


</div>
