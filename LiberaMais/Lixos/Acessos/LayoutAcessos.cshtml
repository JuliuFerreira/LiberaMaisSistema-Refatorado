<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="shortcut icon" type="image/x-icon" href="~/img/LiberaIcon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LiberaMais</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LiberaMais.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</head>


<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow fixed-top">
            <div class="container-fluid d-flex align-items-center justify-content-between">

                <!-- ESQUERDA: LOGO -->
                <div class="d-flex align-items-center">
                    <a>
                        <img src="~/img/Logom.png" alt="Libera Mais" style="height: 50px;" />
                    </a>
                </div>

                <!-- CENTRO: BOTÕES -->
                <div class="flex-grow-1 d-flex justify-content-center">

                    <div class="d-flex gap-3 flex-wrap">

                        <a asp-controller="Clientes" asp-action="Clientes" class="menu-btn clientes">
                            <i class="bi bi-people"></i>
                            <span>Clientes</span>
                        </a>

                        <a asp-controller="Venda" asp-action="Venda" class="menu-btn vendas">
                            <i class="bi bi-cash-coin"></i>
                            <span>Vendas</span>
                        </a>

                        <a asp-controller="Promotoras" asp-action="Promotora" class="menu-btn logins">
                            <i class="bi bi-person-badge"></i>
                            <span>Logins</span>
                        </a>

                        <a asp-controller="Financa" asp-action="Index" class="menu-btn financas">
                            <i class="bi bi-safe"></i>
                            <span>Finanças</span>
                        </a>

                    </div>

                </div>

                <!-- DIREITA: MENU -->
                <div class="d-flex align-items-center">

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuDireita">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div id="menuDireita" class="collapse navbar-collapse">
                        <div>@await Component.InvokeAsync("Menu")</div>
                    </div>

                </div>

            </div>
        </nav>
    </header>

    <!-- CONTEÚDO -->
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer id="fixed-footer">
        <div style="width: 98%; margin: 0 auto;">
            &copy; 2024 LiberaMais - by Julio C. Ferreira
        </div>
    </footer>

    <!-- ESTILO -->
    <style>
        body {
            padding-top: 90px;
            margin-bottom: 60px;
        }

        .navbar {
            z-index: 1000;
        }

        /* BOTÕES */
        .menu-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 12px;
            color: black;
            font-weight: 500;
            text-decoration: none;
            transition: 0.3s;
            height: 45px;
            white-space: nowrap; /* evita quebrar texto */
        }

            .menu-btn i {
                font-size: 18px;
            }

            /* CORES */
            .menu-btn.clientes {
                background-color: lawngreen;
            }

            .menu-btn.vendas {
                background-color: deepskyblue;
            }

            .menu-btn.logins {
                background-color: gold;
            }

            .menu-btn.financas {
                background-color: orange;
            }

            /* HOVER */
            .menu-btn:hover {
                transform: translateY(-2px);
                opacity: 0.9;
                color: white;
            }
    </style>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/v/dt/dt-2.0.3/datatables.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
